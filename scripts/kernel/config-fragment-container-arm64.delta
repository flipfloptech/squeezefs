# --- the cluster wire's MutualTls class rides KERNEL TLS (owner 2026-10-12) --
# The TLS 1.3 handshake is in-tree; the record layer is the kernel's tls ULP
# (setsockopt TCP_ULP "tls" + TLS_TX/TLS_RX), so the wire's frames ride
# io_uring send/recv exactly like the Plaintext class and the charter's TLS
# exception shrinks to the handshake. TLS_DEVICE is the NIC-offload path (the
# only one that combines with zcrx RECV_ZC). Both =y: no module tree here.
CONFIG_TLS=y
CONFIG_TLS_DEVICE=y

# --- ARMv8 Crypto Extensions for the kernel's gcm(aes) (owner 2026-10-12) --
# Without these the kernel's gcm(aes) is gcm_base(ctr(aes-lib),ghash-lib) and
# kTLS measured 4.2 CPU-s/GB on the venue (the in-tree handshake engine over
# std.crypto's CE path: 0.95). The CPU exposes `aes pmull`; GHASH_ARM64_CE
# carries the fused gcm-aes-ce driver, AES_ARM64_CE_BLK the ctr/cbc/xts CE
# modes it pairs with. =y: no module tree here.
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y

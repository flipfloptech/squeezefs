+unsigned int fuse_uring_num_background(struct fuse_conn *fc)
+{
+	struct fuse_ring *ring = smp_load_acquire(&fc->ring);
+	unsigned int sum = 0;
+	int qid;
+
+	if (!ring)
+		return 0;
+
+	for (qid = 0; qid < ring->nr_queues; qid++) {
+		struct fuse_ring_queue *queue = READ_ONCE(ring->queues[qid]);
+
+		if (queue)
+			sum += READ_ONCE(queue->num_background);
+	}
+
+	return sum;
+}

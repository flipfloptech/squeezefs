#!/usr/bin/env bash
# mount(8) helper for the external suites: `mount -t fuse.squeezefs <dev> <dir>
# -o <opts>` (xfstests' `_mount -t $FSTYP$FUSE_SUBTYP`) lands here through
# util-linux's `/sbin/mount.fuse.squeezefs` symlink (installed by
# scripts/suites/fstests.sh). Also answers as `/sbin/umount.fuse`
# (util-linux's umount helper: `umount.<type> <dir> [-l] [-f] [-n] [-v]`),
# so xfstests' `umount` of a mount THIS helper made runs the ORDERLY
# `squeezefs umount` (teardown promotes staged files first, the final
# checkpoint lands) instead of the bare umount2 that gives a type-fuse
# mount no DESTROY; any other mount of the superblock (a bind, a move) is
# the kernel's plain detach, the daemon unsignalled (the persona's comment
# below).
#
# <dev> is the set's ONE device (xfstests' TEST_DEV/SCRATCH_DEV loop, a dm
# target the test put over it, or a device of the test's own — generic/620's
# 17 TB dm-hugedisk): the helper stands the set's slices over it — the
# metadata volume and the two data volumes, sized to the device
# (`setpaths.sh`) — and the daemon mounts the metadata slice. The mount posture is the RELEASE posture
# (`default_permissions,allow_other`) PLUS the caller's options: `ro`,
# `noatime`, `nodiratime`, `sync`, `dirsync`, `nosuid`, `nodev`, `noexec`
# and the daemon's own `-o` names pass through to `squeezefs mount`, which
# refuses anything it does not know (charter §1.6: a junk option is a
# loud refusal, never dropped). `remount` is the KERNEL's: a FUSE
# superblock's ro/rw flip (`fuse_reconfigure`) needs no daemon verb, so
# `-o remount,…` goes straight to mount(8) with `-i` (no helper recursion)
# — generic/294 and 306 test the EROFS laws through it.
set -euo pipefail
# The filesystem side is never interposed: a run under FSTESTS_PRELOAD
# preloads the tests' tools, not the helpers or the daemons they start.
unset LD_PRELOAD

ENV_FILE=${SQZ_SUITES_ENV:-/run/squeezefs-suites.env}
[ -f "$ENV_FILE" ] && source "$ENV_FILE"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/setpaths.sh"
SQZ_BIN=${SQZ_BIN:-squeezefs}
SUITE_MOUNT_OPTS=${SUITE_MOUNT_OPTS:-default_permissions,allow_other}

die() { echo "$(basename "$0"): $*" >&2; exit 32; }

if [[ "$(basename "$0")" == umount.* ]]; then
  # util-linux names the helper by the TYPE'S PREFIX (`umount.fuse -t
  # fuse.squeezefs`, as umount(8) documents for `fuse.sshfs`): installed as
  # /sbin/umount.fuse, this answers every fuse.* unmount on the venue — ours
  # the orderly way, any other type's as the kernel's plain detach.
  target="" type="" lazy=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -t) type=$2; shift ;;
      -N) shift ;;
      -l) lazy=-l ;;               # the kernel's lazy detach, or the daemon's lazy stop (below)
      -*) ;;                       # -f -n -v -r -i: the orderly umount is the one act
      *) [ -z "$target" ] && target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || die "usage: umount.fuse [-t fuse.<subtype>] <mountpoint>"
  [ -z "$type" ] && type=$(findmnt -n -o FSTYPE -M "$target" 2>/dev/null)
  [ "$type" = fuse.squeezefs ] || exec umount -i $lazy "$target"
  # Only THE mount the mount helper made gets the orderly `squeezefs umount`
  # (the daemon signalled, its teardown's promotion and checkpoint, its
  # exit awaited): the helper tagged its mountpoint with the set and the
  # MOUNT ID the kernel gave it. Every other mount carrying our fstype —
  # a bind of a path inside it (generic/306 binds a file), a whole-tree
  # bind (409–411: `mount --bind mpA mpB`), a bind stacked on the
  # daemon's own path (589: `--bind DSTHEAD DSTHEAD`), a moved mountpoint
  # (589's `--move`), a propagated copy — is another mountpoint of the
  # same superblock with no daemon of its own: the kernel's plain detach,
  # silently (mount(8) prints nothing), the daemon not signalled; it
  # serves what remains and exits when the superblock's last mount goes
  # (the kernel ends the connection). Until 2026-10-23 a whole-tree bind
  # (FSROOT `/`) took the orderly path: the daemon unmounted ITS path at
  # the first bind's unmount, the later ones met a dead connection.
  tag=/run/squeezefs-suites/mnt-$(printf '%s' "$target" | md5sum | cut -c1-16)
  own_id=""
  if [ -f "$tag" ]; then { read -r SET_ID; read -r own_id; } < "$tag"; fi
  top_id=$(awk -v t="$target" '$5 == t { id = $1 } END { print id }' /proc/self/mountinfo)
  if [ -z "$own_id" ] || [ "$top_id" != "$own_id" ]; then exec umount -i $lazy "$target"; fi
  # The set serving this mountpoint, and its run's binary.
  SET_DIR=$(cat "/run/squeezefs-suites/$SET_ID.dir"); suite_slice_paths
  suite_run_env "$SET_DIR"
  rc=0
  # `umount -l` of the daemon's own mount is the daemon's LAZY stop
  # (decision 0003 §S shape (b)): detached now, its holders — a test's
  # mounts stacked inside it after a fail-early kill (fstests.sh's
  # `fstests_unmount_all` falls back to `umount -l` on a BUSY refusal) —
  # served until the kernel ends the connection, then the teardown.
  "$SQZ_BIN" umount ${lazy:+--lazy} "$target" || rc=$?
  # The set's slices go down with the mount, so the test's own dm device
  # above them can be removed by its cleanup. A refused umount (BUSY: a
  # holder) leaves everything standing; so does the lazy stop (the daemon
  # may still serve over the slices — the run's end or the next mkfs of
  # the set takes them down).
  if [ "$rc" = 0 ] && [ -z "$lazy" ]; then
    # A successor of this set on its way up through the same slices holds
    # the set's lock shared for its whole bring-up (generic/604: the mount
    # racing this unmount waits out our daemon on the writer lock, then
    # opens the data volumes — slices removed under it read as foreign);
    # one already up serves the mountpoint again. Either way the set stays
    # up and the successor's own umount takes it down.
    exec 9>"/run/squeezefs-suites/$SET_ID.lock"
    if ! flock -x -n 9 || findmnt -n -o FSTYPE -M "$target" 2>/dev/null | grep -qx fuse.squeezefs; then
      echo "$(date +%s) umount $target rc=$rc: set $SET_ID stays up (a successor mount is up or on its way)" >> "$SET_DIR/mounts.log"
      exit "$rc"
    fi
    echo "$(date +%s) umount $target rc=$rc: set $SET_ID down" >> "$SET_DIR/mounts.log"
    suite_slices_down 2>>"$SET_DIR/mounts.log"
    rm -f "$tag"
  fi
  exit "$rc"
fi

dev="" dir="" opts=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) opts="${opts:+$opts,}$2"; shift ;;
    -o*) opts="${opts:+$opts,}${1#-o}" ;;
    -t) shift ;;                   # the type we are
    -n|-s|-f|-v|-i|-r|-w) ;;      # util-linux helper flags: no table to write, verbose is the log
    -N) shift ;;
    -*) die "unknown flag $1" ;;
    *) if [ -z "$dev" ]; then dev=$1; elif [ -z "$dir" ]; then dir=$1; else die "extra argument $1"; fi ;;
  esac
  shift
done
[ -n "$dev" ] && [ -n "$dir" ] || die "usage: mount.fuse.squeezefs <meta-volume-path> <mountpoint> [-o opts]"
case ",$opts," in *,remount,*|*,remount=*) exec mount -i -o "$opts" "$dir" ;; esac

# Options: the release posture first, then the caller's (minus the mount
# table words util-linux adds and the ones a FUSE daemon cannot honour).
pass=()
IFS=',' read -ra items <<< "$opts"
for it in "${items[@]}"; do
  case "$it" in
    ""|rw|defaults|auto|noauto|user|nouser|owner|group|_netdev|nofail|loop) ;;
    # mount(8)'s atime family reaches a helper as words (util-linux 2.42:
    # generic/003's `-o relatime`, `nodiratime`, `noatime`, `strictatime`):
    # they are the KERNEL MOUNT's flags and the daemon reads its posture
    # back from them (charter §4 "Access time"), so they pass through to
    # `squeezefs mount` — except `norelatime`, a word the kernel has no
    # flag for (MS_RELATIME is the default it ignores).
    norelatime) ;;
    *) pass+=("$it") ;;
  esac
done
# The mount table's source column IS the device string: xfstests finds the
# mount by `findmnt -S $dev -t fuse.squeezefs` (`fsname` and `subtype` are
# independent in the daemon's option parser).
all="$SUITE_MOUNT_OPTS,fsname=$dev"
for p in "${pass[@]}"; do all="$all,$p"; done

suite_set_of "$dev"
log="$SET_DIR/daemon-$(date +%Y%m%d-%H%M%S)-$$.log"
# One line per mount in the set's own ledger, so a run's daemons are findable.
echo "$(date +%s) mount $dir -o $all log $log" >> "$SET_DIR/mounts.log"
# The set's lock, SHARED for the whole bring-up (the umount helper takes it
# exclusively before it takes the slices down — the predecessor's unmount
# racing this mount, generic/604). Held on fd 9 by this helper alone: the
# daemon must not inherit it (`9>&-` below), or the set could never go down.
mkdir -p /run/squeezefs-suites
exec 9>"/run/squeezefs-suites/$SET_ID.lock"; flock -s 9
# The set's slices over the device handed over (re-pointed when they
# stand: a dm-flakey target now, the loop a moment ago); the umount helper
# finds the set by the mountpoint's tag. A mount that fails takes them down
# again (the test's cleanup removes its device) — unless another bring-up
# of the set is in flight.
suite_slices_up "$dev"
# The mountpoint's tag: the set (line 1) and, once the daemon is up, the
# MOUNT ID of the mount it made (line 2: the newest mount at the path is
# ours) — what the umount persona tells the daemon's own mount apart from
# a bind, a stacked bind or a moved mount of the same superblock.
tag="/run/squeezefs-suites/mnt-$(printf '%s' "$dir" | md5sum | cut -c1-16)"
echo "$SET_ID" > "$tag"
mount_failed() { flock -u 9; if flock -x -n 9; then suite_slices_down; fi; rm -f "$tag"; }
mount_tagged() { printf '%s\n%s\n' "$SET_ID" "$(awk -v t="$dir" '$5 == t { id = $1 } END { print id }' /proc/self/mountinfo)" > "$tag"; }
attempt=0
while :; do
  attempt=$((attempt + 1))
  # mount(8) is silent on success: the front's bring-up lines are the
  # daemon log's (a test that runs `_scratch_mount` bare captures stderr
  # into its golden output — generic/631, 634); on failure they are the
  # diagnosis and go to stderr.
  # `--supervise`: the release posture's external supervisor (common.sh's
  # `suite_mount` says why) — a death gets its wait status, a wedge its dump.
  out=$("$SQZ_BIN" mount --daemon --supervise --log-file "$log" -o "$all" "$SLICE_META_URI" "$dir" 2>&1 9>&-) && { mount_tagged; exit 0; }
  rc=$?
  # A stale writer claim whose holder is DEAD: the previous daemon of this
  # set died without its clean unmount (the product never auto-takes a
  # claim on a volume without PR — operator attestation, charter D0). The
  # harness IS the operator here and can attest: the set directory is
  # ours alone, and the claim's pid is gone or a zombie. The death is
  # recorded for the run's verdict (`suite_daemon_alerts` reads
  # `daemon-died`: a run with one is VOID), the claim is cleared, the
  # mount retried once — so the gate keeps collecting instead of failing
  # every later test on the dead holder's lock.
  # A LIVE holder that is on its way out (the previous daemon of this set
  # still tearing down: generic/604 mounts while a background umount
  # runs): mount(8) on a kernel filesystem blocks until the superblock is
  # gone; the helper waits for the holder's exit the same way (bounded),
  # then retries. A holder that stays is a real refusal.
  # (The guard's two live phrasings: "another squeezefs process holds the
  # writer lock (claim: …)" — the flock — and "claimed by a live writer
  # (claim: …)" — the on-volume claim; both name the holder's pid.)
  if grep -q 'another writer holds the single-writer guard' <<< "$out" && grep -qE 'holds the writer lock \(claim:|claimed by a live writer \(claim:' "$log" 2>/dev/null; then
    lpid=$(grep -oE '(holds the writer lock|claimed by a live writer) \(claim: id=[0-9a-f]*, pid=[0-9]*' "$log" | head -1 | grep -o 'pid=[0-9]*' | cut -d= -f2)
    # On its way out = its own log says so ("stop requested"); a holder
    # serving a live mount (the `mount` group's second mount of SCRATCH_DEV
    # under `SUITE_SINGLE_WRITER=1`: generic/409–411, 589, 732 — under the
    # symmetric default it JOINS and never comes here) is refused at once,
    # never waited for: twelve 60 s waits made one test 40 minutes.
    # ("exiting": a daemon leaving on its own — a FAILED volume after dm-error
    # — whose claim stands by design until its pid is provably dead.)
    # A holder whose own mountpoint is no longer served is leaving too (a
    # FAILED daemon's `.stats` is unreadable, so `squeezefs umount` detached
    # it externally and returned before its exit: generic/475's soak loop).
    hlog=$(grep -l "ready: .*(pid $lpid;" "$SET_DIR"/daemon-*.log 2>/dev/null | head -1)
    hmnt=$(grep -o "ready: .* mounted at [^ ]* (pid $lpid;" "$hlog" 2>/dev/null | sed 's/.* mounted at //; s/ (pid.*//')
    if [ -n "$lpid" ] && [ -n "$hlog" ] && ! grep -qE 'stop requested|— exiting [0-9]' "$hlog" && { [ -z "$hmnt" ] || grep -q " $hmnt fuse.squeezefs " /proc/mounts; }; then lpid=""; fi
    if [ -n "$lpid" ] && [ -d "/proc/$lpid" ] && ! grep -q 'State:.*Z' "/proc/$lpid/status" 2>/dev/null; then
      waited=0
      while [ -d "/proc/$lpid" ] && ! grep -q 'State:.*Z' "/proc/$lpid/status" 2>/dev/null && [ "$waited" -lt 60 ]; do sleep 1; waited=$((waited + 1)); done
      if [ ! -d "/proc/$lpid" ] || grep -q 'State:.*Z' "/proc/$lpid/status" 2>/dev/null; then
        echo "$(date +%s) mount $dir: waited ${waited}s for the previous holder (pid $lpid) to exit; retrying" >> "$SET_DIR/mounts.log"
        [ "$attempt" -lt 3 ] && continue
      fi
    elif [ -n "$lpid" ]; then
      # Gone between the daemon's check and ours (it held the flock for its
      # last milliseconds): the plain retry.
      echo "$(date +%s) mount $dir: the previous holder (pid $lpid) exited meanwhile; retrying" >> "$SET_DIR/mounts.log"
      [ "$attempt" -lt 3 ] && continue
    fi
  fi
  if [ "$attempt" -lt 3 ] && grep -q 'another writer holds the single-writer guard' <<< "$out" && grep -q 'stale writer claim' "$log" 2>/dev/null; then
    cpid=$(grep -o 'stale writer claim (id=[0-9a-f]*, pid=[0-9]*' "$log" | head -1 | grep -o 'pid=[0-9]*' | cut -d= -f2)
    if [ -n "$cpid" ] && { [ ! -d "/proc/$cpid" ] || grep -q 'State:.*Z' "/proc/$cpid/status" 2>/dev/null; }; then
      echo "$(date +%s) DAEMON DIED: claim pid $cpid is gone; clearing the claim (operator attestation: the set is the harness's) and retrying $attempt/3" | tee -a "$SET_DIR/mounts.log" >> "$SET_DIR/daemon-died"
      "$SQZ_BIN" claim clear "$SLICE_META_URI" >> "$SET_DIR/mounts.log" 2>&1 || true
      continue
    fi
  fi
  echo "$out" >&2
  mount_failed
  exit "$rc"
done

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sqz kernel recipe <sqz-kernel@squeezefs>
Date: Tue, 13 Oct 2026 09:00:00 -0400
Subject: [PATCH 27/27] sqz: fuse: allow FUSE_SYNCFS for privileged userspace
 servers (backport)

Backport of Jimmy Zuber's "[PATCH v3 1/2] fuse: allow FUSE_SYNCFS for
privileged userspace servers" (LKML 2026-08-20, applied to fuse for-next;
upstream UAPI: FUSE_HAS_SYNCFS = 1ULL << 44, minor 7.47) onto linux-7.2.6
+ the sqz series.

Why the sqz series carries it: SqueezeFS's daemon holds write custody
(the accumulation table, the W2 extent overlays, the device overlay, open
rewrite epochs, parked inode stamps) that only an fsync/fsyncdir drains.
On 7.2.6 a plain /dev/fuse mount never sees syncfs(2)/sync(2):
fuse_sync_fs() returns 0 unless fc->sync_fs, which only virtiofs and
fuseblk set — so `sync -f <mnt>` was no durability point at all (a peer
read a closed, `sync -f`'d 1 MiB file as zeros; a kill -9 after `sync -f`
lost the data). With this patch the daemon (root, CAP_SYS_ADMIN in the
initial user namespace) answers FUSE_HAS_SYNCFS in its INIT reply and
serves FUSE_SYNCFS as a mount-wide fsync.

Deltas from upstream v3: the uapi bit is upstream's (44) so a daemon built
against either kernel agrees; FUSE_KERNEL_MINOR_VERSION stays 45 (this
series' own uapi additions keep the in-tree minor — the flag is not
minor-gated in process_init_reply); the uapi doc rows sit beside the sqz
FUSE_TIME_LIMITS row.

Signed-off-by: sqz kernel recipe <sqz-kernel@squeezefs>
---
--- a/fs/fuse/fuse_i.h
+++ b/fs/fuse/fuse_i.h
@@ -391,6 +391,7 @@
 	bool no_control:1;
 	bool no_force_umount:1;
 	bool legacy_opts_show:1;
+	bool syncfs_capable:1;
 	enum fuse_dax_mode dax_mode;
 	unsigned int max_read;
 	unsigned int blksize;
@@ -674,6 +675,14 @@
 
 	/** @sync_fs: Propagate syncfs() to server */
 	unsigned int sync_fs:1;
+
+	/**
+	 * @syncfs_capable: the privilege required to honor FUSE_HAS_SYNCFS was
+	 * present when /dev/fuse was opened (CAP_SYS_ADMIN in the initial user
+	 * namespace), i.e. the same privilege that mounting virtiofs/fuseblk
+	 * requires.
+	 */
+	unsigned int syncfs_capable:1;
 
 	/** @init_security: Initialize security xattrs when creating a new inode */
 	unsigned int init_security:1;
--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -803,6 +803,15 @@
 	if (file->f_cred->user_ns != fsc->user_ns)
 		return invalfc(fsc, "wrong user namespace for fuse device");
 
+	/*
+	 * Record whether the server opened /dev/fuse with CAP_SYS_ADMIN in the
+	 * initial user namespace -- the same privilege that mounting virtiofs
+	 * or fuseblk requires.  Only such servers are trusted to receive
+	 * FUSE_SYNCFS (see fuse_syncfs_enable()).
+	 */
+	ctx->syncfs_capable = file_ns_capable(file, &init_user_ns,
+					      CAP_SYS_ADMIN);
+
 	ctx->fud = fuse_dev_grab(file);
 
 	return 0;
@@ -1269,6 +1278,16 @@
 	struct fuse_mount *fm;
 };
 
+/*
+ * A server can stall syncfs()/sync(), so only honor FUSE_HAS_SYNCFS for
+ * servers that opened /dev/fuse with CAP_SYS_ADMIN in the initial user
+ * namespace -- the same privilege required to mount virtiofs or fuseblk.
+ */
+static bool fuse_syncfs_enable(struct fuse_conn *fc, u64 flags)
+{
+	return (flags & FUSE_HAS_SYNCFS) && fc->syncfs_capable;
+}
+
 static void process_init_reply(struct fuse_args *args, int error)
 {
 	struct fuse_init_args *ia = container_of(args, typeof(*ia), args);
@@ -1414,6 +1433,9 @@
 
 			if (flags & FUSE_REQUEST_TIMEOUT)
 				timeout = arg->request_timeout;
+
+			if (fuse_syncfs_enable(fc, flags))
+				fc->sync_fs = 1;
 		} else {
 			ra_pages = fc->max_read / PAGE_SIZE;
 			fc->no_lock = 1;
@@ -1482,6 +1504,11 @@
 		flags |= FUSE_SUBMOUNTS;
 	if (IS_ENABLED(CONFIG_FUSE_PASSTHROUGH))
 		flags |= FUSE_PASSTHROUGH;
+	/* Only offered to sufficiently privileged servers; see
+	 * fuse_syncfs_enable().
+	 */
+	if (fm->fc->syncfs_capable)
+		flags |= FUSE_HAS_SYNCFS;
 
 	if (fuse_uring_enabled())
 		flags |= FUSE_OVER_IO_URING;
@@ -1773,6 +1800,7 @@
 
 	fc->default_permissions = ctx->default_permissions;
 	fc->allow_other = ctx->allow_other;
+	fc->syncfs_capable = ctx->syncfs_capable;
 	fc->user_id = ctx->user_id;
 	fc->group_id = ctx->group_id;
 	fc->legacy_opts_show = ctx->legacy_opts_show;
--- a/include/uapi/linux/fuse.h
+++ b/include/uapi/linux/fuse.h
@@ -248,6 +248,7 @@
  *  - add FUSE_IO_URING_CMD_RELEASE_PAYLOAD
  *  - add FUSE_URING_PAYLOAD_RETENTION init flag
  *  - add fuse_uring_cmd_req commit.flags / FUSE_URING_COMMIT_RETAIN
+ *  - add FUSE_HAS_SYNCFS opt-in flag for privileged userspace servers
  */
 
 #ifndef _LINUX_FUSE_H
@@ -458,6 +459,12 @@
  *			 init_out.request_timeout contains the timeout (in secs)
  * FUSE_TIME_LIMITS: kernel honors init_out.time_{min,max} as the superblock
  *		     inode-timestamp range (sqz-private)
+ * FUSE_HAS_SYNCFS: server requests that syncfs()/sync() be propagated as
+ *		FUSE_SYNCFS requests.  Since an untrusted server can use this
+ *		to stall sync(), it is only honored when /dev/fuse was opened
+ *		with CAP_SYS_ADMIN in the initial user namespace (the same
+ *		privilege that mounting virtiofs or fuseblk requires).
+ *		Insufficiently privileged servers ignore it.
  */
 #define FUSE_ASYNC_READ		(1 << 0)
 #define FUSE_POSIX_LOCKS	(1 << 1)
@@ -505,6 +512,7 @@
 #define FUSE_ALLOW_IDMAP	(1ULL << 40)
 #define FUSE_OVER_IO_URING	(1ULL << 41)
 #define FUSE_REQUEST_TIMEOUT	(1ULL << 42)
+#define FUSE_HAS_SYNCFS		(1ULL << 44)
 /*
  * sqz-private: deliberately far above the upstream watermark (bit 42 is the
  * last allocated in-tree) so an upstream collision is a recompile, not an
-- 
2.50.1

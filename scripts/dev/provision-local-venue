#!/usr/bin/env bash
# provision-local-venue — check THIS Linux host as the `local` venue (scripts/venue with
# SQZ_VENUE=local, the default on Linux): gates, perf runs and kernel builds run here natively,
# as root through sudo. Idempotent: every fact prints as `ok` or `MISSING` with its fix.
#
#   scripts/dev/provision-local-venue           # check only; exit 1 when something is missing
#   scripts/dev/provision-local-venue --apply   # also fix what is safe to fix, then re-check:
#       install the missing packages (apt or pacman), then scripts/dev/provision-ssh-venue
#       (the nvmet modules loaded and persisted, the nvme_core boot parameter in GRUB or
#       Limine, IOR/mdtest into /opt/sqz-tools, root-MPI env, the build root's directories)
#
# Two package families: Debian/Ubuntu (apt, dpkg; a distro or kernel.org Linux >= 7.3) and
# Arch and its derivatives such as Omarchy (pacman; scripts/kernel/build-host-kernel builds
# mainline + scripts/kernel/patches-mainline with makepkg).
#
# Never done here: a kernel install, a reboot, a filesystem, LV or sudoers change — those
# print as commands to run.
set -uo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
ROOT=${SQZ_BUILD_ROOT:-/build}
REF=${SQZ_REFERENCE:-$HOME/Source/squeezefs}
ZIG_WANT=0.17.0
# The oldest kernel the daemon mounts on: FUSE-over-io_uring buffer pools (uapi 7.46), the
# transport's only mode since the owner's 2026-10-29 ruling; the daemon refuses an older one
# by its INIT probe (FUSE_HAS_IO_URING_BUFPOOL), this check reads the release.
KMIN_MAJOR=7 KMIN_MINOR=3
apply=0
case "${1:-}" in --apply) apply=1 ;; '') ;; *) echo "usage: provision-local-venue [--apply]" >&2; exit 2 ;; esac

missing=0
ok() { printf '  ok       %s\n' "$*"; }
note() { printf '  note     %s\n' "$*"; }
miss() { printf '  MISSING  %s\n' "$1"; shift; for l in "$@"; do printf '           → %s\n' "$l"; done; missing=$((missing + 1)); }

[ "$(uname -s)" = Linux ] || { echo "provision-local-venue: this host is $(uname -s); on macOS the venue is the vm (scripts/venue up)" >&2; exit 2; }
. /etc/os-release
echo "== host: $PRETTY_NAME, $(uname -m), $(nproc) threads, $(awk '/^MemTotal:/ { print int($2 / 1048576) }' /proc/meminfo) GiB"
# The package family: the package names, the installer and how the kernel is packaged.
# A derivative names its parent in ID_LIKE (Omarchy: ID=omarchy ID_LIKE=arch).
case " $ID ${ID_LIKE:-} " in
  *" ubuntu "* | *" debian "*) FAMILY=deb ;;
  *" arch "*) FAMILY=arch ;;
  *) FAMILY=deb; note "$ID is untested: the scripts know apt/dpkg (Debian, Ubuntu) and pacman (Arch); assuming apt" ;;
esac
note "one architecture per venue: $(uname -m) here; the other architecture's coverage needs a second venue (the Mac's vm for aarch64, or an ssh box)"
[ "$ID-$VERSION_ID" = ubuntu-26.04 ] && note "Ubuntu 26.04 ships uutils coreutils — already handled: dd ftruncates its output after the last write (the smoke writes with conv=notrunc); 'sync FILE' is a host-wide sync(2) (tests/rails.zig's sync scanner counts it)"

echo "== sudo"
if sudo -n true 2>/dev/null; then
  ok "passwordless sudo (scripts/venue runs every command as root, without a terminal)"
else
  miss "passwordless sudo" "echo '$(id -un) ALL=(ALL) NOPASSWD: ALL' | sudo tee /etc/sudoers.d/sqz-venue && sudo chmod 440 /etc/sudoers.d/sqz-venue"
fi

echo "== zig $ZIG_WANT"
if command -v mise >/dev/null; then
  # A mise-managed zig (owner preference 2026-10-16). Root's login shell has no mise
  # activation, so root gets a link to the versioned install — never the shim, which resolves
  # the version from the caller's mise config, and root has none.
  if p=$(mise where "zig@$ZIG_WANT" 2>/dev/null); then zig_fix="sudo ln -sfn $p/zig /usr/local/bin/zig   # mise's install"
  else zig_fix="mise use -g zig@$ZIG_WANT && sudo ln -sfn \"\$(mise where zig@$ZIG_WANT)/zig\" /usr/local/bin/zig"; fi
else
  zig_fix="curl -fsSL https://ziglang.org/download/$ZIG_WANT/zig-$(uname -m)-linux-$ZIG_WANT.tar.xz | sudo tar -xJ -C /opt && sudo ln -sfn /opt/zig-$(uname -m)-linux-$ZIG_WANT/zig /usr/local/bin/zig"
fi
v=$(zig version 2>/dev/null)
[ "$v" = "$ZIG_WANT" ] && ok "zig $v on PATH" || miss "zig $ZIG_WANT on PATH (have: ${v:-none})" "$zig_fix"
v=$(sudo -n bash -lc 'zig version' 2>/dev/null)
[ "$v" = "$ZIG_WANT" ] && ok "zig $v on root's login PATH (sudo bash -lc)" || miss "zig $ZIG_WANT on root's login PATH (have: ${v:-none})" "$zig_fix"

echo "== kernel"
kr=$(uname -r)
kmaj=${kr%%.*}; kmin=${kr#*.}; kmin=${kmin%%[!0-9]*}
if [ "$kmaj" -gt "$KMIN_MAJOR" ] || { [ "$kmaj" = "$KMIN_MAJOR" ] && [ "${kmin:-0}" -ge "$KMIN_MINOR" ]; }; then
  case $kr in
    *sqz*) ok "kernel $kr (Linux >= $KMIN_MAJOR.$KMIN_MINOR, the sqz mainline series)" ;;
    *) ok "kernel $kr (Linux >= $KMIN_MAJOR.$KMIN_MINOR)"
       note "no sqz tag: scripts/kernel/patches-mainline is absent (FUSE_TIME_LIMITS, FUSE_SYNCFS before 7.4, host-scoped NVMe-oF subsystems)" ;;
  esac
elif [ "$FAMILY" = arch ]; then
  miss "Linux >= $KMIN_MAJOR.$KMIN_MINOR (running $kr): FUSE-over-io_uring buffer pools — the daemon refuses an older kernel" \
    "scripts/kernel/build-host-kernel --local   # mainline $KMIN_MAJOR.$KMIN_MINOR + scripts/kernel/patches-mainline, makepkg, pacman -U; the Limine hooks make the UKI and entry (never reboots)" \
    "(after a base bump: build-host-kernel --local --prepare-only first — every patch at --fuzz=0 in minutes)" "then REBOOT into it"
else
  miss "Linux >= $KMIN_MAJOR.$KMIN_MINOR (running $kr): FUSE-over-io_uring buffer pools — the daemon refuses an older kernel" \
    "install a distro or kernel.org $KMIN_MAJOR.$KMIN_MINOR+ kernel with CONFIG_FUSE_IO_URING=y (scripts/kernel/config-fragment lists the rest), then REBOOT into it"
fi
if [ -e /sys/module/fuse/parameters/enable_uring ]; then ok "fuse.enable_uring=$(cat /sys/module/fuse/parameters/enable_uring) (the daemon sets it)"; else
  miss "fuse.enable_uring (CONFIG_FUSE_IO_URING: a mount has no classical fallback, charter §1.2)" "a Linux >= $KMIN_MAJOR.$KMIN_MINOR kernel built with CONFIG_FUSE_IO_URING=y (above)"
fi
v=$(cat /proc/sys/kernel/io_uring_disabled 2>/dev/null || echo 0)
[ "$v" = 0 ] && ok "io_uring enabled" || miss "io_uring (kernel.io_uring_disabled=$v)" "echo kernel.io_uring_disabled=0 | sudo tee /etc/sysctl.d/60-sqz-io-uring.conf && sudo sysctl --system"
lack=""
for m in nvmet nvme_loop nvmet_tcp nvme_tcp nvme_fabrics tls brd null_blk; do
  [ -d "/sys/module/$m" ] || modprobe -n "$m" 2>/dev/null || lack="$lack $m"
done
[ -z "$lack" ] && ok "modules nvmet nvme_loop nvmet_tcp nvme_tcp nvme_fabrics tls brd null_blk available" \
  || miss "modules:$lack (the nvmet, NVMe-oF, kTLS and RAM-namespace rows)" "a kernel config that has them (scripts/kernel/config-fragment lists them)"
[ -f /etc/modules-load.d/sqz.conf ] && ok "nvmet modules persisted (/etc/modules-load.d/sqz.conf)" \
  || miss "the nvmet modules loaded at boot" "scripts/dev/provision-local-venue --apply"
# Where provision-ssh-venue persists a kernel parameter: Debian's GRUB drop-ins, or
# limine-entry-tool's drop-ins (Omarchy); anything else is by hand.
if [ -d /etc/default/grub.d ]; then cmdline_fix="scripts/dev/provision-local-venue --apply (persists it in GRUB: /etc/default/grub.d/sqz-venue.cfg), then reboot"
elif [ -d /etc/limine-entry-tool.d ] && command -v limine-mkinitcpio >/dev/null; then cmdline_fix="scripts/dev/provision-local-venue --apply (persists it in Limine: /etc/limine-entry-tool.d/sqz-venue.conf, then limine-mkinitcpio rebuilds the boot image), then reboot"
elif [ -f /etc/default/grub ]; then cmdline_fix="append it to GRUB_CMDLINE_LINUX_DEFAULT in /etc/default/grub && sudo grub-mkconfig -o /boot/grub/grub.cfg, then reboot"
else cmdline_fix="append it to the kernel command line in your bootloader's config (neither GRUB drop-ins nor limine-entry-tool here), then reboot"; fi
grep -q 'nvme_core.fabrics_host_scoped_subsystems=Y' /proc/cmdline && ok "nvme_core.fabrics_host_scoped_subsystems=Y (the nvmet two-identity rows)" \
  || miss "nvme_core.fabrics_host_scoped_subsystems=Y on the kernel command line (the nvmet two-identity rows)" "$cmdline_fix"
# A desktop host runs udisks (and an automounter over it: Omarchy's udiskie): it probes and
# auto-mounts every loop device the suites format (LTP's .all_filesystems tests, xfstests'
# TEST_DEV/SCRATCH_DEV) — the next mkfs sees "is mounted", the loop never detaches, and the
# mounts outlive the run under /run/media. A udev rule marks loop devices backed by a file
# under the build root UDISKS_IGNORE (the suites' only loop devices); the user's own stay.
udev_rule=/etc/udev/rules.d/99-sqz-loop-ignore.rules
udev_rule_apply=0
if [ -x /usr/lib/udisks2/udisksd ] || [ -x /usr/libexec/udisks2/udisksd ]; then
  if [ -f "$udev_rule" ]; then ok "udisks ignores the suites' loop devices ($udev_rule)"
  else udev_rule_apply=1; miss "udisks/udiskie kept off the suites' loop devices (a desktop host auto-mounts what LTP and xfstests format)" "scripts/dev/provision-local-venue --apply   # $udev_rule: UDISKS_IGNORE for loop devices backed under $(readlink -f "$ROOT" 2>/dev/null || echo "$ROOT")"; fi
fi

echo "== packages"
pkgs=()
if [ "$FAMILY" = deb ]; then
  lock=$REPO/scripts/suites/apt.$ID-$VERSION_ID.lock
  pkg_from="suites lock, instruments"
  if [ -f "$lock" ]; then mapfile -t pkgs < <(cut -d= -f1 "$lock"); else note "no suites lock for $ID-$VERSION_ID (scripts/suites/apt.*.lock): the first suite run pins one"; fi
  # The instruments and the venue's own tools (build-essential builds IOR/mdtest).
  pkgs+=(fio nvme-cli fuse3 util-linux e2fsprogs rsync curl git python3 openssl openmpi-bin libopenmpi-dev
    build-essential flex bison bc libssl-dev zstd)
  pkg_have() { dpkg -s "$1" >/dev/null 2>&1; }
  pkg_install="sudo apt-get install -y --no-install-recommends"
else
  # The same instruments and tools under their Arch names (libelf carries libdw; openmpi is
  # one package), then what makepkg needs for the kernel PKGBUILD beyond base-devel —
  # `makepkg -s` installs the PKGBUILD's own makedepends (rust, xxhash, …) at build time.
  pkg_from="instruments, kernel build deps"
  pkgs+=(fio nvme-cli fuse3 util-linux e2fsprogs rsync curl git python openssl openmpi
    base-devel flex bison bc cpio pahole libelf zstd perl)
  pkg_have() { pacman -Q "$1" >/dev/null 2>&1; }
  pkg_install="sudo pacman -S --needed --noconfirm"
fi
lackp=()
for p in $(printf '%s\n' "${pkgs[@]}" | sort -u); do pkg_have "$p" || lackp+=("$p"); done
[ ${#lackp[@]} = 0 ] && ok "${#pkgs[@]} packages ($pkg_from)" \
  || miss "packages: ${lackp[*]}" "$pkg_install ${lackp[*]}   # or --apply"
if PATH=/opt/sqz-tools/bin:$PATH command -v ior >/dev/null && PATH=/opt/sqz-tools/bin:$PATH command -v mdtest >/dev/null; then
  ok "ior/mdtest ($(PATH=/opt/sqz-tools/bin:$PATH command -v ior))"
else
  miss "ior/mdtest at io500's pinned hash" "scripts/dev/provision-local-venue --apply (builds them into /opt/sqz-tools)"
fi
# (The kernel series lives in scripts/kernel/patches-mainline; the reference is porting
# evidence only.)
git -C "$REF" rev-parse --is-inside-work-tree >/dev/null 2>&1 && ok "the Rust reference at $REF (read-only porting evidence)" \
  || miss "the Rust reference at $REF (read-only porting evidence; the vm venue mounts it)" "git clone git@github.com:flipfloptech/squeezefs.git $REF   # or set SQZ_REFERENCE"

echo "== build root $ROOT (SQZ_BUILD_ROOT)"
if [ -d "$ROOT" ]; then
  real=$(readlink -f "$ROOT")
  fstype=$(findmnt -no FSTYPE -T "$real")
  src=$(findmnt -no SOURCE -T "$real")
  avail=$(df -BG --output=avail "$real" | tail -1 | tr -dc 0-9)
  case $fstype in
    ext4) ok "$real: ext4 on $src" ;;
    xfs | btrfs) ok "$real: $fstype on $src (ext4 is what the venues measure on)" ;;
    *) miss "a real local filesystem at $real (it is $fstype on $src)" "ext4 recommended: real block semantics and sparse files (tmpfs, overlay, nfs, fuse and virtiofs change what the smoke measures)" ;;
  esac
  # A 30 GB zig cache cap (scripts/venue trim) + a gate's smoke volumes + the perf targets.
  [ "${avail:-0}" -ge 50 ] && ok "$avail GiB free" || miss "≥ 50 GiB free at $real (have ${avail:-0} GiB)" "grow it (lvextend -r) or free space: scripts/venue trim"
  if t=$(sudo -n mktemp -p "$real" .sparse-probe.XXXXXX 2>/dev/null); then
    sudo -n truncate -s 1G "$t"
    used=$(sudo -n du -k "$t" | cut -f1)
    sudo -n rm -f "$t"
    [ "$used" -lt 1024 ] && ok "sparse files" || miss "sparse files (a 1 GiB truncate took $used KiB)" "put the build root on ext4"
  fi
  [ "$(lsblk -dno DISC-MAX "$src" 2>/dev/null | tr -d ' ')" != 0B ] && ok "discard (scripts/venue trim runs fstrim)" \
    || note "$src has no discard: scripts/venue trim prunes and skips fstrim"
  for d in zig-cache-v2 zig-global-cache tmp; do [ -d "$real/$d" ] || lackd="${lackd:-} $d"; done
  [ -z "${lackd:-}" ] && ok "zig-cache-v2 zig-global-cache tmp" || miss "build-root directories:$lackd" "scripts/dev/provision-local-venue --apply"
  # The product's tests and the smoke's defaults write under /build/tmp.
  [ "$(readlink -f /build)" = "$real" ] && ok "/build resolves to the build root" \
    || miss "/build → $real (the product's tests write under /build/tmp)" "sudo ln -sfn $real /build"

  # The test images in RAM (owner ruling 2026-10-16: a venue with RAM to spare keeps them off
  # the disk). /build/tmp is where the tests, the smoke's volumes and the suites write: an
  # ext4 of its own on a zram device — still ext4 (sparse files, O_DIRECT, discard, the
  # device numbers /proc/locks reports), every byte in memory. zram, not brd: brd belongs to
  # scripts/perf/ramnvme.sh, which refuses to start when brd is loaded. Mounted with discard,
  # so a deleted image gives its memory back at once; lz4 keeps the per-write cost low; the
  # capacity is half the RAM (sparse images and compressible test data use far less).
  echo "== test images $real/tmp (RAM)"
  mem_gib=$(awk '/^MemTotal:/ { print int($2 / 1048576) }' /proc/meminfo)
  tmp_src=$(findmnt -no SOURCE --mountpoint "$real/tmp" 2>/dev/null)
  tmp_fs=$(findmnt -no FSTYPE --mountpoint "$real/tmp" 2>/dev/null)
  ram_tmp_apply=0 ram_tmp_ok=0
  if [ "$tmp_fs" = ext4 ] && [[ $tmp_src == /dev/zram* ]]; then
    ram_tmp_ok=1
    ok "$real/tmp: ext4 on $tmp_src ($(df -BG --output=size "$real/tmp" | tail -1 | tr -dc 0-9) GiB, in RAM; $(df -BG --output=used "$real/tmp" | tail -1 | tr -dc 0-9) GiB used)"
  elif [ "$mem_gib" -lt 64 ]; then
    note "$real/tmp stays on the build root: $mem_gib GiB of RAM is under the 64 GiB a RAM-backed one needs beside a gate"
  elif [ -n "$tmp_fs" ]; then
    miss "$real/tmp in RAM (it is a $tmp_fs mount on ${tmp_src:-?}, not ext4 on zram)" "unmount it, then scripts/dev/provision-local-venue --apply"
  elif [ -x /usr/lib/systemd/system-generators/zram-generator ]; then
    ram_tmp_apply=1
    miss "$real/tmp in RAM (it is a directory on the build root's $fstype)" \
      "scripts/dev/provision-local-venue --apply   # zram-generator: /etc/systemd/zram-generator.conf.d/sqz-build-tmp.conf (ext4 on zram, RAM/2, mounted at boot) + a tmpfiles rule for its 1777 mode"
  else
    miss "$real/tmp in RAM (it is a directory on the build root's $fstype; no zram-generator here)" \
      "install zram-generator, then scripts/dev/provision-local-venue --apply (or: a zram device formatted ext4, mounted at $real/tmp with -o discard, mode 1777)"
  fi
  # std.testing.tmpDir writes under the cwd's .zig-cache/tmp (16 call sites): a link into the
  # RAM tmp puts those images in memory too.
  # shortcut: this tree only, a worktree's .zig-cache/tmp stays on disk; link it the same way if one runs gates.
  zig_tmp_apply=0
  if [ "$ram_tmp_ok" = 1 ] || [ "$ram_tmp_apply" = 1 ]; then
    if [ "$(readlink "$REPO/.zig-cache/tmp")" = "$real/tmp/zig-testing" ]; then ok "$REPO/.zig-cache/tmp → $real/tmp/zig-testing (std.testing.tmpDir in RAM)"
    else zig_tmp_apply=1; miss "$REPO/.zig-cache/tmp in RAM (std.testing.tmpDir's images)" "scripts/dev/provision-local-venue --apply   # a link to $real/tmp/zig-testing"; fi
  fi
else
  vgs=$(sudo -n vgs --noheadings --units g -o vg_name,vg_free 2>/dev/null | awk '{ printf "%s (%s free) ", $1, $2 }')
  if [ -n "$vgs" ]; then
    vg=$(sudo -n vgs --noheadings -o vg_name 2>/dev/null | awk 'NR==1 { print $1 }')
    miss "the build root $ROOT: an ext4 filesystem of its own (volume groups here: $vgs)" \
      "sudo lvcreate -L 300G -n sqzbuild $vg && sudo mkfs.ext4 -L sqzbuild /dev/$vg/sqzbuild" \
      "sudo mkdir -p $ROOT && echo '/dev/$vg/sqzbuild $ROOT ext4 defaults,noatime 0 2' | sudo tee -a /etc/fstab && sudo systemctl daemon-reload && sudo mount $ROOT" \
      "then: scripts/dev/provision-local-venue --apply"
  else
    rootfs=$(findmnt -no FSTYPE /)
    # On a btrfs root, a TOP-LEVEL subvolume mounted by fstab, as @home is: a root snapshot
    # (snapper) does not include it and a rollback keeps it; +C (no copy-on-write) spares the
    # test volumes' random writes the CoW amplification. Mount options are per filesystem on
    # btrfs, so +C on the directory is the only per-subvolume knob.
    if [ "$rootfs" = btrfs ]; then
      dev=$(findmnt -no SOURCE / | sed 's/\[.*//'); uuid=$(findmnt -no UUID /)
      on_root="a top-level subvolume on the btrfs root fs: sudo mount -o subvolid=5 $dev /mnt && sudo btrfs subvolume create /mnt/@build && sudo umount /mnt && sudo mkdir -p $ROOT && echo 'UUID=$uuid $ROOT btrfs rw,noatime,ssd,space_cache=v2,subvol=/@build 0 0' | sudo tee -a /etc/fstab && sudo systemctl daemon-reload && sudo mount $ROOT && sudo chattr +C $ROOT"
    else on_root="a directory on the $rootfs root fs: sudo mkdir -p $ROOT"; fi
    miss "the build root $ROOT: an ext4 filesystem of its own (a spare disk or partition; no LVM here)" \
      "sudo mkfs.ext4 -L sqzbuild /dev/<disk-or-partition> && sudo mkdir -p $ROOT && echo 'LABEL=sqzbuild $ROOT ext4 defaults,noatime 0 2' | sudo tee -a /etc/fstab && sudo mount $ROOT" \
      "(or $on_root) — then: scripts/dev/provision-local-venue --apply"
  fi
fi

if [ "$apply" = 1 ]; then
  echo "== apply"
  if [ ${#lackp[@]} != 0 ]; then
    case $FAMILY in
      deb) sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${lackp[@]}" ;;
      arch) sudo pacman -S --needed --noconfirm "${lackp[@]}" ;;
    esac || exit 1
  fi
  if [ "$udev_rule_apply" = 1 ]; then
    rr=$(readlink -f "$ROOT" 2>/dev/null || echo "$ROOT")
    printf '%s\n' "# squeezefs venue (scripts/dev/provision-local-venue): the suites' loop devices (LTP's" \
      "# .all_filesystems tests, xfstests' TEST_DEV/SCRATCH_DEV) are backed by files under the build" \
      "# root; udisks must neither probe nor auto-mount them (udiskie mounted every one under /run/media)." \
      "SUBSYSTEM==\"block\", KERNEL==\"loop[0-9]*\", ATTR{loop/backing_file}==\"$rr/*\", ENV{UDISKS_IGNORE}=\"1\"" \
      | sudo tee "$udev_rule" >/dev/null || exit 1
    sudo udevadm control --reload || exit 1
  fi
  if [ "${ram_tmp_apply:-0}" = 1 ]; then
    # (The distro's own zram config may live under /usr/lib only: the /etc drop-in dir may not exist.)
    sudo mkdir -p /etc/systemd/zram-generator.conf.d || exit 1
    printf '%s\n' "# squeezefs venue (scripts/dev/provision-local-venue): the test images in RAM" \
      "[zram1]" "zram-size = ram / 2" "compression-algorithm = lz4" "fs-type = ext4" \
      "mount-point = $real/tmp" "options = discard" \
      | sudo tee /etc/systemd/zram-generator.conf.d/sqz-build-tmp.conf >/dev/null || exit 1
    sudo systemctl daemon-reload
    unit=$(systemd-escape --path --suffix=mount "$real/tmp")
    # Under the gate lock and every build slot (as scripts/venue trim prunes), so no test has a
    # file open under the directory the mount covers; what the disk directory held moves aside.
    locks=(flock -o -w 900 "$real/.gate.lock")
    for s in "$real"/.build-slot.*; do [ -e "$s" ] && locks+=(flock -o "$s"); done
    sudo "${locks[@]}" bash -c 'set -e
      if [ -n "$(ls -A "$1")" ]; then old="$1.disk-$(date +%Y%m%d-%H%M%S)"; mv "$1" "$old"; mkdir "$1"; echo "provision: the old $1 moved to $old (test leftovers on disk; delete it when done)"; fi
      systemctl start "$2"' _ "$real/tmp" "$unit" || exit 1
  fi
  if [ "${ram_tmp_apply:-0}" = 1 ] || [ "${zig_tmp_apply:-0}" = 1 ]; then
    # A fresh ext4 root is 0755 and empty at every boot: the tests' unprivileged legs need the
    # sticky 1777, and the .zig-cache/tmp link needs its target.
    printf '%s\n' "# squeezefs venue (scripts/dev/provision-local-venue)" "d $real/tmp 1777 root root -" "d $real/tmp/zig-testing 1777 root root -" \
      | sudo tee /etc/tmpfiles.d/sqz-build-tmp.conf >/dev/null || exit 1
    sudo systemd-tmpfiles --create /etc/tmpfiles.d/sqz-build-tmp.conf || exit 1
    z=$REPO/.zig-cache/tmp
    mkdir -p "$REPO/.zig-cache"
    # An empty directory goes; one with contents is someone's: refuse.
    [ -L "$z" ] || [ ! -e "$z" ] || rmdir "$z" || { echo "provision-local-venue: $z is not empty — move it, then --apply again" >&2; exit 1; }
    ln -sfn "$real/tmp/zig-testing" "$z"
  fi
  if [ -d "$ROOT" ]; then sudo SQZ_BUILD_ROOT="$(readlink -f "$ROOT")" bash "$REPO/scripts/dev/provision-ssh-venue" || exit 1
  else echo "provision-local-venue: no build root $ROOT yet — create it (above), then --apply again" >&2; fi
  echo "== re-check"
  exec bash "$0"
fi

if [ "$missing" = 0 ]; then echo "local venue: ready (scripts/venue status; scripts/venue zig build gate)"; else
  echo "local venue: $missing missing — fix them as shown (--apply does the packages, modules, tools and directories)"
  exit 1
fi

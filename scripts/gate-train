#!/usr/bin/env bash
# gate-train — THE gate for `dev`: one runner gates dev's head on every Linux venue
# in GATE_TRAIN_VENUES (each through scripts/venue, so each waits for that venue's
# gate lock and build slots), re-gates an unchanged green head until it has three
# consecutive greens on ALL of them (charter §11's release criterion: three
# consecutive clean runs on one binary), and prints ONE line per run so a monitor
# can react. Agents land after targeted runs on a Linux venue; the train owns the
# full gating (AGENTS.md "Landing"). The product is Linux-only (charter §1.2): no
# macOS gate (owner ruling 2026-10-14) — `zig build gate` on macOS stays an
# optional local check of the portable modules.
#
#   scripts/gate-train            # loop forever (run it as a monitor)
#   scripts/gate-train --once     # gate dev's head once and exit
#   GATE_TRAIN_VENUES="vm kamrui" # the venues (default: vm); see scripts/venue
#
# State lives in .gate-train/ (ignored): ledger.tsv (utc, sha, verdict, one
# venue:result:wall field per venue, failures) and each run's logs. The train
# gates a detached worktree .wt-train so nothing it does touches an agent's tree;
# `-Dfresh=true` makes every test step run for real on the cached binary (a repeat
# of an unchanged head would otherwise answer from the build cache).
set -uo pipefail
# The logs carry UTF-8; macOS awk refuses multibyte input outside the C locale.
export LC_ALL=C

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
STATE=$REPO/.gate-train
TRAIN=$REPO/.wt-train
VENUES=${GATE_TRAIN_VENUES:-vm}
POLL_S=${GATE_TRAIN_POLL_S:-300}   # how often an idle train looks for a new head
WANT_STREAK=3                      # charter §11: three consecutive clean runs
once=0; [ "${1:-}" = --once ] && once=1
mkdir -p "$STATE"
LEDGER=$STATE/ledger-v2.tsv
[ -f "$LEDGER" ] || printf 'utc\tsha\tverdict\tvenues\tfailures\n' > "$LEDGER"

if [ ! -d "$TRAIN" ]; then
  git -C "$REPO" worktree add --detach "$TRAIN" dev >/dev/null 2>&1 || { echo "gate-train: cannot create $TRAIN"; exit 1; }
fi

summary() { grep -E '^Build Summary' "$1" | tail -1 | sed 's/^Build Summary: //'; }
failures() {  # failed tests by name, else the steps that failed on their own (not transitively)
  {
    grep -E "^error: '|^error: while executing test '" "$1" | sed -E "s/^error: (while executing test )?'([^']*)'.*/\2/"
    awk '/^Build Summary/{f=1} f' "$1" | grep -E ' (failure|[0-9]+ errors?|[0-9]+ failed)' | grep -v transitive | sed -E 's/^[ |+-]*//; s/ (failure|[0-9]+ errors?|[0-9]+ failed).*//' | sed 's/^/step: /'
    # The build runner's own wording for a step whose command was killed (a test's
    # deliberately killed daemon prints "daemon A ended terminated with signal KILL").
    grep -Eq '^error: [^ ]*zig[^ ]* terminated with signal KILL' "$1" && echo "a build step's command was killed (signal KILL — OOM?)"
  } | sort -u | head -8 | paste -sd ';' -
}

# Consecutive rows on $1 at the end of the ledger with verdict $2 (green|red).
run_of() { awk -F'\t' -v s="$1" -v want="$2" 'NR>1 { if ($2==s && $3==want) n++; else n=0 } END { print n+0 }' "$LEDGER"; }

run_once() {
  # (One word per `local`: bash expands every word of a `local` before assigning any.)
  local sha=$1
  local verdict=green fields="" fails="" line="" v log t0 rc wall res
  git -C "$TRAIN" checkout -q --detach "$sha" || return 1
  for v in $VENUES; do
    log=$STATE/$v-$sha.log
    t0=$(date +%s)
    SQZ_VENUE=$v "$REPO/scripts/venue" "cd '$TRAIN' && timeout 3900 zig build --cache-dir /build/zig-cache-v2 -Dfresh=true gate --summary all" > "$log" 2>&1
    rc=$?
    wall=$(( $(date +%s) - t0 ))
    if [ $rc -eq 0 ]; then res=green; else res=red; verdict=red; fails="$fails${fails:+;}$(failures "$log" | sed "s/^/$v:/; s/;/;$v:/g")"; fi
    fields="$fields${fields:+ }$v:$res:${wall}s"
    line="$line | $v $(echo $res | tr a-z A-Z) $(summary "$log") ${wall}s"
  done
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%MZ)" "$sha" "$verdict" "$fields" "$fails" >> "$LEDGER"
  echo "gate-train $(git -C "$REPO" log -1 --format='%h %s' "$sha" | cut -c1-60)$line | streak $(run_of "$sha" green)/${WANT_STREAK}${fails:+ | FAIL: $fails}"
}

while true; do
  head=$(git -C "$REPO" rev-parse --short=12 dev)
  streak=$(run_of "$head" green)
  if [ "$(run_of "$head" red)" -ge 2 ]; then
    # Red twice in a row on this head: not a flake to retry — wait for a fix.
    [ "$once" = 1 ] && { echo "gate-train $head is red twice; waiting for dev to move"; exit 1; }
    sleep "$POLL_S"; continue
  elif [ "$streak" -lt "$WANT_STREAK" ]; then
    run_once "$head"
  elif [ "$once" = 1 ]; then
    echo "gate-train $head already has $streak consecutive greens"
  fi
  [ "$once" = 1 ] && exit 0
  # A green streak complete on an unchanged head: idle until dev moves.
  [ "$(run_of "$head" green)" -ge "$WANT_STREAK" ] && sleep "$POLL_S"
done

From: SqueezeFS-Zig <sqz@localhost>
Date: Sun, 19 Oct 2026 06:00:00 +0000
Subject: [PATCH] sqz: fuse: io_uring: several io_urings may serve one queue

The kernel picks a request's queue by the submitting task's CPU
(fuse_uring_task_to_queue) with no fallback, so one io_uring submitter's
whole depth lands on ONE queue and is served by whatever registered that
queue's entries. With kernel-managed buffer rings that is exactly one
io_uring: the queue pins ONE kmbuf payload ring at creation
(queue->bufring, from the first REGISTER's ctx) and selects every entry's
payload from it, while the recycle (io_uring_kmbuf_recycle) resolves the
buffer group in the ENTRY's cmd ctx — a second ring's entry on the queue
would select from ring A's list and recycle into ring B's.

Make the buffer ring a property of the registering ring, not the queue:
a queue keeps a list of sources (struct fuse_ring_src: ring ctx, its
pinned kmbuf ring, its zero-copy depth), each REGISTER's entry points at
its ring's source, buffer selection and the zc headers index go through
the entry's source, and a COMMIT_AND_FETCH from a ring other than the
entry's is refused (-EXDEV). One ring still serves one queue (the pin
refuses -EALREADY for a second queue); N rings may serve one queue, and
the dispatch takes the first available entry whichever ring it belongs
to, so a saturated queue spreads over the daemon's N workers.

A FEATURES command (cmd_op 4) answers the FUSE_URING_FEAT_* mask inline so
a daemon can probe for this before registering a second ring on a queue
(a kernel without it answers -EINVAL and the daemon keeps one worker per
queue).

Compile-checked (W=1) as an out-of-tree fuse module against the 7.2.8
omarchy-sqz tree; NOT yet booted or measured.
---
diff --git a/include/uapi/linux/fuse.h b/include/uapi/linux/fuse.h
--- a/include/uapi/linux/fuse.h
+++ b/include/uapi/linux/fuse.h
@@ -249,6 +249,9 @@
  *  - add FUSE_URING_PAYLOAD_RETENTION init flag
  *  - add fuse_uring_cmd_req commit.flags / FUSE_URING_COMMIT_RETAIN
  *  - add FUSE_HAS_SYNCFS opt-in flag for privileged userspace servers
+ *
+ *  sqz: several io_urings may serve one fuse-io-uring queue
+ *  - add FUSE_IO_URING_CMD_FEATURES and FUSE_URING_FEAT_RINGS_PER_QUEUE
  */
 
 #ifndef _LINUX_FUSE_H
@@ -1322,8 +1325,21 @@ enum fuse_uring_cmd {
 
 	/* release a COMMIT_RETAIN'd zero-copy write payload and re-arm */
 	FUSE_IO_URING_CMD_RELEASE_PAYLOAD = 3,
+
+	/*
+	 * what this kernel's fuse-io-uring can do: the CQE result is the
+	 * FUSE_URING_FEAT_* mask (a kernel without it answers -EINVAL)
+	 */
+	FUSE_IO_URING_CMD_FEATURES = 4,
 };
 
+/*
+ * FUSE_IO_URING_CMD_FEATURES result bits. RINGS_PER_QUEUE: several
+ * io_urings may REGISTER entries on one queue (each entry is served and
+ * committed by the ring that registered it; a ring still serves one queue).
+ */
+#define FUSE_URING_FEAT_RINGS_PER_QUEUE	(1 << 0)
+
 /* fuse_uring_cmd_req init flags */
 #define FUSE_URING_BUF_RING		(1 << 0)
 #define FUSE_URING_ZERO_COPY		(1 << 1)
diff --git a/fs/fuse/dev_uring.c b/fs/fuse/dev_uring.c
index 648d5c5..4023fbe 100644
--- a/fs/fuse/dev_uring.c
+++ b/fs/fuse/dev_uring.c
@@ -46,6 +46,8 @@ enum fuse_uring_header_type {
 	FUSE_URING_HEADER_RING_ENT,
 };
 
+static void fuse_uring_free_srcs(struct fuse_ring_queue *queue);
+
 static void uring_cmd_set_ring_ent(struct io_uring_cmd *cmd,
 				   struct fuse_ring_ent *ring_ent)
 {
@@ -355,6 +357,7 @@ void fuse_uring_destruct(struct fuse_chan *fch)
 			list_del_init(&ent->list);
 			kfree(ent);
 		}
+		fuse_uring_free_srcs(queue);
 
 		kfree(queue->fpq.processing);
 		kfree(queue);
@@ -415,54 +418,136 @@ void fuse_uring_conn_init(struct fuse_chan *fch)
 		fch->io_uring = 1;
 }
 
-static int fuse_uring_buf_ring_setup(struct io_uring_cmd *cmd,
-				     struct fuse_ring_queue *queue,
-				     bool zero_copy, bool retention,
-				     unsigned int issue_flags)
+/*
+ * The queue's buffer posture (bufring, zero copy, retention), decided by
+ * the first REGISTER; every later REGISTER must repeat it.
+ */
+static int fuse_uring_buf_mode_setup(struct fuse_ring_queue *queue,
+				     bool zero_copy, bool retention)
 {
-	int err;
-
-	err = io_uring_buf_ring_pin(cmd, FUSE_URING_RINGBUF_GROUP, issue_flags,
-				    &queue->bufring);
-	if (err)
-		return err;
-
-	err = -EINVAL;
-
-	if (!io_uring_is_kmbuf_ring(cmd, FUSE_URING_RINGBUF_GROUP, issue_flags))
-		goto error;
-
 	if (retention && !zero_copy)
-		goto error;
+		return -EINVAL;
 
 	if (zero_copy) {
-		const struct fuse_uring_cmd_req *cmd_req =
-			io_uring_sqe128_cmd(cmd->sqe,
-					    struct fuse_uring_cmd_req);
-
 		if (!capable(CAP_SYS_ADMIN))
-			goto error;
+			return -EINVAL;
 
 		queue->use_zero_copy = true;
-		queue->zero_copy_depth = READ_ONCE(cmd_req->init.queue_depth);
-		if (!queue->zero_copy_depth)
-			goto error;
 		queue->use_retention = retention;
 	}
 
 	queue->use_bufring = true;
 
 	return 0;
+}
 
-error:
+static struct fuse_ring_src *
+fuse_uring_src_find(struct fuse_ring_queue *queue, struct io_ring_ctx *ctx)
+	__must_hold(&queue->lock)
+{
+	struct fuse_ring_src *src;
+
+	list_for_each_entry(src, &queue->srcs, list)
+		if (src->ctx == ctx)
+			return src;
+	return NULL;
+}
+
+/*
+ * The source of a REGISTER's ring on this queue: the one already known for
+ * the cmd's ctx, else a new one pinning that ring's kmbuf payload ring. A
+ * ring that already serves another queue is refused (-EALREADY from the
+ * pin): one ring serves one queue, N rings may serve it.
+ */
+static struct fuse_ring_src *
+fuse_uring_src_get(struct io_uring_cmd *cmd, struct fuse_ring_queue *queue,
+		   unsigned int issue_flags)
+{
+	struct io_ring_ctx *ctx = cmd_to_io_kiocb(cmd)->ctx;
+	struct fuse_ring_src *src, *race;
+	int err;
+
+	spin_lock(&queue->lock);
+	src = fuse_uring_src_find(queue, ctx);
+	spin_unlock(&queue->lock);
+	if (src)
+		return src;
+
+	src = kzalloc_obj(*src, GFP_KERNEL_ACCOUNT);
+	if (!src)
+		return ERR_PTR(-ENOMEM);
+	INIT_LIST_HEAD(&src->list);
+	src->ctx = ctx;
+
+	err = io_uring_buf_ring_pin(cmd, FUSE_URING_RINGBUF_GROUP, issue_flags,
+				    &src->bufring);
+	if (err == -EALREADY) {
+		/*
+		 * Pinned by a REGISTER of this ring racing with us (io-wq
+		 * issue) or by another queue this ring serves (refused: a
+		 * ring serves one queue). The racer's insert is found on
+		 * the daemon's retry of a refused REGISTER.
+		 */
+		spin_lock(&queue->lock);
+		race = fuse_uring_src_find(queue, ctx);
+		spin_unlock(&queue->lock);
+		kfree(src);
+		return race ? race : ERR_PTR(err);
+	}
+	if (err)
+		goto free;
+
+	err = -EINVAL;
+	if (!io_uring_is_kmbuf_ring(cmd, FUSE_URING_RINGBUF_GROUP, issue_flags))
+		goto unpin;
+
+	if (queue->use_zero_copy) {
+		const struct fuse_uring_cmd_req *cmd_req =
+			io_uring_sqe128_cmd(cmd->sqe,
+					    struct fuse_uring_cmd_req);
+
+		src->zero_copy_depth = READ_ONCE(cmd_req->init.queue_depth);
+		if (!src->zero_copy_depth)
+			goto unpin;
+	}
+
+	spin_lock(&queue->lock);
+	race = fuse_uring_src_find(queue, ctx);
+	if (!race)
+		list_add_tail(&src->list, &queue->srcs);
+	spin_unlock(&queue->lock);
+	if (!race)
+		return src;
+
+	/* another REGISTER of this ring won the insert */
 	io_uring_buf_ring_unpin(cmd, FUSE_URING_RINGBUF_GROUP, issue_flags);
-	return err;
+	kfree(src);
+	return race;
+
+unpin:
+	io_uring_buf_ring_unpin(cmd, FUSE_URING_RINGBUF_GROUP, issue_flags);
+free:
+	kfree(src);
+	return ERR_PTR(err);
+}
+
+/*
+ * At ring destruction: the pinned buffer rings belong to their io_urings
+ * and go with them; only the bookkeeping is freed here.
+ */
+static void fuse_uring_free_srcs(struct fuse_ring_queue *queue)
+{
+	struct fuse_ring_src *src, *next;
+
+	list_for_each_entry_safe(src, next, &queue->srcs, list) {
+		list_del_init(&src->list);
+		kfree(src);
+	}
 }
 
 static struct fuse_ring_queue *
-fuse_uring_create_queue(struct io_uring_cmd *cmd, struct fuse_ring *ring,
-			int qid, bool use_bufring, bool zero_copy,
-			bool retention, unsigned int issue_flags)
+fuse_uring_create_queue(struct fuse_ring *ring, int qid, bool use_bufring,
+			bool zero_copy, bool retention)
 {
 	struct fuse_chan *fch = ring->chan;
 	struct fuse_ring_queue *queue;
@@ -491,13 +576,13 @@ fuse_uring_create_queue(struct io_uring_cmd *cmd, struct fuse_ring *ring,
 	INIT_LIST_HEAD(&queue->fuse_req_queue);
 	INIT_LIST_HEAD(&queue->fuse_req_bg_queue);
 	INIT_LIST_HEAD(&queue->ent_released);
+	INIT_LIST_HEAD(&queue->srcs);
 
 	fuse_pqueue_init(&queue->fpq);
 	queue->fpq.processing = pq;
 
 	if (use_bufring) {
-		err = fuse_uring_buf_ring_setup(cmd, queue, zero_copy,
-						retention, issue_flags);
+		err = fuse_uring_buf_mode_setup(queue, zero_copy, retention);
 		if (err)
 			goto cleanup;
 	} else if (zero_copy || retention) {
@@ -1173,7 +1258,7 @@ static int fuse_uring_select_buffer(struct fuse_ring_ent *ent,
 
 	/* Get a buffer to use for the payload */
 	sel = io_ring_buffer_select(cmd_to_io_kiocb(ent->cmd), &len,
-				    ent->queue->bufring, issue_flags);
+				    ent->src->bufring, issue_flags);
 	if (sel.val)
 		return sel.val;
 	if (!sel.kaddr)
@@ -1458,7 +1543,7 @@ static int fuse_uring_headers_prep(struct fuse_ring_ent *ent, unsigned int dir,
 	offset = ent->fixed_buf_id * header_size;
 
 	if (ent->queue->use_zero_copy)
-		headers_index += ent->queue->zero_copy_depth;
+		headers_index += ent->src->zero_copy_depth;
 
 	node = io_uring_fixed_index_get(cmd, headers_index, offset, header_size,
 					dir, &ent->headers_iter, issue_flags);
@@ -1521,6 +1606,16 @@ static int fuse_uring_commit_fetch(struct io_uring_cmd *cmd, int issue_flags,
 		return err;
 	}
 	ent = req->ring_entry;
+	/*
+	 * A bufring entry is committed by the ring that registered it: the
+	 * headers and zc tables indexed below and the buffer recycled at
+	 * the next fetch are that ring's (several rings may serve a queue).
+	 */
+	if (queue->use_bufring &&
+	    ent->src->ctx != cmd_to_io_kiocb(cmd)->ctx) {
+		spin_unlock(&queue->lock);
+		return -EXDEV;
+	}
 	retain = READ_ONCE(cmd_req->commit.flags) & FUSE_URING_COMMIT_RETAIN;
 	if (retain && (!queue->use_retention || !ent->zero_copied ||
 		       !ent->zc_dir_source)) {
@@ -1742,7 +1837,8 @@ static int fuse_uring_get_iovec_from_sqe(const struct io_uring_sqe *sqe,
 
 static struct fuse_ring_ent *
 fuse_uring_create_ring_ent(struct io_uring_cmd *cmd,
-			   struct fuse_ring_queue *queue)
+			   struct fuse_ring_queue *queue,
+			   unsigned int issue_flags)
 {
 	struct fuse_ring *ring = queue->ring;
 	struct fuse_ring_ent *ent;
@@ -1759,6 +1855,14 @@ fuse_uring_create_ring_ent(struct io_uring_cmd *cmd,
 	ent->queue = queue;
 
 	if (queue->use_bufring) {
+		struct fuse_ring_src *src;
+
+		src = fuse_uring_src_get(cmd, queue, issue_flags);
+		if (IS_ERR(src)) {
+			kfree(ent);
+			return ERR_CAST(src);
+		}
+		ent->src = src;
 		ent->fixed_buf_id = READ_ONCE(cmd->sqe->buf_index);
 		atomic_inc(&ring->queue_refs);
 		return ent;
@@ -1823,9 +1927,8 @@ static int fuse_uring_register(struct io_uring_cmd *cmd,
 
 	queue = READ_ONCE(ring->queues[qid]);
 	if (!queue) {
-		queue = fuse_uring_create_queue(cmd, ring, qid, use_bufring,
-						zero_copy, retention,
-						issue_flags);
+		queue = fuse_uring_create_queue(ring, qid, use_bufring,
+						zero_copy, retention);
 		if (IS_ERR(queue))
 			return PTR_ERR(queue);
 	} else {
@@ -1840,7 +1943,7 @@ static int fuse_uring_register(struct io_uring_cmd *cmd,
 	 * case of entry errors below, will be done at ring destruction time.
 	 */
 
-	ent = fuse_uring_create_ring_ent(cmd, queue);
+	ent = fuse_uring_create_ring_ent(cmd, queue, issue_flags);
 	if (IS_ERR(ent))
 		return PTR_ERR(ent);
 
@@ -1922,6 +2025,9 @@ int fuse_uring_cmd(struct io_uring_cmd *cmd, unsigned int issue_flags)
 		break;
 	case FUSE_IO_URING_CMD_RELEASE_PAYLOAD:
 		return fuse_uring_release_payload(cmd, issue_flags, fch);
+	case FUSE_IO_URING_CMD_FEATURES:
+		/* answered inline: the mask is the CQE result */
+		return FUSE_URING_FEAT_RINGS_PER_QUEUE;
 	default:
 		return -EINVAL;
 	}
diff --git a/fs/fuse/dev_uring_i.h b/fs/fuse/dev_uring_i.h
index 001d837..c6275a6 100644
--- a/fs/fuse/dev_uring_i.h
+++ b/fs/fuse/dev_uring_i.h
@@ -44,6 +44,24 @@ enum fuse_ring_req_state {
 	FRRS_RELEASED,
 };
 
+/*
+ * One io_uring that registered entries on a queue. Several rings may serve
+ * one queue (sqz: N daemon workers per kernel queue); what a request's
+ * payload is selected from and recycled to must be the ENTRY's ring's
+ * kmbuf buffer ring, because the recycle resolves the buffer group in the
+ * committing cmd's ctx (io_uring_kmbuf_recycle) and the zc headers index
+ * is laid out by that ring's own queue depth.
+ */
+struct fuse_ring_src {
+	/* queue->srcs, under queue->lock */
+	struct list_head list;
+	struct io_ring_ctx *ctx;
+	/* the pinned kmbuf payload ring of ctx (queue->use_bufring) */
+	struct io_buffer_list *bufring;
+	/* FUSE_URING_ZERO_COPY: this ring's sparse fixed-table depth */
+	unsigned int zero_copy_depth;
+};
+
 /** A fuse ring entry, part of the ring queue */
 struct fuse_ring_ent {
 	union {
@@ -64,6 +82,8 @@ struct fuse_ring_ent {
 			 */
 			unsigned int ringbuf_buf_id;
 			unsigned int fixed_buf_id;
+			/* the ring this entry was registered from */
+			struct fuse_ring_src *src;
 
 			/* True if the request's pages are being zero-copied */
 			bool zero_copied;
@@ -157,8 +177,11 @@ struct fuse_ring_queue {
 	/* true if kernel-managed buffer ring is used */
 	bool use_bufring: 1;
 
-	/* synchronized by the queue lock */
-	struct io_buffer_list *bufring;
+	/*
+	 * The io_urings that registered entries here (struct fuse_ring_src),
+	 * one per ring ctx; synchronized by the queue lock
+	 */
+	struct list_head srcs;
 
 	/*
 	 * True if zero copy should be used for payloads. This is only enabled
@@ -168,7 +191,6 @@ struct fuse_ring_queue {
 	bool use_zero_copy : 1;
 	/* FUSE_URING_PAYLOAD_RETENTION: COMMIT may keep the zc slot */
 	bool use_retention : 1;
-	unsigned int zero_copy_depth;
 };
 

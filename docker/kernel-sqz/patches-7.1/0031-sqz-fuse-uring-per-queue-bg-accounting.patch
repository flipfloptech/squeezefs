+ * re-gate every queue against its new share.  A shrink closes gates that
+ * are now over budget - they re-open as their requests end, nothing is
+ * evicted and nothing underflows because only charged requests are ever
+ * credited.  A grow opens gates and hands one slot on per queue.  Runs
+ * outside fc->bg_lock: queue->lock never nests inside it.
+ */
+void fuse_uring_bg_limit_changed(struct fuse_conn *fc)
+{
+	struct fuse_ring *ring = smp_load_acquire(&fc->ring);
+	int qid;
+
+	if (!ring)
+		return;
+
+	for (qid = 0; qid < ring->nr_queues; qid++) {
+		struct fuse_ring_queue *queue = READ_ONCE(ring->queues[qid]);
+
+		if (!queue)
+			continue;
+
+		spin_lock(&queue->lock);
+		WRITE_ONCE(queue->bg_blocked,
+			   queue->num_background >= fuse_uring_bg_max(queue));
+		if (!queue->bg_blocked)
+			wake_up(&queue->bg_waitq);
+		spin_unlock(&queue->lock);
+	}

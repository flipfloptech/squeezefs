@@ -107,6 +117,9 @@ struct fuse_ring_queue {
 	/* entries in userspace */
 	struct list_head ent_in_userspace;
 
+	/* COMMIT_RETAIN'd ents waiting for RELEASE_PAYLOAD */
+	struct list_head ent_retained;
+
 	/* entries that are released */
 	struct list_head ent_released;
 
@@ -134,6 +147,8 @@ struct fuse_ring_queue {
 	 * in order to use zero copy.
 	 */
 	bool use_zero_copy : 1;
+	/* FUSE_URING_PAYLOAD_RETENTION: COMMIT may keep the zc slot */
+	bool use_retention : 1;
 	unsigned int zero_copy_depth;
 };
 
diff --git a/include/uapi/linux/fuse.h b/include/uapi/linux/fuse.h
index 08d2af942..b9d27c536 100644
--- a/include/uapi/linux/fuse.h
+++ b/include/uapi/linux/fuse.h

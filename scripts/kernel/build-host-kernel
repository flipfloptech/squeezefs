#!/usr/bin/env bash
# build-host-kernel — build the sqz kernel natively on a Linux HOST — one reached over
# ssh, or this one (--local) — as the host's distro packages, and install it.
#
#   scripts/kernel/build-host-kernel <ssh-host>               # build + install (no reboot)
#   scripts/kernel/build-host-kernel <ssh-host> --no-install  # build the packages only
#   scripts/kernel/build-host-kernel <ssh-host> --status      # tail the remote build log
#   scripts/kernel/build-host-kernel --local [--no-install | --status | --prepare-only]
#
# The build runs in the background under nohup in $SQZ_BUILD_ROOT/kernel (default
# /build/kernel) on the target; its log is build.log there. Nothing here reboots:
# the new kernel runs after the reboot whoever owns the host schedules.
#
# --no-install stops after the packages: the log ends with their absolute paths and the
# line that installs them, for whoever coordinates the host's reboot (a package manager
# replaces the running kernel's /lib/modules/<ver> when the version string is the same,
# so install and reboot together).
#
# The series: scripts/kernel/patches-7.2 — 0001–0026 copied from the Rust reference's
# docker/kernel-sqz/patches-7.2 (dev 48e1c9b2; Koong's kmbuf + FUSE zero-copy v4, the sqz
# transplants, FUSE_TIME_LIMITS, host-scoped fabric subsystems, per-queue bg accounting)
# and this repo's 0027–0030 — with scripts/kernel/config-fragment, asserted as a checklist
# (fail loud). Two package families, chosen by the target's /etc/os-release:
#
# Debian/Ubuntu: linux 7.2.8 from kernel.org + the series, as .debs (bindeb-pkg). The
#   config: the host's OWN running config (its drivers: root on LVM, its NIC, its NVMe),
#   trimmed by `localmodconfig` to the modules loaded at build time — after loading every
#   module the sqz work needs, so they survive the trim — then the fragment. A full distro
#   config builds ~6,000 modules (hours on a laptop CPU); the trim keeps the hardware the
#   box has. dpkg installs the .debs and the distro's hooks build the initramfs and update
#   GRUB (the newest version sorts first, so the sqz kernel becomes the default entry; the
#   distro kernel stays in the menu as the fallback). uname -r: 7.2.8-sqz.
#
# Arch and derivatives (Omarchy; owner ruling 2026-10-16): the sqz kernel TRACKS Omarchy's
#   current linux-omarchy (linux-omarchy-bore until 2026-10-19) — its base, all its patches and its config — fetched from
#   omacom/omarchy-pkgs at build time; the series and the fragment are appended to that
#   PKGBUILD as pkgbase linux-omarchy-sqz, built with makepkg (the full Omarchy config:
#   ~30 min on 32 threads) and installed with pacman -U, which fires the mkinitcpio/Limine
#   hooks (the UKI, the boot entry); a limine-entry-tool drop-in puts the sqz kernel first
#   in BOOT_ORDER, the stock kernel stays as the fallback. The sqz tag comes from the
#   pkgbase (uname -r: 7.2.x-N.S-omarchy-sqz — N Omarchy's pkgrel, S the series' last patch
#   number, so a rebuilt kernel is distinguishable from the running one and names its series),
#   so the fragment's CONFIG_LOCALVERSION lines are skipped. --prepare-only runs makepkg -o in the foreground — download, signatures, every
#   patch at --fuzz=0, the config and its checklist, no compile — the pass to run first after
#   an Omarchy bump, to see conflicts in minutes rather than after a build.
set -euo pipefail

HOST=${1:?usage: build-host-kernel <ssh-host> | --local [--no-install | --status | --prepare-only]}
[ "$HOST" = --local ] && HOST=
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
SSH=(ssh -o BatchMode=yes -o LogLevel=ERROR)
ROOT=${SQZ_BUILD_ROOT:-/build}
RDIR=$ROOT/kernel
# A shell command on the target: over ssh, or here.
on() { if [ -n "$HOST" ]; then "${SSH[@]}" "$HOST" "$1"; else bash -c "$1"; fi; }
at() { echo "${HOST:+$HOST:}$1"; }
WHERE=${HOST:-this host}

INSTALL=1
STAGE=build
case "${2:-}" in
  --status) on "tail -5 $RDIR/build.log; ls $RDIR/*.deb $RDIR/*.pkg.tar.zst 2>/dev/null"; exit ;;
  --no-install) INSTALL=0 ;;
  --prepare-only) STAGE=prepare ;;
  '') ;;
  *) echo "build-host-kernel: unknown option '$2' (--no-install | --status | --prepare-only)" >&2; exit 2 ;;
esac

# The target's package family (Omarchy says ID=omarchy ID_LIKE=arch).
case " $(on '. /etc/os-release; echo "$ID ${ID_LIKE:-}"') " in
  *" arch "*) FAMILY=arch ;;
  *) FAMILY=deb ;;
esac
[ "$STAGE" = prepare ] && [ "$FAMILY" != arch ] && { echo "build-host-kernel: --prepare-only is the PKGBUILD family's dry pass; $WHERE builds .debs" >&2; exit 2; }

# The series and the fragment, assembled on this side.
stage=$(mktemp -d "${TMPDIR:-/tmp}/sqz-hostkernel.XXXXXX")
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/patches"
cp "$REPO"/scripts/kernel/patches-7.2/*.patch "$stage/patches/"
cp "$REPO/scripts/kernel/config-fragment" "$stage/fragment"
echo "series: $(ls "$stage/patches" | wc -l) patches; fragment: $(grep -c '^CONFIG_' "$stage/fragment") entries; target: $WHERE ($FAMILY)"

on "sudo mkdir -p $RDIR && sudo chown \$(id -un) $RDIR"
rsync -a --delete -e "${SSH[*]}" "$stage/patches/" "$(at "$RDIR/patches/")"
rsync -a -e "${SSH[*]}" "$stage/fragment" "$(at "$RDIR/fragment")"

# The target's half (runs under nohup; its log is $RDIR/build.log).
if [ "$FAMILY" = deb ]; then
on "cat > $RDIR/build.sh" <<'REMOTE'
#!/usr/bin/env bash
set -euo pipefail
# A failed step says so in the log (set -e alone exits silently).
trap 'echo "BUILD FAILED at line $LINENO: $BASH_COMMAND"' ERR
cd "$(dirname "$0")"
# bindeb-pkg's build dependencies (dpkg-checkbuilddeps refuses without libdw-dev, etc.).
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq build-essential flex bison bc cpio \
  dwarves libelf-dev libdw-dev libssl-dev zstd rsync debhelper-compat >/dev/null
# The base the series in scripts/kernel/patches-7.2 is refreshed against (the one
# Omarchy's current recipe builds: both packagings build one kernel).
KVER=7.2.8
TARBALL=linux-$KVER.tar.xz
[ -f "$TARBALL" ] || curl -fsSL -o "$TARBALL" "https://cdn.kernel.org/pub/linux/kernel/v7.x/$TARBALL"
rm -rf "linux-$KVER" && tar xf "$TARBALL" && cd "linux-$KVER"
echo "== series"
for p in ../patches/*.patch; do echo "  $(basename "$p")"; patch -p1 --fuzz=0 --silent < "$p"; done
echo "== config: the running config, localmodconfig after loading the sqz modules, the fragment"
for m in fuse nvmet nvmet-tcp nvme-loop nvme-tcp nvme-fabrics tls null_blk zram brd loop; do sudo modprobe "$m" 2>/dev/null || true; done
cp "/boot/config-$(uname -r)" .config
# The distro's trusted-key paths name files of its own source tree.
scripts/config --set-str SYSTEM_TRUSTED_KEYS "" --set-str SYSTEM_REVOCATION_KEYS "" --set-str MODULE_SIG_KEY "certs/signing_key.pem"
make olddefconfig >/dev/null
lsmod > ../lsmod.txt
# Answers every new symbol's prompt with its default. (Not `yes '' | make …`: under
# pipefail the SIGPIPE that ends `yes` fails the pipeline and set -e ends the build —
# silently, as on 2026-10-14.)
make LSMOD=../lsmod.txt localmodconfig < <(yes '') > ../localmodconfig.log 2>&1
while IFS= read -r line; do
  case "$line" in
    ''|'#'*) continue ;;
    CONFIG_*=n) scripts/config -d "${line%%=*}" ;;
    CONFIG_*='"'*'"') opt=${line%%=*}; val=${line#*=}; scripts/config --set-str "$opt" "${val//\"/}" ;;
    CONFIG_*=m) scripts/config -m "${line%%=*}" ;;
    CONFIG_*=y) scripts/config -e "${line%%=*}" ;;
  esac
done < ../fragment
make olddefconfig >/dev/null
fail=0
while IFS= read -r line; do
  case "$line" in
    ''|'#'*) continue ;;
    CONFIG_LOCALVERSION_AUTO=n) want='# CONFIG_LOCALVERSION_AUTO is not set' ;;
    *) want="$line" ;;
  esac
  grep -qxF "$want" .config || { echo "MISSING from final .config: $want"; fail=1; }
done < ../fragment
[ "$fail" = 0 ] || { echo "config checklist FAILED"; exit 1; }
echo "checklist OK; modules: $(grep -c '=m$' .config)"
# On a venue box (scripts/venue's locks under the build root) the whole-box make holds
# the gate lock and every build slot, as a full gate does, so it never runs beside one.
root=${SQZ_BUILD_ROOT:-/build}
locks=()
if [ -e "$root/.gate.lock" ]; then
  locks=(flock -o "$root/.gate.lock")
  for s in "$root"/.build-slot.*; do [ -e "$s" ] && locks+=(flock -o "$s"); done
  flock -o -n "$root/.gate.lock" true || echo "== waiting for the venue's gate lock and build slots $(date)"
fi
"${locks[@]}" bash -c 'echo "== build ($(nproc) jobs) $(date)"; make -j"$(nproc)" bindeb-pkg LOCALVERSION= >../make.log 2>&1' \
  || { tail -30 ../make.log; exit 1; }
echo "== built $(date)"
image=$(readlink -f ../linux-image-${KVER}-sqz_*.deb)
headers=$(readlink -f ../linux-headers-${KVER}-sqz_*.deb)
echo "$image"; echo "$headers"
if [ "$(uname -r)" = "${KVER}-sqz" ]; then
  echo "== NOTE: this host runs ${KVER}-sqz now: installing replaces the running kernel's /lib/modules — install and reboot together"
fi
if [ "${INSTALL:-1}" = 0 ]; then
  echo "== not installed (--no-install); install, then reboot: sudo dpkg -i $image $headers"
  echo "BUILD-OK"
  exit 0
fi
echo "== install"
sudo dpkg -i "$image" "$headers"
echo "== GRUB default entry:"; sudo grep -m1 -E "^\s*menuentry " /boot/grub/grub.cfg | cut -c1-120
echo "== installed; REBOOT this host into ${KVER}-sqz to run it (nothing here reboots), then check: uname -r; cat /sys/module/fuse/parameters/enable_uring"
echo "BUILD-AND-INSTALL-OK"
REMOTE
else
on "cat > $RDIR/build.sh" <<'REMOTE'
#!/usr/bin/env bash
set -euo pipefail
# A failed step says so in the log (set -e alone exits silently).
trap 'echo "BUILD FAILED at line $LINENO: $BASH_COMMAND"' ERR
cd "$(dirname "$0")"
# The distro's toolchain only: a version manager's rustc or gcc on the caller's PATH
# (mise shims) would be picked over the makedepends makepkg installs.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
PKGBASE=linux-omarchy-sqz
# Omarchy's kernel recipe: linux-omarchy-bore until 2026-10-19 (omarchy-pkgs 403eae6 folded the
# BORE build into linux-omarchy itself; -bore is a transitional shim with no prepare()).
UPSTREAM=linux-omarchy
# makepkg caches the kernel tarball here across rebuilds and drops the packages beside the log.
export SRCDEST=$PWD/sources PKGDEST=$PWD
mkdir -p "$SRCDEST"
echo "== the current recipe: omacom/omarchy-pkgs pkgbuilds/$UPSTREAM"
rm -rf omarchy-pkgs
git clone -q --depth 1 --filter=blob:none --sparse https://github.com/omacom/omarchy-pkgs.git omarchy-pkgs
git -C omarchy-pkgs sparse-checkout set "pkgbuilds/$UPSTREAM" >/dev/null
up=omarchy-pkgs/pkgbuilds/$UPSTREAM
echo "  omarchy-pkgs $(git -C omarchy-pkgs rev-parse --short HEAD) ($(git -C omarchy-pkgs log -1 --format=%cs)): $(grep -m1 '^pkgver=' "$up/PKGBUILD") $(grep -m1 '^pkgrel=' "$up/PKGBUILD"), $(ls "$up"/*.patch | wc -l) Omarchy patches"
echo "== the derived package: $PKGBASE = $UPSTREAM + the sqz series + the fragment"
rm -rf "$PKGBASE" && cp -a "$up" "$PKGBASE" && cd "$PKGBASE"
grep -qx "pkgbase=$UPSTREAM" PKGBUILD || { echo "PKGBUILD has no 'pkgbase=$UPSTREAM' line — the recipe changed shape; read it"; exit 1; }
grep -q '^prepare()' PKGBUILD || { echo "PKGBUILD has no prepare() — the recipe changed shape; read it"; exit 1; }
sed -i "s/^pkgbase=$UPSTREAM\$/pkgbase=$PKGBASE/" PKGBUILD
# Our files beside Omarchy's, sqz- prefixed (its patches are 0010–0999 too). Omarchy's own
# prepare() applies every *.patch in source order at --fuzz=0, so the series rides that loop
# after Omarchy's patches; the fragment is not a patch and is applied by the prepare() below.
for p in ../patches/*.patch; do cp "$p" "sqz-$(basename "$p")"; done
# pkgrel N.S: Omarchy's N plus the series' last patch number S, so uname -r names the series and
# a rebuild of the same Omarchy base is never the running kernel's version string.
series=$(basename "$(ls ../patches/*.patch | sort | tail -1)" | cut -c1-4 | sed 's/^0*//')
sed -i "s/^pkgrel=\([0-9]*\)\$/pkgrel=\1.$series/" PKGBUILD
grep -q "^pkgrel=[0-9]*\.$series\$" PKGBUILD || { echo "pkgrel rewrite failed; read the PKGBUILD"; exit 1; }
cp ../fragment sqz-config-fragment
{
  echo
  echo "# --- squeezefs (scripts/kernel/build-host-kernel): the sqz series and its config fragment ---"
  echo "pkgdesc=\"\$pkgdesc + the squeezefs kernel series (sqz)\""
  echo "source+=("; for f in sqz-*.patch sqz-config-fragment; do echo "  $f"; done; echo ")"
  # Every checksum array the recipe carries must match the source array's length.
  for algo in b2 sha256 sha512 md5; do
    grep -q "^${algo}sums=(" PKGBUILD || continue
    echo "${algo}sums+=("; for f in sqz-*.patch sqz-config-fragment; do echo "  '$("${algo}sum" "$f" | cut -d' ' -f1)'"; done; echo ")"
  done
  # Omarchy's prepare() under another name, then ours runs it and adds the fragment.
  echo 'eval "_omarchy_prepare() $(declare -f prepare | sed 1d)"'
  cat <<'PREPARE'
prepare() {
  _omarchy_prepare
  cd "$srcdir/$_srcname"
  # The sqz tag comes from the pkgbase (localversion.20-pkgname → -omarchy-sqz): the
  # fragment's CONFIG_LOCALVERSION lines would double it, so they are skipped here and below.
  echo "Applying the sqz config fragment..."
  local line opt val
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*|CONFIG_LOCALVERSION=*|CONFIG_LOCALVERSION_AUTO=*) continue ;;
      CONFIG_*=n) scripts/config -d "${line%%=*}" ;;
      CONFIG_*='"'*'"') opt=${line%%=*}; val=${line#*=}; scripts/config --set-str "$opt" "${val//\"/}" ;;
      CONFIG_*=m) scripts/config -m "${line%%=*}" ;;
      CONFIG_*=y) scripts/config -e "${line%%=*}" ;;
    esac
  done < ../sqz-config-fragment
  make olddefconfig
  local fail=0 want
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*|CONFIG_LOCALVERSION=*|CONFIG_LOCALVERSION_AUTO=*) continue ;;
      CONFIG_*=n) want="# ${line%%=*} is not set" ;;
      *) want="$line" ;;
    esac
    grep -qxF "$want" .config || { echo "MISSING from final .config: $want"; fail=1; }
  done < ../sqz-config-fragment
  [[ $fail = 0 ]] || { echo "sqz config checklist FAILED"; exit 1; }
  echo "sqz checklist OK; modules: $(grep -c '=m$' .config)"
  make -s kernelrelease > version
  echo "Prepared $pkgbase version $(<version)"
}
PREPARE
} >> PKGBUILD
# The signing keys the recipe ships (Torvalds, Kroah-Hartman, Omarchy's kernel maintainer).
gpg --quiet --import keys/pgp/*.asc 2>/dev/null || true
if [ "${STAGE:-build}" = prepare ]; then
  echo "== prepare only: sources, signatures, every patch at --fuzz=0, the config and its checklist $(date)"
  # -s here too: olddefconfig keeps CONFIG_RUST only with rustc present, so the dry pass
  # configures what the build will.
  makepkg -o -s --noconfirm
  echo "== prepared: $(cat src/linux-*/version) — no package built (--prepare-only)"
  echo "PREPARE-OK"
  exit 0
fi
# On a venue box (scripts/venue's locks under the build root) the whole-box make holds
# the gate lock and every build slot, as a full gate does, so it never runs beside one.
root=${SQZ_BUILD_ROOT:-/build}
locks=()
if [ -e "$root/.gate.lock" ]; then
  locks=(flock -o "$root/.gate.lock")
  for s in "$root"/.build-slot.*; do [ -e "$s" ] && locks+=(flock -o "$s"); done
  flock -o -n "$root/.gate.lock" true || echo "== waiting for the venue's gate lock and build slots $(date)"
fi
# -s: pacman installs the PKGBUILD's makedepends (rust, pahole, …) through sudo.
"${locks[@]}" bash -c 'echo "== build ($(nproc) jobs) $(date)"; makepkg -s --noconfirm >../make.log 2>&1' \
  || { tail -30 ../make.log; exit 1; }
echo "== built $(date)"
ver=$(cat src/linux-*/version)
pkgver=$(grep -m1 '^pkgver=' PKGBUILD | cut -d= -f2)-$(grep -m1 '^pkgrel=' PKGBUILD | cut -d= -f2)
image=$(readlink -e "../$PKGBASE-$pkgver-$(uname -m).pkg.tar.zst")
headers=$(readlink -e "../$PKGBASE-headers-$pkgver-$(uname -m).pkg.tar.zst")
echo "$image"; echo "$headers"
if [ "$(uname -r)" = "$ver" ]; then
  echo "== NOTE: this host runs $ver now: installing replaces the running kernel's /usr/lib/modules — install and reboot together"
fi
if [ "${INSTALL:-1}" = 0 ]; then
  echo "== not installed (--no-install); install, then reboot: sudo pacman -U $image $headers"
  echo "BUILD-OK"
  exit 0
fi
echo "== install"
# The sqz kernel first in Limine's BOOT_ORDER, Omarchy's own order after it (the stock kernel
# is the fallback); written before pacman -U so the hook's limine-update applies it at once.
if [ -d /etc/limine-entry-tool.d ]; then
  printf '%s\n' "# squeezefs venue kernel (scripts/kernel/build-host-kernel): the sqz kernel boots by default" \
    "BOOT_ORDER=\"$PKGBASE, linux-t2, linux-omarchy, linux-omarchy-*, *, *fallback, Snapshots\"" \
    | sudo tee /etc/limine-entry-tool.d/sqz-kernel.conf >/dev/null
fi
sudo pacman -U --noconfirm "$image" "$headers"
if sudo test -f /boot/limine.conf; then
  echo "== Limine entries:"; sudo grep -E '^\s*//[^/]|^default_entry' /boot/limine.conf | head -8
fi
echo "== installed; REBOOT this host into $ver to run it (nothing here reboots), then check: uname -r; cat /sys/module/fuse/parameters/enable_uring"
echo "BUILD-AND-INSTALL-OK"
REMOTE
fi

if [ "$STAGE" = prepare ]; then
  on "set -o pipefail; chmod +x $RDIR/build.sh && cd $RDIR && STAGE=prepare SQZ_BUILD_ROOT=$ROOT ./build.sh 2>&1 | tee prepare.log"
  exit
fi
# Background the build alone: a backgrounded and-list is a subshell holding ssh's
# streams, and ssh waited out the whole build.
on "chmod +x $RDIR/build.sh && cd $RDIR && { INSTALL=$INSTALL SQZ_BUILD_ROOT=$ROOT nohup ./build.sh > build.log 2>&1 < /dev/null & } && echo started"
echo "build started on $WHERE — follow with: scripts/kernel/build-host-kernel ${HOST:---local} --status (log $RDIR/build.log; the host needs a reboot after the install)"

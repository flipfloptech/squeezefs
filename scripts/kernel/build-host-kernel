#!/usr/bin/env bash
# build-host-kernel — build the squeezefs venue kernel natively on a Linux HOST — one reached
# over ssh, or this one (--local) — as the host's distro packages, and install it.
#
#   scripts/kernel/build-host-kernel <ssh-host>                # build + install (no reboot)
#   scripts/kernel/build-host-kernel <ssh-host> --no-install   # build the packages only
#   scripts/kernel/build-host-kernel <ssh-host> --status       # tail the remote build log
#   scripts/kernel/build-host-kernel --local [--no-install | --status | --prepare-only]
#
# The product needs Linux >= 7.3 with FUSE-over-io_uring buffer pools (owner ruling 2026-10-29)
# and the venue carries NO kernel patch (owner ruling 2026-11-02: no kernel patches, no fork;
# decision 0003 §DB, docs/evidence/rung-10-stock-kernel.md); any such kernel serves, and this
# script builds the venue's own: kernel.org linux $KVER, UNPATCHED (the tarball, checked by its
# signature), configured with scripts/kernel/config-fragment, asserted as a checklist (fail
# loud). A config is not a patch: the fragment only enables in-tree options.
#
# The build runs in the background under nohup in $SQZ_BUILD_ROOT/kernel/mainline (default
# /build/kernel/mainline) on the target; its log is build.log there. Nothing here reboots:
# the new kernel runs after the reboot whoever owns the host schedules.
#
# --no-install stops after the packages: the log ends with their absolute paths and the
# line that installs them, for whoever coordinates the host's reboot (a package manager
# replaces the running kernel's /lib/modules/<ver> when the version string is the same,
# so install and reboot together).
#
# Arch and derivatives (Omarchy) only: pkgbase linux-mainline-sqz (the name the Limine
#   BOOT_ORDER drop-in and scripts/dev/provision-local-venue know), Omarchy's CURRENT
#   config.x86_64 (fetched from omacom/omarchy-pkgs at build time) as the seed (`make
#   olddefconfig`, then the fragment and its checklist), none of Omarchy's patches (they are
#   for its own base), its PKGBUILD's build/package functions verbatim; built with makepkg and
#   installed with pacman -U, which fires the mkinitcpio/Limine hooks (the UKI, the boot entry).
#   pkgrel 1 (uname -r: $KVER-1-mainline-sqz); bump it when a rebuild of the same $KVER must
#   be told from the running one. A limine-entry-tool drop-in puts it FIRST in BOOT_ORDER; the
#   distro kernel stays the fallback entry (the daemon refuses a kernel without buffer pools).
#   --prepare-only runs makepkg -o in the foreground — download, signature, the config and its
#   checklist, no compile — to see a config gap in minutes rather than after a build. A
#   Debian/Ubuntu host runs a distro or kernel.org >= 7.3 kernel (scripts/dev/provision-local-venue
#   checks it).
set -euo pipefail

HOST=${1:?usage: build-host-kernel <ssh-host> | --local [--no-install | --status | --prepare-only]}
[ "$HOST" = --local ] && HOST=
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
SSH=(ssh -o BatchMode=yes -o LogLevel=ERROR)
ROOT=${SQZ_BUILD_ROOT:-/build}
RDIR=$ROOT/kernel/mainline
# The kernel.org release the venue runs (the latest stable; a bump is this line and a rebuild).
KVER=7.3.1
# A shell command on the target: over ssh, or here.
on() { if [ -n "$HOST" ]; then "${SSH[@]}" "$HOST" "$1"; else bash -c "$1"; fi; }
at() { echo "${HOST:+$HOST:}$1"; }
WHERE=${HOST:-this host}

INSTALL=1
STAGE=build
shift
case "${1:-}" in
  --status) on "tail -5 $RDIR/build.log; ls $RDIR/*.pkg.tar.zst 2>/dev/null"; exit ;;
  --no-install) INSTALL=0 ;;
  --prepare-only) STAGE=prepare ;;
  '') ;;
  *) echo "build-host-kernel: unknown option '$1' (--no-install | --status | --prepare-only)" >&2; exit 2 ;;
esac

# The target's package family (Omarchy says ID=omarchy ID_LIKE=arch).
case " $(on '. /etc/os-release; echo "$ID ${ID_LIKE:-}"') " in
  *" arch "*) ;;
  *) echo "build-host-kernel: $WHERE is not Arch-family: the venue kernel packages for Arch/Omarchy only — run a distro or kernel.org Linux >= 7.3 there" >&2; exit 2 ;;
esac

echo "kernel.org linux $KVER, no patch; fragment: $(grep -c '^CONFIG_' "$REPO/scripts/kernel/config-fragment") entries; target: $WHERE"

on "sudo mkdir -p $RDIR && sudo chown \$(id -un) $RDIR && rm -rf $RDIR/patches"
rsync -a -e "${SSH[*]}" "$REPO/scripts/kernel/config-fragment" "$(at "$RDIR/fragment")"

# The target's half (runs under nohup; its log is $RDIR/build.log).
on "cat > $RDIR/build.sh" <<'REMOTE'
#!/usr/bin/env bash
set -euo pipefail
# A failed step says so in the log (set -e alone exits silently).
trap 'echo "BUILD FAILED at line $LINENO: $BASH_COMMAND"' ERR
cd "$(dirname "$0")"
# The distro's toolchain only: a version manager's rustc or gcc on the caller's PATH
# (mise shims) would be picked over the makedepends makepkg installs.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
# Omarchy's kernel recipe: the seed config and the build/package functions.
UPSTREAM=linux-omarchy
# makepkg caches the kernel tarball here across rebuilds and drops the packages beside the log.
export SRCDEST=$PWD/sources PKGDEST=$PWD
mkdir -p "$SRCDEST"
echo "== the current recipe: omacom/omarchy-pkgs pkgbuilds/$UPSTREAM"
rm -rf omarchy-pkgs
git clone -q --depth 1 --filter=blob:none --sparse https://github.com/omacom/omarchy-pkgs.git omarchy-pkgs
git -C omarchy-pkgs sparse-checkout set "pkgbuilds/$UPSTREAM" >/dev/null
up=$PWD/omarchy-pkgs/pkgbuilds/$UPSTREAM
omarchy_rev=$(git -C omarchy-pkgs rev-parse --short HEAD)
echo "  omarchy-pkgs $omarchy_rev ($(git -C omarchy-pkgs log -1 --format=%cs)): $(grep -m1 '^pkgver=' "$up/PKGBUILD") $(grep -m1 '^pkgrel=' "$up/PKGBUILD"), $(ls "$up"/*.patch | wc -l) Omarchy patches"
grep -q '^prepare()' "$up/PKGBUILD" || { echo "PKGBUILD has no prepare() — the recipe changed shape; read it"; exit 1; }
PKGBASE=linux-mainline-sqz
KVER=${KVER:?}
echo "== the derived package: $PKGBASE = kernel.org linux $KVER, unpatched, + the venue's config fragment; Omarchy's config as the seed, its build/package functions, none of its patches"
rm -rf "$PKGBASE" && mkdir "$PKGBASE" && cd "$PKGBASE"
cp -a "$up/keys" . && cp "$up/config.x86_64" .
cp ../fragment sqz-config-fragment
{
  echo "# linux-mainline-sqz (scripts/kernel/build-host-kernel): kernel.org linux $KVER, no patch,"
  echo "# configured with the venue's fragment (scripts/kernel/config-fragment); Omarchy's PKGBUILD"
  echo "# ($omarchy_rev) lends its config as the seed and its build/package functions."
  echo "pkgbase=$PKGBASE"
  echo "pkgver=$KVER"
  echo "pkgrel=1"
  echo "pkgdesc='Linux (kernel.org, unpatched) with the squeezefs venue config fragment (sqz)'"
  echo "url='https://kernel.org'"
  echo "arch=(x86_64)"
  echo "license=(GPL-2.0-only)"
  sed -n '/^makedepends=(/,/^)/p' "$up/PKGBUILD"
  echo "options=(!debug !strip)"
  echo '_major=${pkgver%%.*}'
  echo '_srcname=linux-$pkgver'
  echo "source=("
  echo '  https://cdn.kernel.org/pub/linux/kernel/v${_major}.x/${_srcname}.tar.{xz,sign}'
  echo "  sqz-config-fragment"
  echo ")"
  echo "source_x86_64=(config.x86_64)"
  sed -n '/^validpgpkeys=(/,/^)/p' "$up/PKGBUILD"
  # The tarball is checked by its signature (the keys above); the files beside the PKGBUILD by hash.
  echo "b2sums=('SKIP' 'SKIP' '$(b2sum sqz-config-fragment | cut -d' ' -f1)')"
  echo "b2sums_x86_64=('$(b2sum config.x86_64 | cut -d' ' -f1)')"
  echo
  # Omarchy's exports, prepare(), build(), _package(), _package-headers() and the pkgname loop.
  sed -n '/^export KBUILD_BUILD_HOST/,$p' "$up/PKGBUILD" | sed 's/^export KBUILD_BUILD_HOST=.*/export KBUILD_BUILD_HOST=sqz/'
} > PKGBUILD
grep -q '^prepare()' PKGBUILD && grep -q '^_package-headers()' PKGBUILD || { echo "the derived PKGBUILD lacks prepare()/_package-headers(); read Omarchy's"; exit 1; }
{
  # Omarchy's prepare() under another name, then ours runs it and adds the fragment.
  echo 'eval "_omarchy_prepare() $(declare -f prepare | sed 1d)"'
  cat <<'PREPARE'
prepare() {
  _omarchy_prepare
  cd "$srcdir/$_srcname"
  # The sqz tag comes from the pkgbase (localversion.20-pkgname → -mainline-sqz).
  echo "Applying the sqz config fragment..."
  local line opt val
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*) continue ;;
      CONFIG_*=n) scripts/config -d "${line%%=*}" ;;
      CONFIG_*='"'*'"') opt=${line%%=*}; val=${line#*=}; scripts/config --set-str "$opt" "${val//\"/}" ;;
      CONFIG_*=m) scripts/config -m "${line%%=*}" ;;
      CONFIG_*=y) scripts/config -e "${line%%=*}" ;;
    esac
  done < ../sqz-config-fragment
  make olddefconfig
  local fail=0 want
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*) continue ;;
      CONFIG_*=n) want="# ${line%%=*} is not set" ;;
      *) want="$line" ;;
    esac
    grep -qxF "$want" .config || { echo "MISSING from final .config: $want"; fail=1; }
  done < ../sqz-config-fragment
  [[ $fail = 0 ]] || { echo "sqz config checklist FAILED"; exit 1; }
  echo "sqz checklist OK; modules: $(grep -c '=m$' .config)"
  make -s kernelrelease > version
  echo "Prepared $pkgbase version $(<version)"
}
PREPARE
} >> PKGBUILD
# The signing keys the recipe ships (Torvalds, Kroah-Hartman, Omarchy's kernel maintainer).
gpg --quiet --import keys/pgp/*.asc 2>/dev/null || true
if [ "${STAGE:-build}" = prepare ]; then
  echo "== prepare only: the tarball, its signature, the config and its checklist $(date)"
  # -s here too: olddefconfig keeps CONFIG_RUST only with rustc present, so the dry pass
  # configures what the build will.
  makepkg -o -s --noconfirm
  echo "== prepared: $(cat src/linux-*/version) — no package built (--prepare-only)"
  echo "PREPARE-OK"
  exit 0
fi
# On a venue box (scripts/venue's locks under the build root) the whole-box make holds
# the gate lock and every build slot, as a full gate does, so it never runs beside one.
root=${SQZ_BUILD_ROOT:-/build}
locks=()
if [ -e "$root/.gate.lock" ]; then
  locks=(flock -o "$root/.gate.lock")
  for s in "$root"/.build-slot.*; do [ -e "$s" ] && locks+=(flock -o "$s"); done
  flock -o -n "$root/.gate.lock" true || echo "== waiting for the venue's gate lock and build slots $(date)"
fi
# -s: pacman installs the PKGBUILD's makedepends (rust, pahole, …) through sudo.
"${locks[@]}" bash -c 'echo "== build ($(nproc) jobs) $(date)"; makepkg -s --noconfirm >../make.log 2>&1' \
  || { tail -30 ../make.log; exit 1; }
echo "== built $(date)"
ver=$(cat src/linux-*/version)
pkgver=$(grep -m1 '^pkgver=' PKGBUILD | cut -d= -f2)-$(grep -m1 '^pkgrel=' PKGBUILD | cut -d= -f2)
image=$(readlink -e "../$PKGBASE-$pkgver-$(uname -m).pkg.tar.zst")
headers=$(readlink -e "../$PKGBASE-headers-$pkgver-$(uname -m).pkg.tar.zst")
echo "$image"; echo "$headers"
if [ "$(uname -r)" = "$ver" ]; then
  echo "== NOTE: this host runs $ver now: installing replaces the running kernel's /usr/lib/modules — install and reboot together"
fi
if [ "${INSTALL:-1}" = 0 ]; then
  echo "== not installed (--no-install); install, then reboot: sudo pacman -U $image $headers"
  echo "BUILD-OK"
  exit 0
fi
echo "== install"
# Limine's BOOT_ORDER, written before pacman -U so the hook's limine-update applies it at once:
# the venue kernel first, Omarchy's own order after it (the distro kernel is the fallback). The
# drop-in sorts after a sqz-kernel.conf a 7.2-era install left (the last BOOT_ORDER wins).
if [ -d /etc/limine-entry-tool.d ]; then
  printf '%s\n' "# squeezefs venue kernel (scripts/kernel/build-host-kernel): boots by default" \
    "BOOT_ORDER=\"$PKGBASE, linux-t2, linux-omarchy, linux-omarchy-*, *, *fallback, Snapshots\"" \
    | sudo tee /etc/limine-entry-tool.d/sqz-mainline-kernel.conf >/dev/null
fi
sudo pacman -U --noconfirm "$image" "$headers"
if sudo test -f /boot/limine.conf; then
  echo "== Limine entries:"; sudo grep -E '^\s*//[^/]|^default_entry' /boot/limine.conf | head -8
fi
echo "== installed; REBOOT this host into $ver to run it (nothing here reboots), then check: uname -r = $ver; cat /sys/module/fuse/parameters/enable_uring; the daemon's mount lines read buffer mode mainline_pool and the FUSE_SYNCFS probe's verdict (absent before 7.4)"
echo "BUILD-AND-INSTALL-OK"
REMOTE

if [ "$STAGE" = prepare ]; then
  on "set -o pipefail; chmod +x $RDIR/build.sh && cd $RDIR && STAGE=prepare KVER=$KVER SQZ_BUILD_ROOT=$ROOT ./build.sh 2>&1 | tee prepare.log"
  exit
fi
# Background the build alone: a backgrounded and-list is a subshell holding ssh's
# streams, and ssh waited out the whole build.
on "chmod +x $RDIR/build.sh && cd $RDIR && { INSTALL=$INSTALL KVER=$KVER SQZ_BUILD_ROOT=$ROOT nohup ./build.sh > build.log 2>&1 < /dev/null & } && echo started"
echo "build started on $WHERE — follow with: scripts/kernel/build-host-kernel ${HOST:---local} --status (log $RDIR/build.log; the host needs a reboot after the install)"

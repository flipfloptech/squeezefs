+static void fuse_uring_zc_scratch_alloc(struct fuse_ring_ent *ent)
+{
+	unsigned int cap = FUSE_ZC_SCRATCH_FOLIOS;
+	struct fuse_zc_pages *held;
+	struct bio_vec *bvs;

# Stage 1: Build the C# extensions
FROM ghcr.io/microsoft/garnet:latest AS garnet
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /app

# Copy the exact Garnet binaries from the base image
COPY --from=garnet /app/*.dll ./libs/

# Copy project files and build
COPY SqueezeExtensions.csproj ./
COPY SqueezeUnlink.cs ./
RUN dotnet publish -c Release -o out

# Stage 2: Create the custom Garnet image
FROM ghcr.io/microsoft/garnet:latest
WORKDIR /app

USER root

# Copy the compiled DLL from Stage 1
COPY --from=build-env /app/out/SqueezeExtensions.dll /app/extensions/SqueezeExtensions.dll

# Copy dependency DLLs to extensions directory to resolve runtime assembly loading
RUN cp /app/Garnet.server.dll /app/Garnet.common.dll /app/Tsavorite.core.dll /app/extensions/

USER app

# Run Garnet loading the SqueezeFS extensions automatically
ENTRYPOINT ["/app/GarnetServer", "--aof", "--extension-bin-paths", "/app/extensions", "--enable-module-command", "yes", "--extension-allow-unsigned"]

/target/
**/*.rs.bk

# task build-system output (Taskfile.yml) + local go-task bootstrap
/dist/
/bin/

# scratch repro harness (user-local, intentionally untracked)
tests/ltp_repro.sh
ltp_syscalls.results

# fio verify-state artifacts (ENG-9)
*-verify.state
loom-models/target/
dhat-heap.json

# agent scratch space — only .agents/skills/ stays committed
.agents/*
!.agents/skills/
!.agents/skills/**

# editor / assistant litter
.gemini/
.vscode/

# cloud bench-cluster local state (tests/cloud_bench_cluster.sh)
.cloud-bench/

# Proprietary exa client performance scripts
exa-client-performance-scripts/
# sqz kernel program scratch (tarballs, extracted trees, mboxes)
.kernel-sqz-work/
dist/

# cargo-fuzz local state (spec §11 TEST-4): its own workspace target,
# the grown corpora, and any crash artifacts. Corpora are per-box growth,
# not source; a reproducing crash input gets committed as a fixture WITH
# its cargo repro-port (the repro-port mandate), never as loose bytes.
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
__pycache__/

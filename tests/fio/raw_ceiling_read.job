# tests/fio/raw_ceiling_read.job
#
# The device-sweep raw READ ceiling shape: libaio, bs=4m, iodepth=16,
# 8 jobs per device (SQZ_FIO_NJOBS_PER_DEV), filename= parametrized —
# run_fio_row.sh --devices /dev/a:/dev/b emits one [section] per device.
#
# Read-only against the raw devices (non-destructive), but it still
# bypasses any filesystem: never point it at a device whose contents you
# cannot afford to have cached/perturbed mid-measurement, and remember
# thin/zeroed devices read unrealistically fast — state the device fill
# in the row label.
[global]
group_reporting=1
ioengine=${SQZ_FIO_ENGINE}
readwrite=read
direct=1
bs=${SQZ_FIO_BS}
iodepth=${SQZ_FIO_IODEPTH}
norandommap=0
time_based
runtime=${SQZ_FIO_RUNTIME}
ramp_time=${SQZ_FIO_RAMP}

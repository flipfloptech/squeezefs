 /* fuse_uring_cmd_req init flags */
-#define FUSE_URING_BUF_RING	(1 << 0)
-#define FUSE_URING_ZERO_COPY	(1 << 1)
+#define FUSE_URING_BUF_RING		(1 << 0)
+#define FUSE_URING_ZERO_COPY		(1 << 1)
+#define FUSE_URING_PAYLOAD_RETENTION	(1 << 2)
+
+/* fuse_uring_cmd_req commit flags */
+#define FUSE_URING_COMMIT_RETAIN	(1 << 0)
 
 /**
  * In the 80B command area of the SQE.
@@ -1329,6 +1341,9 @@ struct fuse_uring_cmd_req {
 			uint16_t flags;
 			uint16_t queue_depth;
 		} init;
+		struct {
+			uint16_t flags;
+		} commit;
 	};
 
 	uint8_t padding[2];

# tests/fio/exa_read_bw.job — EXAScaler client-validation read-BW shape.
# Shape parity with the DDN exa-client kit's read_BW job: libaio, bs=1M,
# iodepth=8, direct=1, time_based runtime=30 ramp=10, size=1g,
# numjobs=nproc split across NUMA nodes.
#
# Fill discipline: run tests/fio/exa_write_bw.job first against the same
# --dir/--njobs/--size (same filename_format => same files) so the read
# row reads REAL prefilled data and the row's fill label is honest;
# otherwise fio's layout phase writes the files itself (label that).
#
# [global] SHAPE only — run via tests/fio/run_fio_row.sh (per-NUMA-node
# sections are emitted at runtime; single-node = one section, no numa
# lines).
[global]
group_reporting=1
ioengine=${SQZ_FIO_ENGINE}
readwrite=read
direct=1
bs=${SQZ_FIO_BS}
size=${SQZ_FIO_SIZE}
iodepth=${SQZ_FIO_IODEPTH}
norandommap=0
fallocate=none
time_based
runtime=${SQZ_FIO_RUNTIME}
ramp_time=${SQZ_FIO_RAMP}
filename_format=sqzfio.$jobnum.$filenum
directory=${SQZ_FIO_DIR}

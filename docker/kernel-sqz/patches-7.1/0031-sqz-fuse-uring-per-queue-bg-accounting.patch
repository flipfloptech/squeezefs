diff --git a/fs/fuse/dev_uring.c b/fs/fuse/dev_uring.c
index 47906e853..c40c4adbf 100644
--- a/fs/fuse/dev_uring.c
+++ b/fs/fuse/dev_uring.c
@@ -61,34 +61,105 @@ static struct fuse_ring_ent *uring_cmd_to_ring_ent(struct io_uring_cmd *cmd)
 	return pdu->ent;
 }
 
-static void fuse_uring_flush_bg(struct fuse_ring_queue *queue)
+/*
+ * This queue's share of the connection's max_background: an even split
+ * across the ring's queues, the remainder handed to the lowest qids so the
+ * shares sum to max_background exactly whenever it is at least nr_queues,
+ * and never below one so every queue can always make progress.  Derived at
+ * each admission from a lockless read - max_background moves only through
+ * fusectl and abort (UINT_MAX), and fuse_uring_bg_limit_changed() re-gates
+ * the queues when it does.
+ */
+static unsigned int fuse_uring_bg_max(struct fuse_ring_queue *queue)
 {
 	struct fuse_ring *ring = queue->ring;
-	struct fuse_conn *fc = ring->fc;
+	unsigned int max_background = READ_ONCE(ring->fc->max_background);
+	unsigned int nr_queues = ring->nr_queues;
+	unsigned int share = max_background / nr_queues;
+
+	if (queue->qid < max_background % nr_queues)
+		share++;
+
+	return max(share, 1U);
+}
+
+static void fuse_uring_flush_bg(struct fuse_ring_queue *queue)
+{
+	unsigned int bg_max = fuse_uring_bg_max(queue);
 
 	lockdep_assert_held(&queue->lock);
-	lockdep_assert_held(&fc->bg_lock);
 
 	/*
-	 * Allow one bg request per queue, ignoring global fc limits.
-	 * This prevents a single queue from consuming all resources and
-	 * eliminates the need for remote queue wake-ups when global
-	 * limits are met but this queue has no more waiting requests.
+	 * Admit against this queue's own share only - no connection-wide
+	 * state is consulted, so a queue never needs a remote wake-up when
+	 * another queue's requests finish.  bg_max >= 1 keeps the historic
+	 * "at least one background request per queue" guarantee.
 	 */
-	while ((fc->active_background < fc->max_background ||
-		!queue->active_background) &&
-	       (!list_empty(&queue->fuse_req_bg_queue))) {
+	while (queue->active_background < bg_max &&
+	       !list_empty(&queue->fuse_req_bg_queue)) {
 		struct fuse_req *req;
 
 		req = list_first_entry(&queue->fuse_req_bg_queue,
 				       struct fuse_req, list);
-		fc->active_background++;
 		queue->active_background++;
 
 		list_move_tail(&req->list, &queue->fuse_req_queue);
 	}
 }
 
+/*
+ * Credit the queue's ledger for a request charged by
+ * fuse_uring_queue_bq_req().  Clearing FR_BACKGROUND here is what keeps
+ * fuse_request_end() off fc->bg_lock for this request: the connection's
+ * ledger was never charged for it.
+ */
+static void fuse_uring_bg_uncharge(struct fuse_ring_queue *queue,
+				   struct fuse_req *req)
+{
+	lockdep_assert_held(&queue->lock);
+
+	clear_bit(FR_BG_URING, &req->flags);
+	clear_bit(FR_BACKGROUND, &req->flags);
+	queue->num_background--;
+	queue->active_background--;
+}
+
+/*
+ * A background request charged to this queue ended: uncharge it, re-open
+ * the queue's admission gate if its share has room again, hand the freed
+ * slot to one waiter, and let the next queued background request through.
+ *
+ * Waiters sleep exclusively on bg_waitq, so a wake_up() passes exactly
+ * one slot on (the wake chain the classical fuse_request_bg_finish() has
+ * always used).  The waitqueue_active() check in the unblocked arm is safe
+ * for the same reason it is there: a waiter only sleeps after seeing
+ * bg_blocked set, and every set->cleared transition is paired with a full
+ * wake_up().  A woken waiter may resubmit on a different queue (it is
+ * placed by the CPU it runs on), so a queue can drain with waiters left
+ * behind: the last request out wakes them all rather than strand them.
+ */
+static void fuse_uring_bg_finish(struct fuse_ring_queue *queue,
+				 struct fuse_req *req)
+{
+	lockdep_assert_held(&queue->lock);
+
+	fuse_uring_bg_uncharge(queue, req);
+
+	if (queue->num_background < fuse_uring_bg_max(queue)) {
+		if (queue->bg_blocked) {
+			WRITE_ONCE(queue->bg_blocked, false);
+			wake_up(&queue->bg_waitq);
+		} else if (waitqueue_active(&queue->bg_waitq)) {
+			wake_up(&queue->bg_waitq);
+		}
+	}
+
+	if (!queue->num_background && waitqueue_active(&queue->bg_waitq))
+		wake_up_all(&queue->bg_waitq);
+
+	fuse_uring_flush_bg(queue);
+}

#!/usr/bin/env bash
# mount(8) helper for the external suites: `mount -t fuse.squeezefs <dev> <dir>
# -o <opts>` (xfstests' `_mount -t $FSTYP$FUSE_SUBTYP`) lands here through
# util-linux's `/sbin/mount.fuse.squeezefs` symlink (installed by
# scripts/suites/fstests.sh). Also answers as `/sbin/umount.fuse.squeezefs`
# (util-linux's umount helper: `umount.<type> <dir> [-l] [-f] [-n] [-v]`),
# so xfstests' `umount` runs the ORDERLY `squeezefs umount` (teardown
# promotes staged files first, the final checkpoint lands) instead of the
# bare umount2 that gives a type-fuse mount no DESTROY.
#
# <dev> is the set's metadata volume — a plain file or a loop device over
# one (xfstests' TEST_DEV/SCRATCH_DEV: loop devices, so the suite's block-
# device requirements hold); the data volumes are the format's config. The mount posture is the RELEASE posture
# (`default_permissions,allow_other`) PLUS the caller's options: `ro`,
# `noatime`, `nodiratime`, `sync`, `dirsync`, `nosuid`, `nodev`, `noexec`
# and the daemon's own `-o` names pass through to `squeezefs mount`, which
# refuses anything it does not know (charter §1.6: a junk option is a
# loud refusal, never dropped). `remount` is the KERNEL's: a FUSE
# superblock's ro/rw flip (`fuse_reconfigure`) needs no daemon verb, so
# `-o remount,…` goes straight to mount(8) with `-i` (no helper recursion)
# — generic/294 and 306 test the EROFS laws through it.
set -euo pipefail

ENV_FILE=${SQZ_SUITES_ENV:-/run/squeezefs-suites.env}
[ -f "$ENV_FILE" ] && source "$ENV_FILE"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/setpaths.sh"
SQZ_BIN=${SQZ_BIN:-squeezefs}
SUITE_MOUNT_OPTS=${SUITE_MOUNT_OPTS:-default_permissions,allow_other}

die() { echo "$(basename "$0"): $*" >&2; exit 32; }

if [[ "$(basename "$0")" == umount.* ]]; then
  target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) ;;                       # -l -f -n -v -r -i: the orderly umount is the one act
      *) [ -z "$target" ] && target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || die "usage: umount.fuse.squeezefs <mountpoint>"
  # A BIND of a path inside a squeezefs mount (generic/306 binds a file)
  # carries our fstype in the mount table but has no daemon of its own:
  # the kernel's plain detach, silently (mount(8) prints nothing). Only a
  # daemon's own root gets the orderly `squeezefs umount`.
  if ! findmnt -n -o FSROOT -M "$target" 2>/dev/null | grep -qx /; then exec umount -i "$target"; fi
  exec "$SQZ_BIN" umount "$target"
fi

dev="" dir="" opts=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) opts="${opts:+$opts,}$2"; shift ;;
    -o*) opts="${opts:+$opts,}${1#-o}" ;;
    -t) shift ;;                   # the type we are
    -n|-s|-f|-v|-i|-r|-w) ;;      # util-linux helper flags: no table to write, verbose is the log
    -N) shift ;;
    -*) die "unknown flag $1" ;;
    *) if [ -z "$dev" ]; then dev=$1; elif [ -z "$dir" ]; then dir=$1; else die "extra argument $1"; fi ;;
  esac
  shift
done
[ -n "$dev" ] && [ -n "$dir" ] || die "usage: mount.fuse.squeezefs <meta-volume-path> <mountpoint> [-o opts]"
case ",$opts," in *,remount,*|*,remount=*) exec mount -i -o "$opts" "$dir" ;; esac

# Options: the release posture first, then the caller's (minus the mount
# table words util-linux adds and the ones a FUSE daemon cannot honour).
pass=()
IFS=',' read -ra items <<< "$opts"
for it in "${items[@]}"; do
  case "$it" in
    ""|rw|defaults|auto|noauto|user|nouser|owner|group|_netdev|nofail|loop) ;;
    *) pass+=("$it") ;;
  esac
done
# The mount table's source column IS the device string: xfstests finds the
# mount by `findmnt -S $dev -t fuse.squeezefs` (`fsname` and `subtype` are
# independent in the daemon's option parser).
all="$SUITE_MOUNT_OPTS,fsname=$dev"
for p in "${pass[@]}"; do all="$all,$p"; done

suite_set_of "$dev"
log="$SET_DIR/daemon-$(date +%Y%m%d-%H%M%S)-$$.log"
# One line per mount in the set's own ledger, so a run's daemons are findable.
echo "$(date +%s) mount $dir -o $all log $log" >> "$SET_DIR/mounts.log"
# The zero-copy kmbuf ring needs order-8 contiguous pages per queue; a
# fragmented venue (other agents' daemons, a hot page cache) answers
# ENOMEM. Compact and retry, as `common.sh`'s `suite_mount` does — never a
# weaker buffer mode to pass (charter §1.6/§1.8); a test's own mount
# failing on the venue's memory is a venue casualty, never a semantic.
attempt=0
while :; do
  attempt=$((attempt + 1))
  # mount(8) is silent on success: the front's bring-up lines are the
  # daemon log's (a test that runs `_scratch_mount` bare captures stderr
  # into its golden output — generic/631, 634); on failure they are the
  # diagnosis and go to stderr.
  # `--supervise`: the release posture's external supervisor (common.sh's
  # `suite_mount` says why) — a death gets its wait status, a wedge its dump.
  out=$("$SQZ_BIN" mount --daemon --supervise --log-file "$log" -o "$all" "sqmeta://$SET_DEV" "$dir" 2>&1) && exit 0
  rc=$?
  if [ "$attempt" -lt 3 ] && grep -q 'ENOMEM (order-8' <<< "$out"; then
    echo "$(date +%s) mount $dir: kmbuf ENOMEM (fragmented venue); compacting memory, retry $attempt/3" >> "$SET_DIR/mounts.log"
    # /proc/sys is read-only in the container venue: best effort, the
    # retry itself is the recovery.
    sync -f "$SET_DIR"; { echo 3 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory; } 2>/dev/null || true; sleep 2
    continue
  fi
  # A stale writer claim whose holder is DEAD: the previous daemon of this
  # set died without its clean unmount (the product never auto-takes a
  # claim on a volume without PR — operator attestation, charter D0). The
  # harness IS the operator here and can attest: the set directory is
  # ours alone, and the claim's pid is gone or a zombie. The death is
  # recorded for the run's verdict (`suite_daemon_alerts` reads
  # `daemon-died`: a run with one is VOID), the claim is cleared, the
  # mount retried once — so the gate keeps collecting instead of failing
  # every later test on the dead holder's lock.
  # A LIVE holder that is on its way out (the previous daemon of this set
  # still tearing down: generic/604 mounts while a background umount
  # runs): mount(8) on a kernel filesystem blocks until the superblock is
  # gone; the helper waits for the holder's exit the same way (bounded),
  # then retries. A holder that stays is a real refusal.
  # (The guard's two live phrasings: "another squeezefs process holds the
  # writer lock (claim: …)" — the flock — and "claimed by a live writer
  # (claim: …)" — the on-volume claim; both name the holder's pid.)
  if grep -q 'another writer holds the single-writer guard' <<< "$out" && grep -qE 'holds the writer lock \(claim:|claimed by a live writer \(claim:' "$log" 2>/dev/null; then
    lpid=$(grep -oE '(holds the writer lock|claimed by a live writer) \(claim: id=[0-9a-f]*, pid=[0-9]*' "$log" | head -1 | grep -o 'pid=[0-9]*' | cut -d= -f2)
    if [ -n "$lpid" ] && [ -d "/proc/$lpid" ] && ! grep -q 'State:.*Z' "/proc/$lpid/status" 2>/dev/null; then
      waited=0
      while [ -d "/proc/$lpid" ] && ! grep -q 'State:.*Z' "/proc/$lpid/status" 2>/dev/null && [ "$waited" -lt 60 ]; do sleep 1; waited=$((waited + 1)); done
      if [ ! -d "/proc/$lpid" ] || grep -q 'State:.*Z' "/proc/$lpid/status" 2>/dev/null; then
        echo "$(date +%s) mount $dir: waited ${waited}s for the previous holder (pid $lpid) to exit; retrying" >> "$SET_DIR/mounts.log"
        [ "$attempt" -lt 3 ] && continue
      fi
    fi
  fi
  if [ "$attempt" -lt 3 ] && grep -q 'another writer holds the single-writer guard' <<< "$out" && grep -q 'stale writer claim' "$log" 2>/dev/null; then
    cpid=$(grep -o 'stale writer claim (id=[0-9a-f]*, pid=[0-9]*' "$log" | head -1 | grep -o 'pid=[0-9]*' | cut -d= -f2)
    if [ -n "$cpid" ] && { [ ! -d "/proc/$cpid" ] || grep -q 'State:.*Z' "/proc/$cpid/status" 2>/dev/null; }; then
      echo "$(date +%s) DAEMON DIED: claim pid $cpid is gone; clearing the claim (operator attestation: the set is the harness's) and retrying $attempt/3" | tee -a "$SET_DIR/mounts.log" >> "$SET_DIR/daemon-died"
      "$SQZ_BIN" claim clear "sqmeta://$SET_DEV" >> "$SET_DIR/mounts.log" 2>&1 || true
      continue
    fi
  fi
  echo "$out" >&2
  exit "$rc"
done

diff --git a/Documentation/filesystems/fuse/fuse-io-uring.rst b/Documentation/filesystems/fuse/fuse-io-uring.rst
index f9483f28c..37aaf2733 100644
--- a/Documentation/filesystems/fuse/fuse-io-uring.rst
+++ b/Documentation/filesystems/fuse/fuse-io-uring.rst
@@ -190,3 +190,29 @@ leaked retention is reclaimed at teardown (ratelimited ``pr_warn``). Page
 lifetime follows the io_uring registration (see the folio-get / imu-release
 contract); request lifetime follows FUSE. Neither trusts the other's
 ordering.
+
+Per-queue background accounting
+===============================
+
+Background requests (readahead, writeback, direct I/O completions) are
+limited by the connection's ``max_background``. On the classical path that
+limit is one counter under one lock. Once the ring is ready, each ring
+queue instead admits against its own **share** of ``max_background`` — an
+even split across the queues, the remainder to the lowest qids, never below
+one — and keeps its own count, gate and waitqueue under ``queue->lock``.
+The submit path (``fuse_uring_queue_bq_req``) and the end path
+(``fuse_uring_req_end``, run by every COMMIT_AND_FETCH) therefore never take
+the connection-wide ``bg_lock``.
+
+The semantics that change: a queue whose share is exhausted blocks the
+tasks submitting on *that* queue (a task is placed on the queue of the CPU
+it runs on) even while other queues have room. For a server that sets
+``max_background`` to ``queues * queue_depth`` a queue's share is exactly
+its entry count, so only the locking changes. ``fusectl``'s
+``max_background`` is still the single knob — writing it re-gates every
+queue against its new share; reading ``num_background`` sums the queues.
+
+A background request the classical ``flush_bg_queue()`` hands to the ring
+across the ``fiq->ops`` switch-over stays on the connection's ledger and is
+credited by ``fuse_request_end()`` as before; ``FR_BG_URING`` marks the
+requests a queue charged.
diff --git a/fs/fuse/dev.c b/fs/fuse/dev.c
index 99870fb20..7c099fe85 100644
--- a/fs/fuse/dev.c
+++ b/fs/fuse/dev.c
@@ -85,14 +85,22 @@ void fuse_chan_set_initialized(struct fuse_chan *fch, struct fuse_chan_param *pa
 	wake_up_all(&fch->blocked_waitq);
 }
 
+/*
+ * The connection-level allocation gates, all woken through blocked_waitq.
+ * Once the ring is ready, background admission moves to the per-queue
+ * gate (fuse_uring_bg_wait()); fch->blocked then only describes the
+ * classical residue still draining, which no new request joins.
+ */
 static bool fuse_block_alloc(struct fuse_chan *fch, bool for_background)
 {
 	/* Pairs with smp_store_release() in fuse_chan_set_initialized() */
 	if (!smp_load_acquire(&fch->initialized))
 		return true;
 
-	return (for_background && fch->blocked) ||
-	       (fch->io_uring && fch->connected && !fuse_uring_ready(fch));
+	if (fch->io_uring && fch->connected && !fuse_uring_ready(fch))
+		return true;
+
+	return for_background && fch->blocked && !fuse_uring_ready(fch);
 }
 
 static void fuse_drop_waiting(struct fuse_chan *fch)
@@ -126,6 +134,17 @@ static struct fuse_req *fuse_get_req(struct fuse_chan *fch, bool for_background)
 			goto out;
 	}
 
+	/*
+	 * The connection gates above are monotonic once the ring is ready,
+	 * so the per-queue background gate can be taken after them without
+	 * re-checking.
+	 */
+	if (for_background && fuse_uring_ready(fch)) {
+		err = -EINTR;
+		if (fuse_uring_bg_wait(fch))
+			goto out;
+	}
+
 	err = -ENOTCONN;
 	if (!fch->connected)
 		goto out;
@@ -133,8 +152,12 @@ static struct fuse_req *fuse_get_req(struct fuse_chan *fch, bool for_background)
 	req = fuse_request_alloc(fch, GFP_KERNEL);
 	err = -ENOMEM;
 	if (!req) {
-		if (for_background)
-			wake_up(&fch->blocked_waitq);
+		if (for_background) {
+			if (fuse_uring_ready(fch))
+				fuse_uring_bg_kick(fch);
+			else
+				wake_up(&fch->blocked_waitq);
+		}
 		goto out;
 	}
 
@@ -159,10 +182,14 @@ static void fuse_put_request(struct fuse_req *req)
 			 * We get here in the unlikely case that a background
 			 * request was allocated but not sent
 			 */
-			spin_lock(&fch->bg_lock);
-			if (!fch->blocked)
-				wake_up(&fch->blocked_waitq);
-			spin_unlock(&fch->bg_lock);
+			if (fuse_uring_ready(fch)) {
+				fuse_uring_bg_kick(fch);
+			} else {
+				spin_lock(&fch->bg_lock);
+				if (!fch->blocked)
+					wake_up(&fch->blocked_waitq);
+				spin_unlock(&fch->bg_lock);
+			}
 		}
 
 		if (test_bit(FR_WAITING, &req->flags)) {
@@ -387,7 +414,8 @@ EXPORT_SYMBOL_GPL(fuse_dev_chan_new);
 
 unsigned int fuse_chan_num_background(struct fuse_chan *fch)
 {
-	return READ_ONCE(fch->num_background);
+	/* the classical ledger plus the ring queues' per-queue ledgers */
+	return READ_ONCE(fch->num_background) + fuse_uring_num_background(fch);
 }
 
 unsigned int fuse_chan_max_background(struct fuse_chan *fch)
@@ -398,11 +426,14 @@ unsigned int fuse_chan_max_background(struct fuse_chan *fch)
 void fuse_chan_max_background_set(struct fuse_chan *fch, unsigned int val)
 {
 	spin_lock(&fch->bg_lock);
-	fch->max_background = val;
+	WRITE_ONCE(fch->max_background, val);
 	fch->blocked = fch->num_background >= fch->max_background;
 	if (!fch->blocked)
 		wake_up(&fch->blocked_waitq);
 	spin_unlock(&fch->bg_lock);
+
+	/* the ring queues derive their shares from max_background */
+	fuse_uring_bg_limit_changed(fch);
 }
 
 unsigned int fuse_chan_num_waiting(struct fuse_chan *fch)
@@ -593,7 +624,12 @@ static void flush_bg_queue(struct fuse_chan *fch)
 	}
 }
 
-void fuse_request_bg_finish(struct fuse_chan *fch, struct fuse_req *req)
+/*
+ * The classical ledger's finish.  fuse-io-uring requests never reach it:
+ * they are credited to their queue (fuse_uring_bg_finish()) with
+ * FR_BACKGROUND cleared before fuse_request_end() runs.
+ */
+static void fuse_request_bg_finish(struct fuse_chan *fch, struct fuse_req *req)
 {
 	lockdep_assert_held(&fch->bg_lock);
 

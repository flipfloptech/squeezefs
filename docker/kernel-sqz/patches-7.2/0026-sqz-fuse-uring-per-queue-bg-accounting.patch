+/*
+ * A background slot this task was woken for will not be used (allocation
+ * failed, or the request is being dropped unsent): pass the wake on so the
+ * exclusive chain does not lose a link.  Lockless on purpose - a wake that
+ * races a gate closing is re-checked by the waiter, and the gate closing
+ * means requests are in flight to re-open it.
+ */
+void fuse_uring_bg_kick(struct fuse_chan *fch)
+{
+	struct fuse_ring_queue *queue = fuse_uring_task_to_queue(fch->ring);
+
+	if (queue && !READ_ONCE(queue->bg_blocked))
+		wake_up(&queue->bg_waitq);
+}

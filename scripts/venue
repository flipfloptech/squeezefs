#!/usr/bin/env bash
# The Linux venue: run a command inside the `sqz-zig` macOS container
# (Ubuntu 24.04 on the sqz kernel series, Zig 0.17, this repo mounted rw at the
# same path, the Rust reference mounted ro at ~/Source/squeezefs).
#
#   scripts/venue                 # interactive shell in the repo
#   scripts/venue zig build gate  # run the gate in the container
#   scripts/venue test [filter]   # shorthand: zig build test [-- filter]
#   scripts/venue up              # (re)create the container
#   scripts/venue status          # kernel, zig, fuse/uring facts
#   scripts/venue trim            # return deleted blocks to the Mac (run after big tests)
#   scripts/venue pull <path>     # ssh venues: copy <path> (e.g. tests/costs) back to the Mac
#
# Two venues, chosen by SQZ_VENUE:
#   vm (default)  the `sqz-zig` container on this Mac (aarch64, 8 vCPU / 16 GiB, the sqz
#                 kernel with patches 0001–0028)
#   kamrui        the x86_64 box `kamrui-dev` over ssh (12 threads, 61 GiB, local NVMe;
#                 Ubuntu 26.04): the repo is mirrored at the SAME absolute path by rsync
#                 before every command (a delta is ~2 s), commands run as root via sudo,
#                 /build is an ext4 LV on its NVMe. Files a command writes into the tree
#                 stay on the box until `pull`ed — the Mac's tree is the source of truth.
#
# Zig caches live on the `squeezefs-zig-cache` volume (/build) — never on the
# virtiofs mount, where the cache's rename/lock traffic is slow.
set -euo pipefail

NAME=${SQZ_VENUE_NAME:-sqz-zig}
# The build image plus the benchmark instruments (fio, OpenMPI, IOR/mdtest) baked
# in (scripts/dev/Containerfile): a recreate drops anything apt put in the
# container's root fs, so the instruments live in the image.
IMAGE=${SQZ_VENUE_IMAGE:-squeezefs-dev:ubuntu2404}
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REF=${SQZ_REFERENCE:-"$HOME/Source/squeezefs"}
CACHE_VOL=${SQZ_VENUE_CACHE_VOLUME:-squeezefs-zig-cache}
CPUS=${SQZ_VENUE_CPUS:-8}
MEM=${SQZ_VENUE_MEM:-16G}
# Optional extra test-data disk (e.g. an external volume), mounted at /build/ext.
# HFS+/exFAT volumes have NO sparse files: a `truncate -s 8G` costs 8 GB and the
# bus's time there; keep /build (ext4 on the cache volume) for the fast smoke.
EXT_DIR=${SQZ_EXT_DIR:-/Volumes/512GB/sqz-tmp}

# ZIG_GLOBAL_CACHE_DIR is honoured by the compiler; --cache-dir is the build flag.
# The install prefix is per venue: the repo (and so zig-out/) is shared with
# macOS through the mount, and a Linux binary must never overwrite the host's.
ZIG_CACHE_ARGS=(--cache-dir /build/zig-cache-v2 --prefix zig-out-linux)
export_cache="export ZIG_GLOBAL_CACHE_DIR=/build/zig-global-cache"

VENUE=${SQZ_VENUE:-vm}
case "$VENUE" in
  vm) SLOTS=2 ;;
  # 61 GiB: three LTO links (several GB each) beside a 6-shard unit set still fit.
  kamrui) SSH_HOST=${SQZ_VENUE_HOST:-kamrui-dev}; SLOTS=3 ;;
  *) echo "venue: unknown SQZ_VENUE '$VENUE' (vm | kamrui)" >&2; exit 2 ;;
esac
SSH=(ssh -o BatchMode=yes -o LogLevel=ERROR)

# The Mac's tree → the ssh venue's mirror (same absolute path, so worktrees' .git
# pointers resolve). Build products and caches never cross.
sync_tree() {
  [ "${SQZ_VENUE_NOSYNC:-0}" = 1 ] && return 0
  rsync -a --delete --exclude='.zig-cache/' --exclude='zig-out*/' --exclude='.gate-train/' \
    --exclude='__pycache__/' --exclude='.git/hooks/' -e "${SSH[*]}" "$REPO/" "$SSH_HOST:$REPO/" \
    | grep -v '^cannot delete non-empty directory: \.wt-' || true
  # A worktree removed on the Mac leaves its mirror behind: the build products inside it are
  # excluded from the sync, so rsync cannot empty the directory. Remove such mirrors.
  # (`|| true`: a tree with no worktrees under it matches nothing, and under pipefail the
  # failed ls would end the script silently — it did, from inside a worktree.)
  local here; here=$( { cd "$REPO" && ls -d .wt-*/ 2>/dev/null || true; } | tr -d / | tr '\n' ' ')
  "${SSH[@]}" "$SSH_HOST" "cd '$REPO' && for d in .wt-*/; do d=\${d%/}; [ -d \"\$d\" ] || continue; case ' $here ' in *\" \$d \"*) ;; *) sudo rm -rf -- \"\$d\" ;; esac; done" </dev/null
}

up() {
  if [ "$VENUE" != vm ]; then
    sync_tree
    # Modules, IOR/mdtest, root-MPI env: what the container gets from its image.
    "${SSH[@]}" "$SSH_HOST" "sudo bash '$REPO/scripts/dev/provision-ssh-venue'"
    return
  fi
  container volume create "$CACHE_VOL" >/dev/null 2>&1 || true
  if container inspect "$NAME" >/dev/null 2>&1; then
    echo "venue: $NAME exists; 'container rm -f $NAME' first to recreate" >&2
    return 1
  fi
  # CAP_IPC_LOCK + unlimited memlock: io_uring fixed-buffer registration
  # (REGISTER_BUFFERS) pins pages against RLIMIT_MEMLOCK unless the process
  # holds CAP_IPC_LOCK; without it the venue silently exercises only the
  # plain-Read fallback and never the ReadFixed leg.
  # CAP_SYS_ADMIN: the FUSE transport tests mount(2)/umount2 real EchoFs
  # mounts (rung 3) and write fuse.enable_uring; without it mount(2) is EPERM
  # and every e2e test skips its venue.
  if ! container image inspect "$IMAGE" >/dev/null 2>&1 && [ "$IMAGE" = squeezefs-dev:ubuntu2404 ]; then
    echo "venue: building $IMAGE (the build image + fio, OpenMPI, IOR/mdtest) …"
    container build -t "$IMAGE" -f "$REPO/scripts/dev/Containerfile" "$REPO/scripts/dev" >/dev/null
  fi
  local ext_mount=()
  if [ -d "$EXT_DIR" ]; then ext_mount=(--mount "type=virtiofs,source=$EXT_DIR,target=/build/ext"); fi
  # --init: PID 1 reaps orphans (with `sleep infinity` as PID 1 the venue piled
  # up ~890 zombies from exited supervisors and test helpers).
  container run -d --init --name "$NAME" -c "$CPUS" -m "$MEM" \
    --cap-add CAP_IPC_LOCK --cap-add CAP_SYS_ADMIN --ulimit memlock=-1:-1 \
    "${ext_mount[@]}" \
    --mount "type=virtiofs,source=$REPO,target=$REPO" \
    --mount "type=virtiofs,source=$REF,target=$REF,readonly" \
    -v "$CACHE_VOL:/build" \
    "$IMAGE" sleep infinity
  container exec "$NAME" mkdir -p /build/zig-cache /build/zig-global-cache
}

ensure_running() {
  [ "$VENUE" != vm ] && return 0
  local state
  state=$(container inspect "$NAME" 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print((d[0] if isinstance(d,list) else d).get("status",""))' 2>/dev/null || true)
  case "$state" in
    running) ;;
    "") echo "venue: container $NAME does not exist; run 'scripts/venue up'" >&2; exit 1 ;;
    *) container start "$NAME" >/dev/null ;;
  esac
}

run_in() {
  ensure_running
  # -t only when our stdin is a terminal: zig's build runner draws its live
  # progress tree only on a TTY (without one a gate is silent until each step
  # ends; the test runner's heartbeat lines are what a scripted run sees).
  # Scripted runs and agents have no TTY — `-t` there would fail the exec.
  local tty=()
  if [ -t 0 ]; then tty=(-t); fi
  local cmd="$*"
  # ONE full gate at a time on the venue: a gate derives its shard counts from
  # the whole VM (4 unit shards × ~2 GiB + 4 smoke shards with daemons + the
  # compile), so two or three concurrent gates over-commit its 16 GiB until the
  # kernel livelocks reclaiming page cache — on 2026-10-14 not even an `exec`
  # of `echo` could start for 5 minutes and the VM had to be stopped from the
  # host. A gate waits here (flock on the shared /build volume) and says so.
  # And at most TWO builds at once otherwise: an LTO link of the product takes several GB, and
  # four agents' targeted builds beside the gate train got the compiler OOM-killed (signal
  # KILL) the same day. Two build slots (flock /build/.build-slot.{0,1}); a full gate holds
  # the gate lock AND both slots, so it runs alone. A command whose own exit status is 75
  # (EX_TEMPFAIL) is indistinguishable from "slot busy" — none of ours uses it.
  # Every slotted command runs under a wall bound (SQZ_VENUE_TIMEOUT, default 2 h — a full
  # gate is ~10–45 min with its waits): two hung red-repro test processes once held both
  # build slots for 2 h and stalled every gate behind them. A command that needs longer
  # sets the variable.
  local bound=${SQZ_VENUE_TIMEOUT:-7200}
  local q; q=$(printf '%q' "timeout --kill-after=30 $bound bash -lc $(printf '%q' "$cmd")")
  local all_slots="" s
  for ((s = 0; s < SLOTS; s++)); do all_slots="$all_slots flock -o /build/.build-slot.$s"; done
  if printf '%s' "$cmd" | grep -Eq 'zig build[^;&|]*[[:space:]]gate([[:space:]]|$)'; then
    cmd="flock -o -n /build/.gate.lock true 2>/dev/null || echo \"venue: another full gate holds the venue (\$(bash scripts/venue-gate-holder 2>/dev/null)) — waiting for it\" >&2; flock -o /build/.gate.lock$all_slots bash -lc $q"
  elif printf '%s' "$cmd" | grep -Eq 'zig build' || [ "${SQZ_VENUE_SLOT:-0}" = 1 ]; then
    # (SQZ_VENUE_SLOT=1: any heavy command — a loop of smoke rows, daemons, `yes` load —
    # takes a slot too, so a full gate, which holds every slot, never runs beside it.)
    # A gate takes the gate lock, then the slots one by one; a slot command passes the gate
    # lock (shared, for an instant) before every try, so once a gate holds it no new command
    # starts and the gate waits only for the ones already running. Without that, loops took
    # each slot the moment it freed and the train held the gate lock 28 min waiting for
    # slot 0 (kamrui, 2026-10-15). A waiting command polls every slot and takes the first
    # that frees.
    cmd="r=75; said=0; while :; do flock -s -o -n /build/.gate.lock true || { echo \"venue: a full gate holds the venue (\$(bash scripts/venue-gate-holder 2>/dev/null)) — waiting for it\" >&2; flock -s -o /build/.gate.lock true; }; for s in \$(seq 0 $((SLOTS - 1))); do flock -o -n -E 75 /build/.build-slot.\$s bash -lc $q; r=\$?; [ \$r -ne 75 ] && break 2; done; [ \$said = 1 ] || echo 'venue: $SLOTS builds are running — waiting for a build slot' >&2; said=1; sleep 2; done; exit \$r"
  fi
  # -lc so PATH picks up /usr/local/bin/zig; cd into the repo at the same path.
  if [ "$VENUE" = vm ]; then
    container exec -i ${tty[@]+"${tty[@]}"} "$NAME" bash -lc "$export_cache; cd '$REPO' && $cmd"
  else
    sync_tree
    # Root, as in the container: mount(2), fuse.enable_uring, nvmet configfs.
    "${SSH[@]}" ${tty[@]+"${tty[@]}"} "$SSH_HOST" "sudo bash -lc $(printf '%q' "$export_cache; cd '$REPO' && $cmd")"
  fi
}

case "${1:-}" in
  up) up ;;
  pull)
    shift
    [ "$VENUE" = vm ] && { echo "venue: the vm shares the tree — nothing to pull" >&2; exit 0; }
    for p in "$@"; do rsync -a -e "${SSH[*]}" "$SSH_HOST:$REPO/$p" "$(dirname "$REPO/$p")/"; done
    ;;
  trim)
    # Return deleted blocks to the Mac: the container disk is a sparse image
    # that only shrinks when the guest issues discards. Discard at once (a gate's
    # deleted test files are most of it), then prune what builds leave behind
    # (scripts/venue-prune: the zig cache above SQZ_VENUE_CACHE_CAP_GB, finished
    # agents' caches, test leftovers) holding the gate lock and every slot, so
    # nothing in use is deleted, and discard again; a venue busy for 15 min skips
    # the prune. (Pruning first made the discard wait behind a running gate while
    # the Mac fell 99 → 38 GiB free.)
    all_slots=""
    for ((s = 0; s < SLOTS; s++)); do all_slots="$all_slots flock -o /build/.build-slot.$s"; done
    SQZ_VENUE_SLOT=0 run_in "sync -f /build; fstrim -v /build; if flock -o -w 900 /build/.gate.lock$all_slots bash scripts/venue-prune ${SQZ_VENUE_CACHE_CAP_GB:-30}; then sync -f /build; fstrim -v /build; else echo 'venue: busy for 15 min — prune skipped' >&2; fi; df -h /build | tail -1"
    ;;
  status)
    run_in 'uname -r; zig version; echo "install prefix: zig-out-linux/"; echo "fuse.enable_uring=$(cat /sys/module/fuse/parameters/enable_uring)"; echo "io_uring_disabled=$(cat /proc/sys/kernel/io_uring_disabled)"; nproc; free -g | sed -n 2p'
    ;;
  test)
    shift
    if [ $# -gt 0 ]; then
      run_in "zig build ${ZIG_CACHE_ARGS[*]} test -Dtest-filter=\"$*\""
    else
      run_in "zig build ${ZIG_CACHE_ARGS[*]} test"
    fi
    ;;
  zig)
    shift
    # `scripts/venue zig build X` -> inject the cache dirs after `build`.
    if [ "${1:-}" = build ]; then
      shift
      run_in "zig build ${ZIG_CACHE_ARGS[*]} $*"
    else
      run_in "zig $*"
    fi
    ;;
  "")
    ensure_running
    if [ "$VENUE" = vm ]; then
      exec container exec -it "$NAME" bash -lc "cd '$REPO' && exec bash"
    fi
    sync_tree
    exec "${SSH[@]}" -t "$SSH_HOST" "sudo bash -lc $(printf '%q' "cd '$REPO' && exec bash")"
    ;;
  *) run_in "$*" ;;
esac

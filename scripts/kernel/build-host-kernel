#!/usr/bin/env bash
# build-host-kernel — build the squeezefs venue kernels natively on a Linux HOST — one reached
# over ssh, or this one (--local) — as the host's distro packages, and install them.
#
#   scripts/kernel/build-host-kernel <ssh-host> [--flavour F] [--no-install | --status | --prepare-only]
#   scripts/kernel/build-host-kernel --local    [--flavour F] [--no-install | --status | --prepare-only]
#
#   F: omarchy | stock | both (the default: omarchy, then stock, one after the other)
#
# The product needs Linux >= 7.3 with FUSE-over-io_uring buffer pools (owner ruling 2026-10-29)
# and the venue carries none of OUR kernel patches (owner ruling 2026-11-02: no kernel patches of
# ours, no fork; decision 0003 §DB, docs/evidence/rung-10-stock-kernel.md); any such kernel
# serves. This script builds the venue's two, both kernel.org linux $KVER (the tarball, checked by
# its signature) configured with scripts/kernel/config-fragment, asserted as a checklist (fail
# loud; a config is not a patch: the fragment only enables in-tree options):
#
#   omarchy — pkgbase linux-omarchy-mainline, the venue's DEFAULT boot entry (owner ruling
#     2026-11-02; decision 0003 §DD, docs/evidence/rung-10-omarchy-kernel.md): Omarchy's kernel
#     recipe at the commit pinned in scripts/kernel/omarchy-7.3/series — its config.x86_64 as the
#     seed, its build/package functions, the patches of its series that apply to $KVER (fetched
#     from that commit by name, each checked by its b2sum) — plus BORE's own $KVER patch and
#     Omarchy's AMD/VESA display fixes ported to $KVER (vendored in that directory, whose README
#     has the table and the refresh steps). uname -r: $KVER-1-omarchy-mainline.
#   stock — pkgbase linux-mainline-sqz, the SECOND boot entry: $KVER UNPATCHED, Omarchy's CURRENT
#     config.x86_64 as the seed, none of its patches (they are for its own base), its PKGBUILD's
#     build/package functions verbatim. uname -r: $KVER-1-mainline-sqz.
#
# Arch and derivatives (Omarchy) only: makepkg builds, pacman -U installs, which fires the
# mkinitcpio/Limine hooks (the UKI, the boot entry). pkgrel 1; bump it when a rebuild of the
# same $KVER must be told from the running one. A limine-entry-tool drop-in orders BOOT_ORDER:
# the omarchy flavour, then the stock one, then Omarchy's own entries and their fallbacks (the
# daemon refuses a kernel without buffer pools). A Debian/Ubuntu host runs a distro or kernel.org
# >= 7.3 kernel (scripts/dev/provision-local-venue checks it).
#
# Each flavour builds in its own directory on the target — $SQZ_BUILD_ROOT/kernel/omarchy-mainline
# and $SQZ_BUILD_ROOT/kernel/mainline (default root /build) — under nohup, the selected flavours
# one after the other; each directory's log is build.log there. Nothing here reboots: the new
# kernels run after the reboot whoever owns the host schedules.
#
# --no-install stops after the packages: each log ends with their absolute paths and the line
# that installs them, for whoever coordinates the host's reboot (a package manager replaces the
# running kernel's /lib/modules/<ver> when the version string is the same, so install and
# reboot together). --prepare-only runs makepkg -o in the foreground — download, signature, the
# patches at --fuzz=0, the config and its checklist, no compile — to see a patch or config gap
# in minutes rather than after a build.
set -euo pipefail

HOST=${1:?usage: build-host-kernel <ssh-host> | --local [--flavour omarchy|stock|both] [--no-install | --status | --prepare-only]}
[ "$HOST" = --local ] && HOST=
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
SSH=(ssh -o BatchMode=yes -o LogLevel=ERROR)
ROOT=${SQZ_BUILD_ROOT:-/build}
# The kernel.org release the venue runs (the latest stable; a bump is this line, a refreshed
# scripts/kernel/omarchy-7.3/series and a rebuild).
KVER=7.3.1
SERIES=$REPO/scripts/kernel/omarchy-7.3
# A shell command on the target: over ssh, or here.
on() { if [ -n "$HOST" ]; then "${SSH[@]}" "$HOST" "$1"; else bash -c "$1"; fi; }
at() { echo "${HOST:+$HOST:}$1"; }
WHERE=${HOST:-this host}
# A flavour's build directory on the target.
fdir() { case "$1" in omarchy) echo "$ROOT/kernel/omarchy-mainline" ;; stock) echo "$ROOT/kernel/mainline" ;; esac; }

INSTALL=1
STAGE=build
FLAVOURS="omarchy stock"
shift
while [ $# -gt 0 ]; do
  case "$1" in
    --flavour)
      case "${2:-}" in
        omarchy | stock) FLAVOURS=$2 ;;
        both) FLAVOURS="omarchy stock" ;;
        *) echo "build-host-kernel: --flavour takes omarchy | stock | both, not '${2:-}'" >&2; exit 2 ;;
      esac
      shift ;;
    --status) STAGE=status ;;
    --no-install) INSTALL=0 ;;
    --prepare-only) STAGE=prepare ;;
    *) echo "build-host-kernel: unknown option '$1' (--flavour omarchy|stock|both | --no-install | --status | --prepare-only)" >&2; exit 2 ;;
  esac
  shift
done

if [ "$STAGE" = status ]; then
  for f in $FLAVOURS; do
    d=$(fdir "$f")
    echo "== $f ($d)"
    on "tail -5 $d/build.log 2>/dev/null; ls $d/*.pkg.tar.zst 2>/dev/null" || true
  done
  exit
fi

# The target's package family (Omarchy says ID=omarchy ID_LIKE=arch).
case " $(on '. /etc/os-release; echo "$ID ${ID_LIKE:-}"') " in
  *" arch "*) ;;
  *) echo "build-host-kernel: $WHERE is not Arch-family: the venue kernel packages for Arch/Omarchy only — run a distro or kernel.org Linux >= 7.3 there" >&2; exit 2 ;;
esac

# The omarchy flavour's series is made for one kernel release: refuse another.
case " $FLAVOURS " in *" omarchy "*)
  skver=$(awk '$1 == "kernel" { print $2 }' "$SERIES/series")
  [ "$skver" = "$KVER" ] || { echo "build-host-kernel: $SERIES/series is for linux '$skver', this script builds $KVER — refresh the series (README.md there)" >&2; exit 2; }
esac

# The target's half: one flavour, in its directory (runs under nohup; its log is build.log there).
IFS= read -r -d '' BUILD_SH <<'REMOTE' || true
#!/usr/bin/env bash
set -euo pipefail
# A failed step says so in the log (set -e alone exits silently).
trap 'echo "BUILD FAILED at line $LINENO: $BASH_COMMAND"' ERR
cd "$(dirname "$0")"
# The distro's toolchain only: a version manager's rustc or gcc on the caller's PATH
# (mise shims) would be picked over the makedepends makepkg installs.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
# Omarchy's kernel recipe: the seed config and the build/package functions (and, for the
# omarchy flavour, the patches its series names).
UPSTREAM=linux-omarchy
KVER=${KVER:?}
case "${FLAVOUR:?}" in
  omarchy)
    PKGBASE=linux-omarchy-mainline
    rev=$(awk '$1 == "omarchy-pkgs" { print $2 }' series/series)
    [ -n "$rev" ] || { echo "series/series names no omarchy-pkgs commit"; exit 1; }
    desc="Linux (kernel.org) with Omarchy patches, BORE and the squeezefs venue config fragment (sqz)" ;;
  stock)
    PKGBASE=linux-mainline-sqz
    rev=HEAD
    desc="Linux (kernel.org, unpatched) with the squeezefs venue config fragment (sqz)" ;;
esac
# makepkg caches the kernel tarball here across rebuilds and drops the packages beside the log.
export SRCDEST=$PWD/sources PKGDEST=$PWD
mkdir -p "$SRCDEST"
echo "== the recipe: omacom/omarchy-pkgs pkgbuilds/$UPSTREAM at $rev"
rm -rf omarchy-pkgs
git init -q omarchy-pkgs
git -C omarchy-pkgs remote add origin https://github.com/omacom/omarchy-pkgs.git
git -C omarchy-pkgs sparse-checkout set "pkgbuilds/$UPSTREAM" >/dev/null
git -C omarchy-pkgs fetch -q --depth 1 --filter=blob:none origin "$rev"
git -C omarchy-pkgs checkout -q FETCH_HEAD
up=$PWD/omarchy-pkgs/pkgbuilds/$UPSTREAM
omarchy_rev=$(git -C omarchy-pkgs rev-parse --short HEAD)
echo "  omarchy-pkgs $omarchy_rev ($(git -C omarchy-pkgs log -1 --format=%cs)): $(grep -m1 '^pkgver=' "$up/PKGBUILD") $(grep -m1 '^pkgrel=' "$up/PKGBUILD"), $(ls "$up"/*.patch | wc -l) Omarchy patches"
grep -q '^prepare()' "$up/PKGBUILD" || { echo "PKGBUILD has no prepare() — the recipe changed shape; read it"; exit 1; }
rm -rf "$PKGBASE" && mkdir "$PKGBASE" && cd "$PKGBASE"
cp -a "$up/keys" . && cp "$up/config.x86_64" .
cp ../fragment sqz-config-fragment
# The series, in its order: an Omarchy patch from the pinned recipe, or a vendored one; makepkg
# checks each against the series' b2sum (the b2sums array below is the series', not the file's).
patches=() sums=()
if [ "$FLAVOUR" = omarchy ]; then
  while read -r src file sum; do
    case "$src" in
      omarchy) cp "$up/$file" . ;;
      vendored) cp "../series/$file" . ;;
      *) continue ;;
    esac
    patches+=("$file") sums+=("'$sum'")
  done < ../series/series
  echo "== the derived package: $PKGBASE = kernel.org linux $KVER + $(grep -c '^omarchy ' ../series/series) Omarchy patches (omarchy-pkgs $omarchy_rev) + $(grep -c '^vendored ' ../series/series) vendored (BORE, the display ports) + the venue's config fragment; Omarchy's config as the seed, its build/package functions"
else
  echo "== the derived package: $PKGBASE = kernel.org linux $KVER, unpatched, + the venue's config fragment; Omarchy's config as the seed, its build/package functions, none of its patches"
fi
{
  echo "# $PKGBASE (scripts/kernel/build-host-kernel --flavour $FLAVOUR): kernel.org linux $KVER,"
  echo "# ${#patches[@]} patches, configured with the venue's fragment (scripts/kernel/config-fragment);"
  echo "# Omarchy's PKGBUILD ($omarchy_rev) lends its config as the seed and its build/package functions."
  echo "pkgbase=$PKGBASE"
  echo "pkgver=$KVER"
  echo "pkgrel=1"
  echo "pkgdesc='$desc'"
  echo "url='https://kernel.org'"
  echo "arch=(x86_64)"
  echo "license=(GPL-2.0-only)"
  sed -n '/^makedepends=(/,/^)/p' "$up/PKGBUILD"
  echo "options=(!debug !strip)"
  echo '_major=${pkgver%%.*}'
  echo '_srcname=linux-$pkgver'
  echo "source=("
  echo '  https://cdn.kernel.org/pub/linux/kernel/v${_major}.x/${_srcname}.tar.{xz,sign}'
  for p in "${patches[@]}"; do echo "  $p"; done
  echo "  sqz-config-fragment"
  echo ")"
  echo "source_x86_64=(config.x86_64)"
  sed -n '/^validpgpkeys=(/,/^)/p' "$up/PKGBUILD"
  # The tarball is checked by its signature (the keys above); the files beside the PKGBUILD by hash.
  echo "b2sums=('SKIP' 'SKIP' ${sums[*]} '$(b2sum sqz-config-fragment | cut -d' ' -f1)')"
  echo "b2sums_x86_64=('$(b2sum config.x86_64 | cut -d' ' -f1)')"
  echo
  # Omarchy's exports, prepare() (it applies every *.patch of source=() in order at --fuzz=0),
  # build(), _package(), _package-headers() and the pkgname loop.
  sed -n '/^export KBUILD_BUILD_HOST/,$p' "$up/PKGBUILD" | sed 's/^export KBUILD_BUILD_HOST=.*/export KBUILD_BUILD_HOST=sqz/'
} > PKGBUILD
grep -q '^prepare()' PKGBUILD && grep -q '^_package-headers()' PKGBUILD || { echo "the derived PKGBUILD lacks prepare()/_package-headers(); read Omarchy's"; exit 1; }
{
  # Omarchy's prepare() under another name, then ours runs it and adds the fragment.
  echo 'eval "_omarchy_prepare() $(declare -f prepare | sed 1d)"'
  cat <<'PREPARE'
prepare() {
  _omarchy_prepare
  cd "$srcdir/$_srcname"
  # The flavour's tag comes from the pkgbase (localversion.20-pkgname → -omarchy-mainline / -mainline-sqz).
  echo "Applying the sqz config fragment..."
  local line opt val
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*) continue ;;
      CONFIG_*=n) scripts/config -d "${line%%=*}" ;;
      CONFIG_*='"'*'"') opt=${line%%=*}; val=${line#*=}; scripts/config --set-str "$opt" "${val//\"/}" ;;
      CONFIG_*=m) scripts/config -m "${line%%=*}" ;;
      CONFIG_*=y) scripts/config -e "${line%%=*}" ;;
    esac
  done < ../sqz-config-fragment
  make olddefconfig
  local fail=0 want
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*) continue ;;
      CONFIG_*=n) want="# ${line%%=*} is not set" ;;
      *) want="$line" ;;
    esac
    grep -qxF "$want" .config || { echo "MISSING from final .config: $want"; fail=1; }
  done < ../sqz-config-fragment
  [[ $fail = 0 ]] || { echo "sqz config checklist FAILED"; exit 1; }
  echo "sqz checklist OK; modules: $(grep -c '=m$' .config)"
  make -s kernelrelease > version
  echo "Prepared $pkgbase version $(<version)"
}
PREPARE
} >> PKGBUILD
# The signing keys the recipe ships (Torvalds, Kroah-Hartman, Omarchy's kernel maintainer).
gpg --quiet --import keys/pgp/*.asc 2>/dev/null || true
if [ "${STAGE:-build}" = prepare ]; then
  echo "== prepare only: the tarball, its signature, the patches, the config and its checklist $(date)"
  # -s here too: olddefconfig keeps CONFIG_RUST only with rustc present, so the dry pass
  # configures what the build will.
  makepkg -o -s --noconfirm
  echo "== prepared: $(cat src/linux-*/version) — no package built (--prepare-only)"
  echo "PREPARE-OK"
  exit 0
fi
# On a venue box (scripts/venue's locks under the build root) the whole-box make holds
# the gate lock and every build slot, as a full gate does, so it never runs beside one.
root=${SQZ_BUILD_ROOT:-/build}
locks=()
if [ -e "$root/.gate.lock" ]; then
  locks=(flock -o "$root/.gate.lock")
  for s in "$root"/.build-slot.*; do [ -e "$s" ] && locks+=(flock -o "$s"); done
  flock -o -n "$root/.gate.lock" true || echo "== waiting for the venue's gate lock and build slots $(date)"
fi
# -s: pacman installs the PKGBUILD's makedepends (rust, pahole, …) through sudo.
"${locks[@]}" bash -c 'echo "== build ($(nproc) jobs) $(date)"; makepkg -s --noconfirm >../make.log 2>&1' \
  || { tail -30 ../make.log; exit 1; }
echo "== built $(date)"
ver=$(cat src/linux-*/version)
pkgver=$(grep -m1 '^pkgver=' PKGBUILD | cut -d= -f2)-$(grep -m1 '^pkgrel=' PKGBUILD | cut -d= -f2)
image=$(readlink -e "../$PKGBASE-$pkgver-$(uname -m).pkg.tar.zst")
headers=$(readlink -e "../$PKGBASE-headers-$pkgver-$(uname -m).pkg.tar.zst")
echo "$image"; echo "$headers"
if [ "$(uname -r)" = "$ver" ]; then
  echo "== NOTE: this host runs $ver now: installing replaces the running kernel's /usr/lib/modules — install and reboot together"
fi
# Limine's BOOT_ORDER, written before pacman -U so the hook's limine-update applies it at once:
# the omarchy flavour, the stock one, then Omarchy's own order (its kernels are the fallbacks).
# The drop-in sorts after a sqz-kernel.conf a 7.2-era install left (the last BOOT_ORDER wins).
dropin=/etc/limine-entry-tool.d/sqz-mainline-kernel.conf
order='BOOT_ORDER="linux-omarchy-mainline, linux-mainline-sqz, linux-t2, linux-omarchy, linux-omarchy-*, *, *fallback, Snapshots"'
if [ "${INSTALL:-1}" = 0 ]; then
  echo "== not installed (--no-install); install, then reboot:"
  [ -d "${dropin%/*}" ] && echo "   echo '$order' | sudo tee $dropin"
  echo "   sudo pacman -U $image $headers"
  echo "BUILD-OK"
  exit 0
fi
echo "== install"
if [ -d "${dropin%/*}" ]; then
  printf '%s\n' "# squeezefs venue kernels (scripts/kernel/build-host-kernel): the omarchy flavour boots by default, the stock one is the second entry" \
    "$order" | sudo tee "$dropin" >/dev/null
fi
sudo pacman -U --noconfirm "$image" "$headers"
if sudo test -f /boot/limine.conf; then
  echo "== Limine entries:"; sudo grep -E '^\s*//[^/]|^default_entry' /boot/limine.conf | head -8
fi
echo "== installed; REBOOT this host into $ver to run it (nothing here reboots), then check: uname -r = $ver; cat /sys/module/fuse/parameters/enable_uring; the daemon's mount lines read buffer mode mainline_pool and the FUSE_SYNCFS probe's verdict (absent before 7.4)"
echo "BUILD-AND-INSTALL-OK"
REMOTE

echo "kernel.org linux $KVER; flavours: $FLAVOURS; fragment: $(grep -c '^CONFIG_' "$REPO/scripts/kernel/config-fragment") entries; target: $WHERE"
for f in $FLAVOURS; do
  d=$(fdir "$f")
  on "sudo mkdir -p $d && sudo chown \$(id -un) $d && rm -rf $d/patches"
  rsync -a -e "${SSH[*]}" "$REPO/scripts/kernel/config-fragment" "$(at "$d/fragment")"
  [ "$f" = omarchy ] && rsync -a --delete -e "${SSH[*]}" "$SERIES/" "$(at "$d/series/")"
  on "cat > $d/build.sh && chmod +x $d/build.sh" <<< "$BUILD_SH"
done

if [ "$STAGE" = prepare ]; then
  for f in $FLAVOURS; do
    d=$(fdir "$f")
    echo "== $f: prepare in $d"
    on "set -o pipefail; cd $d && STAGE=prepare FLAVOUR=$f KVER=$KVER SQZ_BUILD_ROOT=$ROOT ./build.sh 2>&1 | tee prepare.log"
  done
  exit
fi
# One background chain builds the flavours in order and stops at the first failure; each
# waits in its log until its turn. Background the chain alone: a backgrounded and-list is a
# subshell holding ssh's streams, and ssh waited out the whole build.
chain=
for f in $FLAVOURS; do
  d=$(fdir "$f")
  on "echo '== queued $(date)' > $d/build.log"
  chain+="cd $d && INSTALL=$INSTALL FLAVOUR=$f KVER=$KVER SQZ_BUILD_ROOT=$ROOT ./build.sh > build.log 2>&1 < /dev/null || exit 1; "
done
on "{ nohup bash -c '$chain' > /dev/null 2>&1 < /dev/null & } && echo started"
echo "build started on $WHERE ($FLAVOURS) — follow with: scripts/kernel/build-host-kernel ${HOST:---local} --status (logs $(for f in $FLAVOURS; do printf '%s ' "$(fdir "$f")/build.log"; done)— the host needs a reboot after the install)"

+	 */
+	if (test_bit(FR_BG_URING, &req->flags))
+		fuse_uring_bg_finish(queue, req);
 
 	spin_unlock(&queue->lock);
 
@@ -138,8 +208,16 @@ static void fuse_uring_abort_end_queue_requests(struct fuse_ring_queue *queue)
 	LIST_HEAD(req_list);
 
 	spin_lock(&queue->lock);
-	list_for_each_entry(req, &queue->fuse_req_queue, list)
+	list_for_each_entry(req, &queue->fuse_req_queue, list) {
 		clear_bit(FR_PENDING, &req->flags);
+		/*
+		 * fuse_dev_end_requests() ends these through
+		 * fuse_request_end(), which only knows the connection's
+		 * ledger - credit the queue's here, under its lock.
+		 */
+		if (test_bit(FR_BG_URING, &req->flags))
+			fuse_uring_bg_uncharge(queue, req);
+	}
 	list_splice_init(&queue->fuse_req_queue, &req_list);
 	spin_unlock(&queue->lock);
 
@@ -158,12 +236,18 @@ void fuse_uring_abort_end_requests(struct fuse_ring *ring)
 		if (!queue)
 			continue;
 
-		WARN_ON_ONCE(fch->max_background != UINT_MAX);
+		/*
+		 * fuse_chan_abort() raised max_background to UINT_MAX, so
+		 * the flush below moves every queued background request to
+		 * fuse_req_queue for ending.  Nothing may sleep on a stopped
+		 * queue's gate: open it and release every waiter.
+		 */
+		WARN_ON_ONCE(READ_ONCE(fch->max_background) != UINT_MAX);
 		spin_lock(&queue->lock);
 		queue->stopped = true;
-		spin_lock(&fch->bg_lock);
 		fuse_uring_flush_bg(queue);
-		spin_unlock(&fch->bg_lock);
+		WRITE_ONCE(queue->bg_blocked, false);
+		wake_up_all(&queue->bg_waitq);
 		spin_unlock(&queue->lock);

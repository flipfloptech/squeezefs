# tests/fio/exa_randread_iops.job — EXAScaler client-validation random
# read IOPS shape: libaio, bs=4k (fixed — the IOPS shape), iodepth=8,
# direct=1, time_based runtime=30 ramp=10, size=1g, numjobs=nproc split
# across NUMA nodes.
#
# Fill discipline: prefill via exa_write_bw.job (or a randwrite pass)
# against the same --dir/--njobs/--size first, or label the fio layout
# phase as the fill.
#
# [global] SHAPE only — run via tests/fio/run_fio_row.sh (per-NUMA-node
# sections are emitted at runtime; single-node = one section, no numa
# lines).
[global]
group_reporting=1
ioengine=${SQZ_FIO_ENGINE}
readwrite=randread
direct=1
bs=4k
size=${SQZ_FIO_SIZE}
iodepth=${SQZ_FIO_IODEPTH}
norandommap=0
fallocate=none
time_based
runtime=${SQZ_FIO_RUNTIME}
ramp_time=${SQZ_FIO_RAMP}
filename_format=sqzfio.$jobnum.$filenum
directory=${SQZ_FIO_DIR}

[exa_randread_iops]
numjobs=32

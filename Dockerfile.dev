FROM rust:1.80-bookworm

# Install FUSE3, build-essential, clang (for bindgen), pkg-config, and basic utilities
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libfuse3-dev \
    fuse3 \
    clang \
    libclang-dev \
    iproute2 \
    curl \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /usr/src/squeezefs

# Default command is cargo test
CMD ["cargo", "test", "--all-features"]

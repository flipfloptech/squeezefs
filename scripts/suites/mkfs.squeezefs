#!/usr/bin/env bash
# mkfs(8) helper for the external suites: `mkfs.fuse.squeezefs [-f] [--]
# <device> [squeezefs format flags…]` formats a SET on the ONE device
# (`setpaths.sh`: dm-linear slices for the metadata volume and two data
# volumes, all over the device xfstests hands over — its TEST_DEV/SCRATCH_DEV
# loop, a dm target the test put over it, or a device of the test's own such
# as generic/620's 17 TB dm-hugedisk) with `squeezefs format`, in the
# class the harness chose (`SUITE_SINGLE_WRITER` off the env file: the
# shipped symmetric default — a test's second mount of one device JOINS
# the first daemon, charter §5.7 — or `--single-writer` under
# `SUITE_SINGLE_WRITER=1`); the write cache is RAM, nothing to format.
# xfstests' `_scratch_mkfs` runs `yes | mkfs -t fuse.squeezefs --
# $SCRATCH_DEV` before every scratch test. Installed as
# /sbin/mkfs.fuse.squeezefs.
set -euo pipefail
# The filesystem side is never interposed: a run under FSTESTS_PRELOAD
# preloads the tests' tools, not the helpers or the daemons they start.
unset LD_PRELOAD
ENV_FILE=${SQZ_SUITES_ENV:-/run/squeezefs-suites.env}
[ -f "$ENV_FILE" ] && source "$ENV_FILE"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/setpaths.sh"
SQZ_BIN=${SQZ_BIN:-squeezefs}
SUITE_SINGLE_WRITER=${SUITE_SINGLE_WRITER:-0}

die() { echo "mkfs.squeezefs: $*" >&2; exit 1; }

dev="" extra=()
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    -f|--force) force=1 ;;                         # mkfs(8)'s "overwrite what is there": `squeezefs format --force`
    --) ;;                                         # mkfs(8)'s separator
    -t) shift ;;                                   # `mkfs -t fuse.squeezefs` passes the type
    -*) extra+=("$1") ;;                           # squeezefs format flags (--block-size …)
    *) if [ -z "$dev" ]; then dev=$1; else extra+=("$1"); fi ;;
  esac
  shift
done
[ -n "$dev" ] || die "usage: mkfs.fuse.squeezefs [-f] [--] <device> [squeezefs format flags]"
suite_set_of "$dev"
# A set still standing from a mount the test never unmounted: down first.
suite_slices_down
suite_slices_up "$dev"
trap suite_slices_down EXIT
# Without -f the format runs as the operator would: a volume already
# formatted refuses (generic/740 asks exactly that of a foreign filesystem).
[ "$force" = 1 ] && extra+=(--force)
# mkfs(8) is quiet on success: the format's bring-up and summary lines go to
# the set's own ledger (a test that runs `_scratch_mkfs` bare captures them
# into its golden output — generic/631, 634, 732, 754, 800); a refusal is
# the diagnosis and goes to stderr with the exit code.
[ "$SUITE_SINGLE_WRITER" = 1 ] && extra+=(--single-writer)
rc=0
out=$("$SQZ_BIN" format "${extra[@]}" "sqmeta://$SLICE_META" "sqdata://$SLICE_D0,$SLICE_D1" 2>&1) || rc=$?
if [ "$rc" = 0 ]; then
  printf '%s\n' "$(date +%s) format $dev" "$out" >> "$SET_DIR/formats.log"
  exit 0
fi
printf '%s\n' "$out" >&2
exit "$rc"

From 27cadfcdc752aef9271881eebc0cd6ec72253c51 Mon Sep 17 00:00:00 2001
From: Justin Oberdorf <109311040+flipfloptech@users.noreply.github.com>
Date: Wed, 21 Oct 2026 13:05:03 -0400
Subject: [PATCH 7/7] sqz: nvme: host-scoped fabric subsystems (opt-in)

The multi-writer program's rung-6 STOP finding
(design-full-multi-writer.md s5.2 / rung 5b; design note
docs/design-mw-multipath-kernel.md): on nvme_core.multipath=Y kernels
(the upstream default) __nvme_find_get_subsystem() matches on
subsysnqn ALONE, so two co-located SqueezeFS mounts connecting to one
target subsystem under two per-mount host identities (hostnqn/hostid
pairs, each its own persistent-reservation registrant) merge into ONE
host-side subsystem: one hidden-path multipath ns_head per namespace,
one openable /dev node, and I/O round-robining across BOTH identities'
paths -- which voids per-mount device fencing (a WERO preempt of
registrant A does not stop the shared head from routing the fenced
mount's DMA down registrant B's path).

Add the opt-in module parameter
nvme_core.fabrics_host_scoped_subsystems (bool, default off, perm
0444 -- boot/modprobe-scoped on purpose: a runtime flip would make
the subsystem match asymmetric between subsystems created before and
after it). When set, fabric controllers group host-side subsystems by
the PAIR (subsysnqn, hostnqn):

 - struct nvme_subsystem gains host_scope[NVMF_NQN_SIZE], stamped
   from ctrl->opts->host->nqn for fabric controllers under the param,
   empty otherwise (PCIe always; every subsystem when the param is
   off -- the added strcmp compares two empty strings, so default
   behaviour is byte-identical);
 - __nvme_find_get_subsystem() takes the scope and requires it to
   match alongside subsysnqn. Same-identity multipath (N paths, one
   hostnqn) keeps merging exactly as before; discovery subsystems
   already never match;
 - nvme_global_check_duplicate_ids() skips host-scoped SIBLINGS of
   one subsysnqn: they present the SAME target namespaces on purpose,
   so identical nguid/uuid/eui64 across them is the expected shape,
   not a collision (without this the fabric arm of nvme_init_ns_head
   would refuse the second identity's namespace with "ignoring nsid
   ... because of duplicate IDs"). Unscoped subsystems keep the full
   upstream check; the within-subsystem check is untouched;
 - a read-only sqz_host_scope subsystem sysfs attribute (empty when
   unscoped) -- the observability handle for guest validation and
   the daemon's resolution walk.

Connect-time duplicate detection needs no change:
nvmf_ctlr_matches_baseopts() already compares the host nqn+id pair,
so distinct-identity connects already create distinct controllers --
this patch only stops those controllers from sharing a subsystem.
Reservation state is per-namespace at the TARGET keyed by registrant
hostid (drivers/nvme/target/nvmet.h struct nvmet_pr), so host-side
subsystem splitting cannot fork fencing truth -- it restores it.

Accepted consequence (recorded in the design note): scoped siblings
expose the same namespace IDs through two heads, so udev /dev/disk/
by-id links for them collide; the sqz fleet resolves devices by the
sysfs controller/subsystem walk under identity, never by-id, and the
param is opt-in for SqueezeFS fleet/guest configs.

S_IRUGO on the new attribute follows the file-local SUBSYS_ATTR_RO
convention (checkpatch prefers 0444; local consistency wins).

Compile-verified: make LLVM=1 drivers/nvme/host/ with the running
7.1.6-1-cachyos-sqz config on the fully-patched (0001-0029 + this)
pristine 7.1.6 tree, zero new warnings. NOT boot-verified -- rung 6b's
qemu guest owns boot/behaviour validation
(nvme_core.fabrics_host_scoped_subsystems=Y on the guest cmdline).

[mainline v7.3 rebase] context only (__nvme_find_get_subsystem() gained
__must_hold(&nvme_subsystems_lock) upstream).

Signed-off-by: Justin Oberdorf <109311040+flipfloptech@users.noreply.github.com>
---
 drivers/nvme/host/core.c  | 54 +++++++++++++++++++++++++++++++++++++--
 drivers/nvme/host/nvme.h  |  9 +++++++
 drivers/nvme/host/sysfs.c | 17 ++++++++++++
 3 files changed, 78 insertions(+), 2 deletions(-)

diff --git a/drivers/nvme/host/core.c b/drivers/nvme/host/core.c
index 7eb0f9fe6b18..a5a03ad4b120 100644
--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -113,6 +113,23 @@ module_param(disable_pi_offsets, bool, 0444);
 MODULE_PARM_DESC(disable_pi_offsets,
 	"disable protection information if it has an offset");
 
+/*
+ * sqz: opt-in host-scoped fabric subsystems.  When set, fabric
+ * controllers group into host-side subsystems by (subsysnqn, hostnqn)
+ * instead of subsysnqn alone, so two connects to one target subsystem
+ * under distinct host identities get separate subsystems, separate
+ * multipath ns_heads and separate /dev nodes -- per-host-identity
+ * persistent-reservation fencing stays meaningful on one machine.
+ * Same-identity multipath (N paths, one hostnqn) merges exactly as
+ * before.  Boot/modprobe-scoped on purpose (0444): a runtime flip
+ * would make the subsystem match asymmetric between subsystems
+ * created before and after it.
+ */
+static bool fabrics_host_scoped_subsystems;
+module_param(fabrics_host_scoped_subsystems, bool, 0444);
+MODULE_PARM_DESC(fabrics_host_scoped_subsystems,
+	"group fabric subsystems by (subsysnqn, hostnqn) so distinct host identities never share a multipath head (default: off)");
+
 /*
  * nvme_wq - hosts nvme related works that are not reset or delete
  * nvme_reset_wq - hosts nvme reset works
@@ -3236,7 +3253,25 @@ static void nvme_put_subsystem(struct nvme_subsystem *subsys)
 	kref_put(&subsys->ref, nvme_destroy_subsystem);
 }
 
-static struct nvme_subsystem *__nvme_find_get_subsystem(const char *subsysnqn)
+/*
+ * sqz: the host-identity scope a controller groups its subsystem under.
+ * Empty (= unscoped, the upstream behaviour) unless the opt-in module
+ * parameter is set and the controller is fabric-attached with a host
+ * NQN.  PCIe controllers always group unscoped.
+ */
+static const char *nvme_ctrl_host_scope(struct nvme_ctrl *ctrl)
+{
+	if (!fabrics_host_scoped_subsystems)
+		return "";
+	if (!(ctrl->ops->flags & NVME_F_FABRICS))
+		return "";
+	if (!ctrl->opts || !ctrl->opts->host)
+		return "";
+	return ctrl->opts->host->nqn;
+}
+
+static struct nvme_subsystem *__nvme_find_get_subsystem(const char *subsysnqn,
+		const char *host_scope)
 	__must_hold(&nvme_subsystems_lock)
 {
 	struct nvme_subsystem *subsys;
@@ -3257,6 +3292,9 @@ static struct nvme_subsystem *__nvme_find_get_subsystem(const char *subsysnqn)
 	list_for_each_entry(subsys, &nvme_subsystems, entry) {
 		if (strcmp(subsys->subnqn, subsysnqn))
 			continue;
+		/* sqz: both empty (the default) compares equal. */
+		if (strcmp(subsys->host_scope, host_scope))
+			continue;
 		if (!kref_get_unless_zero(&subsys->ref))
 			continue;
 		return subsys;
@@ -3329,6 +3367,8 @@ static int nvme_init_subsystem(struct nvme_ctrl *ctrl, struct nvme_id_ctrl *id)
 	INIT_LIST_HEAD(&subsys->nsheads);
 	xa_init(&subsys->cels);
 	nvme_init_subnqn(subsys, ctrl, id);
+	strscpy(subsys->host_scope, nvme_ctrl_host_scope(ctrl),
+		sizeof(subsys->host_scope));
 	memcpy(subsys->serial, id->sn, sizeof(subsys->serial));
 	memcpy(subsys->model, id->mn, sizeof(subsys->model));
 	subsys->vendor_id = le16_to_cpu(id->vid);
@@ -3357,7 +3397,7 @@ static int nvme_init_subsystem(struct nvme_ctrl *ctrl, struct nvme_id_ctrl *id)
 	device_initialize(&subsys->dev);
 
 	mutex_lock(&nvme_subsystems_lock);
-	found = __nvme_find_get_subsystem(subsys->subnqn);
+	found = __nvme_find_get_subsystem(subsys->subnqn, subsys->host_scope);
 	if (found) {
 		put_device(&subsys->dev);
 		subsys = found;
@@ -4103,6 +4143,16 @@ static int nvme_global_check_duplicate_ids(struct nvme_subsystem *this,
 	list_for_each_entry(s, &nvme_subsystems, entry) {
 		if (s == this)
 			continue;
+		/*
+		 * sqz: host-scoped siblings of one fabric subsystem present
+		 * the SAME target namespaces on purpose -- identical IDs
+		 * across them are the expected shape, not a collision.
+		 * Unscoped subsystems (host_scope empty on both sides, the
+		 * default) keep the full upstream check.
+		 */
+		if ((this->host_scope[0] || s->host_scope[0]) &&
+		    !strcmp(s->subnqn, this->subnqn))
+			continue;
 		mutex_lock(&s->lock);
 		ret = nvme_subsys_check_duplicate_ids(s, ids);
 		mutex_unlock(&s->lock);
diff --git a/drivers/nvme/host/nvme.h b/drivers/nvme/host/nvme.h
index a643c4723a69..ed59d0cf77d1 100644
--- a/drivers/nvme/host/nvme.h
+++ b/drivers/nvme/host/nvme.h
@@ -511,6 +511,15 @@ struct nvme_subsystem {
 	/* Command effects logs, indexed by CSI and protected by lock. */
 	struct xarray		cels;
 	char			subnqn[NVMF_NQN_SIZE];
+	/*
+	 * sqz: the fabric host-identity scope this subsystem was grouped
+	 * under -- the connecting controller's hostnqn when
+	 * nvme_core.fabrics_host_scoped_subsystems is set and the
+	 * controller is fabric-attached, empty otherwise.  Controllers
+	 * only share a subsystem (and thus multipath ns_heads) when both
+	 * their subsysnqn AND their host scope match.
+	 */
+	char			host_scope[NVMF_NQN_SIZE];
 	char			serial[20];
 	char			model[40];
 	char			firmware_rev[8];
diff --git a/drivers/nvme/host/sysfs.c b/drivers/nvme/host/sysfs.c
index e1e3dcfd084b..b62e907a521e 100644
--- a/drivers/nvme/host/sysfs.c
+++ b/drivers/nvme/host/sysfs.c
@@ -1275,6 +1275,22 @@ static ssize_t nvme_subsys_show_type(struct device *dev,
 }
 static SUBSYS_ATTR_RO(subsystype, S_IRUGO, nvme_subsys_show_type);
 
+/*
+ * sqz: the host-identity scope this subsystem was grouped under (empty
+ * when nvme_core.fabrics_host_scoped_subsystems is off or the
+ * controllers are not fabric-attached).
+ */
+static ssize_t nvme_subsys_show_sqz_host_scope(struct device *dev,
+					       struct device_attribute *attr,
+					       char *buf)
+{
+	struct nvme_subsystem *subsys =
+		container_of(dev, struct nvme_subsystem, dev);
+
+	return sysfs_emit(buf, "%s\n", subsys->host_scope);
+}
+static SUBSYS_ATTR_RO(sqz_host_scope, S_IRUGO, nvme_subsys_show_sqz_host_scope);
+
 #define nvme_subsys_show_str_function(field)				\
 static ssize_t subsys_##field##_show(struct device *dev,		\
 			    struct device_attribute *attr, char *buf)	\
@@ -1296,6 +1312,7 @@ static struct attribute *nvme_subsys_attrs[] = {
 	&subsys_attr_firmware_rev.attr,
 	&subsys_attr_subsysnqn.attr,
 	&subsys_attr_subsystype.attr,
+	&subsys_attr_sqz_host_scope.attr,
 #ifdef CONFIG_NVME_MULTIPATH
 	&subsys_attr_iopolicy.attr,
 #endif

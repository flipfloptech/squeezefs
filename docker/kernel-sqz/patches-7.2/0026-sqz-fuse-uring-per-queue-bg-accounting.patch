+ * drain-time wake_up_all() is what keeps that from stranding the waiters it
+ * left behind.
+ */
+int fuse_uring_bg_wait(struct fuse_chan *fch)
+{
+	struct fuse_ring *ring = fch->ring;
+	struct fuse_ring_queue *queue;
+
+	queue = fuse_uring_task_to_queue(ring);
+	if (!queue || !READ_ONCE(queue->bg_blocked))
+		return 0;
+
+	return wait_event_state_exclusive(queue->bg_waitq,
+					  !READ_ONCE(queue->bg_blocked) ||
+					  !READ_ONCE(fch->connected),
+					  (TASK_KILLABLE | TASK_FREEZABLE));

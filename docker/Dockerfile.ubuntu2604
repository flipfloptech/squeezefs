# Ubuntu 26.04 build image for `task build:ubuntu2604`.
# glibc ceiling: deliberately NOT hardcoded for this young release — the
# Taskfile passes GLIBC_CEILING=auto and docker/check-artifacts.sh probes
# the image's own glibc in-container.
FROM docker.io/library/ubuntu:26.04

# Distro build deps: toolchain + pkg-config + FUSE 3 + libclang (bindgen)
# + binutils (objdump for the glibc-ceiling assertion) + curl/CA for rustup.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config git curl ca-certificates binutils file \
      fuse3 libfuse3-dev clang libclang-dev \
 && rm -rf /var/lib/apt/lists/*

# rustup: rust-toolchain.toml pins the CHANNEL (stable) plus the gate
# components, so this install matches it without pulling a second
# separately-named toolchain into the image (ENG-16). The
# cargo registry (/usr/local/cargo/registry) is volume-mounted per target
# by the Taskfile for incremental rebuilds.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable

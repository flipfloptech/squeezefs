+/* FUSE_IO_URING_CMD_RELEASE_PAYLOAD handler */
+static int fuse_uring_release_payload(struct io_uring_cmd *cmd,
+				      unsigned int issue_flags,
+				      struct fuse_chan *fch)
+{
+	const struct fuse_uring_cmd_req *cmd_req =
+		io_uring_sqe128_cmd(cmd->sqe, struct fuse_uring_cmd_req);
+	uint64_t commit_id = READ_ONCE(cmd_req->commit_id);
+	unsigned int qid = READ_ONCE(cmd_req->qid);
+	struct fuse_ring *ring = fch->ring;
+	struct fuse_ring_queue *queue;
+	struct fuse_ring_ent *ent, *found = NULL;
+	struct fuse_req *req;
+	struct io_uring_cmd *parked;
+	bool send;
+
+	if (!ring)
+		return -ENOTCONN;
+	if (qid >= ring->nr_queues)
+		return -EINVAL;
+	queue = READ_ONCE(ring->queues[qid]);
+	if (!queue || !READ_ONCE(fch->connected))
+		return -ENOTCONN;
+
+	spin_lock(&queue->lock);
+	if (unlikely(queue->stopped)) {
+		spin_unlock(&queue->lock);
+		return -ENOTCONN;
+	}
+
+	req = fuse_request_find(&queue->fpq, commit_id);
+	if (req) {
+		spin_unlock(&queue->lock);
+		return -EBUSY;
+	}
+
+	list_for_each_entry(ent, &queue->ent_retained, list) {
+		if (ent->retained_commit_id == commit_id) {
+			found = ent;
+			break;
+		}
+	}
+	if (!found) {
+		spin_unlock(&queue->lock);
+		return -ENOENT;
+	}
+	if (found->state != FRRS_RETAINED) {
+		spin_unlock(&queue->lock);
+		return -EBUSY;
+	}
+	parked = found->cmd;
+	spin_unlock(&queue->lock);
+
+	if (found->zero_copied) {
+		io_buffer_unregister(parked, found->fixed_buf_id, issue_flags);
+		found->zero_copied = false;
+		found->zc_dir_source = false;
+	}
+
+	send = fuse_uring_get_next_fuse_req(found, queue, issue_flags);
+	fuse_uring_headers_cleanup(found, issue_flags);
+	if (send)
+		fuse_uring_send(found, parked, 0, issue_flags);
+	return 0;
+}
+
 static bool is_ring_ready(struct fuse_ring *ring, int current_qid)
 {
 	int qid;
@@ -1573,6 +1681,7 @@ static int fuse_uring_register(struct io_uring_cmd *cmd,
 	unsigned int init_flags = READ_ONCE(cmd_req->init.flags);
 	bool use_bufring = init_flags & FUSE_URING_BUF_RING;
 	bool zero_copy = init_flags & FUSE_URING_ZERO_COPY;
+	bool retention = init_flags & FUSE_URING_PAYLOAD_RETENTION;
 	struct fuse_ring *ring = smp_load_acquire(&fch->ring);
 	struct fuse_ring_queue *queue;
 	struct fuse_ring_ent *ent;
@@ -1594,12 +1703,14 @@ static int fuse_uring_register(struct io_uring_cmd *cmd,
 	queue = READ_ONCE(ring->queues[qid]);
 	if (!queue) {
 		queue = fuse_uring_create_queue(cmd, ring, qid, use_bufring,
-						zero_copy, issue_flags);
+						zero_copy, retention,
+						issue_flags);
 		if (IS_ERR(queue))
 			return PTR_ERR(queue);
 	} else {
 		if ((queue->use_bufring != use_bufring) ||
-		    (queue->use_zero_copy != zero_copy))
+		    (queue->use_zero_copy != zero_copy) ||
+		    (queue->use_retention != retention))
 			return -EINVAL;
 	}
 
@@ -1642,6 +1753,8 @@ int fuse_uring_cmd(struct io_uring_cmd *cmd, unsigned int issue_flags)
 	}
 	fch = fud->chan;
 
+	BUILD_BUG_ON(sizeof(struct fuse_uring_cmd_req) != 24);
+
 	/* Once a connection has io-uring enabled on it, it can't be disabled */
 	if (!enable_uring && !fch->io_uring) {
 		pr_info_ratelimited("fuse-io-uring is disabled\n");
@@ -1679,6 +1792,8 @@ int fuse_uring_cmd(struct io_uring_cmd *cmd, unsigned int issue_flags)
 			return err;
 		}
 		break;
+	case FUSE_IO_URING_CMD_RELEASE_PAYLOAD:
+		return fuse_uring_release_payload(cmd, issue_flags, fch);
 	default:
 		return -EINVAL;
 	}
@@ -1719,7 +1834,7 @@ static void fuse_uring_send_in_task(struct io_tw_req tw_req, io_tw_token_t tw)
 
 		io_uring_cmd_done(cmd, err, issue_flags);
 
-		fuse_uring_req_end(ent, ent->fuse_req, err, issue_flags);
+		fuse_uring_req_end(ent, ent->fuse_req, err, issue_flags, false);
 		kfree(ent);
 		if (atomic_dec_and_test(&queue->ring->queue_refs))
 			wake_up_all(&queue->ring->stop_waitq);

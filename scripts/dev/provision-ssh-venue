#!/usr/bin/env bash
# Provision an ssh venue (a bare Linux box, e.g. kamrui-dev) with what the
# `sqz-zig` container gets from its image and its kernel. Idempotent: every step
# checks before it acts. Run as root ON the box — `scripts/venue up` does it.
#
#   1. the kernel modules the nvmet / NVMe-oF / kTLS rows need, loaded now and
#      persisted in /etc/modules-load.d/sqz.conf (a stock distro kernel ships
#      them as modules; a kernel built with them =y modprobes as a no-op), and
#      nvme_core.multipath=N persisted on the kernel command line (GRUB drop-ins,
#      or Limine's);
#   2. IOR/mdtest at io500's pinned hash into /opt/sqz-tools, exactly as
#      scripts/dev/Containerfile builds them, and root runs allowed for OpenMPI;
#   3. the facts a gate log is read against (kernel, openssl, fusermount3).
# Packages come from apt (Debian, Ubuntu) or pacman (Arch and its derivatives such
# as Omarchy, which say ID_LIKE=arch).
set -euo pipefail

[ "$(id -u)" = 0 ] || { echo "provision: run as root" >&2; exit 1; }
. /etc/os-release
case " $ID ${ID_LIKE:-} " in *" arch "*) FAMILY=arch ;; *) FAMILY=deb ;; esac

# fuse (the fragment builds it =m: /sys/module/fuse/parameters/enable_uring exists only
# once it is loaded, and `scripts/venue status` and the provisioning check read it), nvmet +
# its loop and tcp transports (ops/nvmet rows), the initiator side nvme-tcp/nvme-fabrics,
# tls (kTLS rows). A built-in one modprobes as a no-op.
MODULES=(fuse nvmet nvmet-tcp nvme-loop nvme-tcp nvme-fabrics tls)
for m in "${MODULES[@]}"; do modprobe "$m"; done
conf=/etc/modules-load.d/sqz.conf
want=$(printf '%s\n' "# squeezefs venue (scripts/dev/provision-ssh-venue)" "${MODULES[@]}")
if [ ! -f "$conf" ] || [ "$(cat "$conf")" != "$want" ]; then printf '%s\n' "$want" >"$conf"; fi
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config

# The venue boots nvme_core.multipath=N (owner ruling 2026-11-02, decision 0003 §DE): the
# product presents ONE host identity per host, but the venue's single-host rows stand two
# hosts up on one under two identities (explicit pairs, SQUEEZEFS_TEST_PER_MOUNT_IDENTITY),
# and a stock kernel groups a host-side subsystem by its NQN alone — under native multipath
# two identities on one subsystem MERGE under one head, which the product refuses. With
# multipath=N each identity gets its own node (the multipath-tcp row skips by name).
# nvme_core loads from the initramfs, so only the command line sets it: persisted here, live
# after the next reboot — in Debian's GRUB drop-ins, or in limine-entry-tool's (Omarchy),
# where the parameter is baked into the UKI, so the boot image is rebuilt the way Omarchy's
# own migrations do it (limine-mkinitcpio). A drop-in that already carries the parameter
# (and not the retired sqz-only nvme_core.fabrics_host_scoped_subsystems) is left as it is.
mp_cmdline=nvme_core.multipath=N
stale_cmdline=nvme_core.fabrics_host_scoped_subsystems
dropin_ok() { [ -f "$1" ] && grep -qF "$mp_cmdline" "$1" && ! grep -qF "$stale_cmdline" "$1"; }
if [ -d /etc/default/grub.d ]; then
  grub_cfg=/etc/default/grub.d/sqz-venue.cfg
  if ! dropin_ok "$grub_cfg"; then
    printf '%s\n' "# squeezefs venue (scripts/dev/provision-ssh-venue)" "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT $mp_cmdline\"" >"$grub_cfg"
    update-grub >/dev/null 2>&1
  fi
elif [ -d /etc/limine-entry-tool.d ] && command -v limine-mkinitcpio >/dev/null; then
  limine_conf=/etc/limine-entry-tool.d/sqz-venue.conf
  if ! dropin_ok "$limine_conf"; then
    printf '%s\n' "# squeezefs venue (scripts/dev/provision-ssh-venue)" "KERNEL_CMDLINE[default]+=\" $mp_cmdline\"" >"$limine_conf"
    echo "provision: $limine_conf written; rebuilding the boot image (limine-mkinitcpio) …"
    limine-mkinitcpio
  fi
else
  grep -qF "$mp_cmdline" /proc/cmdline || echo "provision: no GRUB drop-in dir and no limine-entry-tool here — put $mp_cmdline on the kernel command line yourself" >&2
fi

# The hash io500 sc26 pins (docs/gates/brackets.md); the same as the image's.
# Spelled out in full: the commit is reachable today only from a pull-request
# ref, so a fresh clone lacks it and GitHub fetches an unadvertised commit only
# by its full id (a short id answers "couldn't find remote ref").
IOR_COMMIT=5528b3619236d475a864a8021ab56d6b5c1aafa2
PREFIX=/opt/sqz-tools
stamp="$PREFIX/.ior-${IOR_COMMIT:0:16}"
if [ ! -f "$stamp" ]; then
  case $FAMILY in
    deb) for p in autoconf automake libtool pkg-config git make gcc fio openmpi-bin libopenmpi-dev; do
      dpkg -s "$p" >/dev/null 2>&1 || DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$p"
    done ;;
    # (--needed: installed ones are skipped, so this is idempotent.)
    arch) pacman -S --needed --noconfirm autoconf automake libtool pkgconf git make gcc fio openmpi ;;
  esac
  src=$(mktemp -d /tmp/ior.XXXXXX)
  git clone -q https://github.com/hpc/ior.git "$src"
  (cd "$src" && git fetch -q origin "$IOR_COMMIT" && git checkout -q "$IOR_COMMIT" && ./bootstrap >/dev/null \
    && ./configure -q --prefix="$PREFIX" && make -s -j"$(nproc)" && make -s install)
  rm -rf "$src"
  touch "$stamp"
fi

# Commands run as root (`sudo bash -lc`), and OpenMPI refuses root without both.
profile=/etc/profile.d/sqz-tools.sh
want_profile=$(printf '%s\n' "# squeezefs venue (scripts/dev/provision-ssh-venue)" \
  "export PATH=$PREFIX/bin:\$PATH" "export OMPI_ALLOW_RUN_AS_ROOT=1" "export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1")
if [ ! -f "$profile" ] || [ "$(cat "$profile")" != "$want_profile" ]; then printf '%s\n' "$want_profile" >"$profile"; fi

root=${SQZ_BUILD_ROOT:-/build}
mkdir -p "$root/zig-cache-v2" "$root/zig-global-cache" "$root/tmp"
chmod 1777 "$root/tmp"

echo "kernel:   $(uname -r) ($(uname -m)), $(nproc) cpus, $(free -g | awk 'NR==2{print $2}') GiB"
echo "modules:  $(for m in "${MODULES[@]}"; do [ -d "/sys/module/${m//-/_}" ] && printf '%s ' "$m"; done)"
echo "openssl:  $(openssl version)"
echo "nvme:     multipath=$(cat /sys/module/nvme_core/parameters/multipath 2>/dev/null || echo absent) (the venue boots N: each host identity its own node)$(grep -qF "$mp_cmdline" /proc/cmdline || echo " ($mp_cmdline persisted for the next boot: REBOOT to apply)")"
echo "fuse:     $(fusermount3 --version 2>&1 | head -1); enable_uring=$(cat /sys/module/fuse/parameters/enable_uring 2>/dev/null || echo absent)"
echo "tools:    $(PATH=$PREFIX/bin:$PATH command -v ior mdtest | tr '\n' ' ')fio $(fio --version)"
